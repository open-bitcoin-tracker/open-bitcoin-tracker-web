{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src/features/supply",
    "src/scripts/supply.ts",
    "src/i18n/supply.ts",
    "tests/supply*.test.ts",
    "scripts/refresh-supply.ts"
  ]
}
