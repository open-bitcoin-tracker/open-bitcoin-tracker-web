---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLang } from '../../i18n/utils';
import { wealth as t, assetNames } from '../../i18n/wealth';
import '../../features/wealth/tiles.css';
import { formatDate, formatNumber, interpolate } from '../../features/supply/model';
import { ASSET_IDS, formatCompactUsd, formatUsd, SLIDER_STEPS, layoutAssets, type AssetId } from '../../features/wealth/model';
import { staticWealth } from '../../features/wealth/static';

const locale = 'en-US';
const date = (value: string) => formatDate(value, locale);
const { snapshot, fiat, supply, base, total } = staticWealth();
const { rects, notches } = layoutAssets(base, 160, 90);
const percent = (value: number, of: number) => `${(value / of * 100).toFixed(4)}%`;
const listed = Object.fromEntries(snapshot.assets.map((asset) => [asset.id, asset]));
const clientCopy = { ...t, assetNames };
const yearOf = (value: string) => value.slice(0, 4);
const sourceFor = (id: AssetId) => id === 'bitcoin' ? snapshot.bitcoin.source : id === 'gold' ? snapshot.gold.source : id === 'fiat' ? `${getRelativeLocaleUrl(resolveLang(Astro.currentLocale), 'bitcoin-and-the-dollar')}#sources` : listed[id].source;
---
<Layout title={`${t.title} — Open Bitcoin Tracker`} description={t.description}>
  <Nav />
  <main id="main-content" class="wealth-page wealth-tiles" lang="en" data-wealth>
    <div class="wealth-screen">
    <header class="wealth-header">
      <h1>{t.title}</h1>
      <!-- The slider sets the price per bitcoin; the market cap follows and shows on the chart. -->
      <div class="header-price">
        <div class="price-head">
          <label for="bitcoin-cap" class="section-label">{t.priceLabel}</label>
          <output class="cap-value" for="bitcoin-cap" data-price>{formatUsd(snapshot.bitcoin.fallbackPrice)}</output>
        </div>
        <div class="slider-hit" data-slider-hit>
          <input id="bitcoin-cap" class="cap-slider" type="range" min="0" max={SLIDER_STEPS} step="1" value="0" style="--fill:0%" data-slider disabled
            aria-valuetext={interpolate(t.sliderValue, { cap: formatCompactUsd(base.bitcoin, 4), price: formatUsd(snapshot.bitcoin.fallbackPrice) })} />
          <div class="slider-scale" data-scale aria-hidden="true"></div>
        </div>
      </div>
    </header>

    <div class="wealth-stage">
      <section class="treemap-area" aria-label={t.treemapLabel}>
        <p class="bitcoin-callout" data-callout data-visible aria-hidden="true" style={`left:calc(${percent(rects.bitcoin.w, 160)} + 4px)`}>{assetNames.bitcoin} <strong data-callout-value>{formatCompactUsd(base.bitcoin)}</strong></p>
        <ul class="treemap" data-treemap>
          {ASSET_IDS.map((id) => {
            const rect = rects[id];
            const cut = notches[id];
            const notch = cut ? `clip-path:polygon(${percent(cut.w, rect.w)} 0, 100% 0, 100% 100%, 0 100%, 0 ${percent(cut.h, rect.h)}, ${percent(cut.w, rect.w)} ${percent(cut.h, rect.h)})` : undefined;
            return <li class="tile" data-tile={id} style={`left:${percent(rect.x, 160)};top:${percent(rect.y, 90)};width:calc(${percent(rect.w, 160)} + ${rect.w > 0 ? 1 : 0}px);height:calc(${percent(rect.h, 90)} + ${rect.h > 0 ? 1 : 0}px)`}>
              <div class="tile-body" style={notch}>
                <div class="tile-label">
                  {id === 'bitcoin' && <span class="tile-glyph" aria-hidden="true">₿</span>}
                  <span class="tile-name">{assetNames[id]}</span>
                  <span class="tile-value" data-tile-value>{formatCompactUsd(base[id])}</span>
                  <span class="tile-change" data-tile-change></span>
                </div>
              </div>
            </li>;
          })}
        </ul>
      </section>

    </div>

    <div class="simulator-footer">
      <p class="simulator-status" data-status>{interpolate(t.priceUnavailable, { date: date(snapshot.bitcoin.fallbackPriceDate) })}</p>
      <noscript><p class="simulator-status">{interpolate(t.nojs, { date: date(snapshot.checkedAt) })}</p></noscript>
    </div>
    </div>

    <details class="method" id="sources">
      <summary><h2>{t.methodTitle}</h2><svg class="details-plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary>
      <div class="method-content">
        <p>{t.methodIntro}</p>
        <p>{t.simulationMethod}</p>
        <dl class="source-list">
          {ASSET_IDS.map((id) => {
            const asset = listed[id];
            const detail = id === 'bitcoin'
              ? interpolate(t.bitcoinMethod, { height: formatNumber(snapshot.bitcoin.referenceHeight, locale), date: date(snapshot.bitcoin.referenceTime) })
              : id === 'gold'
                ? interpolate(t.goldMethod, { tonnes: formatNumber(snapshot.gold.tonnes, locale), year: yearOf(snapshot.gold.asOf) })
                : id === 'fiat'
                  ? interpolate(t.fiatMethod, { date: date(snapshot.fiat.fxDate) })
                  : `${asset.publisher}, ${interpolate(t.asOf, { date: date(asset.asOf) })}. ${asset.note}`;
            return <div class="source-item">
              <dt><span class="source-swatch" data-swatch={id} aria-hidden="true"></span>{assetNames[id]}</dt>
              <dd>{detail} <a href={sourceFor(id)} aria-label={`${assetNames[id]} source`}>{t.sourceLink} ↗</a>{id === 'fiat' && <> <a href={snapshot.fiat.fxSource} aria-label="ECB reference rates">ECB ↗</a></>}</dd>
            </div>;
          })}
        </dl>
      </div>
    </details>
  </main>
  <script id="wealth-data" type="application/json" set:html={JSON.stringify({ snapshot, fiat, copy: clientCopy }).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/wealth';</script>
</Layout>
<style>
  .wealth-page {
    --wealth-gap: 1rem;
    width: 100%;
    max-width: 120rem;
    margin: 0 auto;
    padding: var(--menu-control-top) clamp(1rem, 3vw, 2.5rem) 2rem;
  }
  /* The title and the price slider share the menu button's row. */
  .wealth-header { position: relative; padding-bottom: .5rem; display: flex; align-items: flex-start; gap: .75rem clamp(1rem, 2.5vw, 2.5rem); min-height: var(--menu-control-size); margin-bottom: var(--wealth-gap); padding-right: calc(var(--menu-control-size) + 1rem); }
  /* The title is centred on the menu button's row at every width. */
  .wealth-header h1 { display: flex; flex: none; align-items: center; min-height: var(--menu-control-size); }
  .header-price { display: flex; flex: 1 1 22rem; align-items: center; min-height: var(--menu-control-size); gap: clamp(1rem, 2.5vw, 2.5rem); min-width: 0; padding-left: clamp(1rem, 2.5vw, 2.5rem); border-left: 1px solid var(--color-divider); }
  .header-price .price-head { display: grid; justify-items: start; gap: .05rem; flex: none; }
  /* Room for the widest price (tens of millions), so the slider never resizes while it moves. */
  .header-price .cap-value { min-width: 11ch; }
  .header-price .slider-hit { flex: 1; min-width: 8rem; margin-top: 0; }
  .wealth-header h1 { font-size: clamp(1.375rem, 2.4vw, 2rem); font-weight: 650; letter-spacing: -.03em; line-height: 1.15; }
  /* When Bitcoin's box is too small for its own label, its name and value sit beside it, over the neighbouring tile. */
  .bitcoin-callout { position: absolute; z-index: 2; top: 0; display: flex; flex-direction: column; align-items: flex-start; gap: .05em; padding: .2rem .25rem; color: var(--tile-ink); font-size: .75rem; line-height: 1.2; white-space: nowrap; pointer-events: none; visibility: hidden; }
  .bitcoin-callout strong { font-weight: 700; font-variant-numeric: tabular-nums; }
  .bitcoin-callout[data-visible] { visibility: visible; }
  .wealth-stage { display: flex; flex-direction: column; min-height: 0; }
  /* The chart sits on the page; the controls use the standard OBT card: square corners, a divider border and the surface colour. */
  .treemap-area { position: relative; display: flex; flex-direction: column; min-height: 0; }
  .treemap { position: relative; flex: 1; aspect-ratio: 16 / 9; overflow: hidden; background: var(--tile-seam); list-style: none; }
  .tile { position: absolute; }
  .tile-body { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: .25rem; overflow: hidden; background: var(--tile-color); color: var(--tile-ink); text-align: center; container-type: size; }
  .tile[data-tile='realEstate'] { --tile-color: var(--tile-realEstate); }
  .tile[data-tile='bonds'] { --tile-color: var(--tile-bonds); }
  .tile[data-tile='equities'] { --tile-color: var(--tile-equities); }
  .tile[data-tile='fiat'] { --tile-color: var(--tile-fiat); }
  .tile[data-tile='gold'] { --tile-color: var(--tile-gold); }
  .tile[data-tile='bitcoin'] { --tile-color: var(--tile-bitcoin); z-index: 1; }
  .tile[data-empty] { visibility: hidden; }
  /* The label is laid out inside the tile's container, so container queries can switch it to one line. */
  .tile-label { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15em; max-width: 100%; }
  .tile-name { font-size: clamp(.75rem, 1.2vw, 1.125rem); line-height: 1.2; }
  .tile-value { font-size: clamp(.875rem, 1.4vw, 1.375rem); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
  /* The change hangs below the value, so the name and value stay put when it appears. */
  .tile-change { position: absolute; top: calc(100% + .15em); left: 50%; transform: translateX(-50%); font-size: clamp(.6875rem, 1vw, .875rem); font-variant-numeric: tabular-nums; white-space: nowrap; opacity: .8; }
  .tile-change:empty { display: none; }
  .tile-glyph { font-size: clamp(.75rem, 1.4vw, 1.25rem); font-weight: 700; line-height: 1; }
  .tile-name, .tile-value { white-space: nowrap; }
  .tile-glyph { display: none; }
  /* Short, wide boxes put the label on one line. */
  /* Labels that do not fit stay available to screen readers. */
  @container (max-height: 5.25rem) or (max-width: 6rem) { .tile-change { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-height: 3.25rem) and (min-width: 6rem) { .tile-label { flex-direction: row; align-items: baseline; gap: .4em; } }
  /* Small tiles shrink their text before hiding it; short names (Fiat, Gold, Bonds) stay on narrower tiles than long ones. */
  @container (max-width: 5rem) or (max-height: 2rem) { .tile-name { font-size: .6875rem; } .tile-value { font-size: .75rem; } .tile-change { font-size: .625rem; } }
  @container (max-height: 1.25rem) { .tile-name, .tile-value { line-height: 1; } }
  @container (max-width: 4rem) { .tile-change, .tile:is([data-tile='realEstate'], [data-tile='equities'], [data-tile='bitcoin']) .tile-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-width: 2rem) or (max-height: .7rem) { .tile-name, .tile-change { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-width: 2.9rem) or (max-height: .7rem) or ((max-width: 6rem) and (max-height: 1.9rem)) { .tile-value { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } .tile-glyph { display: block; } }
  .tile[data-label-outside] :is(.tile-name, .tile-value, .tile-change) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .tile[data-label-outside] .tile-glyph { display: block; }
  @container (max-width: .9rem) or (max-height: .9rem) { .tile-glyph, .tile[data-label-outside] .tile-glyph { display: none; } }
  /* Tall, narrow strips turn the name and value sideways, reading bottom to top. */
  @container (max-width: 2.9rem) and (min-width: 1rem) and (min-height: 4.5rem) {
    .tile-label { flex-direction: row; gap: .35em; writing-mode: vertical-rl; transform: rotate(180deg); }
    .tile[data-tile] .tile-label :is(.tile-name, .tile-value) { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
    .tile-name { font-size: .75rem; }
    .tile-value { font-size: .8125rem; }
    .tile-glyph { display: none; }
  }
  .section-label { color: var(--color-ink-muted); font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .price-head { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .cap-value { font-size: clamp(1.25rem, 1.9vw, 1.75rem); font-weight: 650; line-height: 1.15; font-variant-numeric: tabular-nums; letter-spacing: -.03em; white-space: nowrap; }
  /* A custom slider: a thicker track filled up to the thumb (--fill, set by the script). */
  .cap-slider { --track: color-mix(in srgb, var(--color-ink) 16%, transparent); width: 100%; pointer-events: none; height: var(--slider-h); margin: .25rem 0 0; background: transparent; appearance: none; -webkit-appearance: none; cursor: default; }
  /* The wrapper takes the pointer so vertical swipes still scroll the page; the script drags the thumb. */
  .slider-hit { --thumb: 22px; --slider-h: 2.75rem; position: relative; margin-top: .25rem; padding-bottom: 1rem; margin-bottom: -1rem; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
  /* A log ruler under the track: a tick for every round price the drag snaps to, a label on powers of ten. */
  .slider-scale { position: absolute; top: calc(var(--slider-h) / 2 + .5rem); right: calc(var(--thumb) / 2); left: calc(var(--thumb) / 2); height: 1.25rem; pointer-events: none; }
  /* The marks are created by the script, outside Astro's scoped styles. */
  .slider-scale :global(.scale-mark) { position: absolute; top: 0; left: calc(var(--at) * 100%); width: 1px; height: 4px; background: color-mix(in srgb, var(--color-ink) 28%, transparent); }
  .slider-scale :global(.scale-mark--major) { height: 7px; background: color-mix(in srgb, var(--color-ink) 50%, transparent); }
  .slider-scale :global(.scale-mark--major::after) { content: attr(data-label); position: absolute; top: 9px; left: 50%; transform: translateX(-50%); color: var(--color-ink-muted); font-size: .6875rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
  .slider-hit .cap-slider { display: block; margin: 0; }
  .slider-hit[data-over-thumb] { cursor: grab; }
  .slider-hit[data-dragging] { cursor: grabbing; }
  .cap-slider:focus { outline: none; }
  .cap-slider::-webkit-slider-runnable-track { height: .5rem; border-radius: 999px; background: linear-gradient(to right, var(--color-accent) var(--fill), var(--track) var(--fill)); }
  .cap-slider::-moz-range-track { height: .5rem; border-radius: 999px; background: var(--track); }
  .cap-slider::-moz-range-progress { height: .5rem; border-radius: 999px; background: var(--color-accent); }
  .cap-slider::-webkit-slider-thumb { width: var(--thumb); height: var(--thumb); margin-top: calc((.5rem - var(--thumb)) / 2); border: 3px solid var(--color-accent); border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgb(0 0 0 / .3); -webkit-appearance: none; appearance: none; transition: transform .15s ease, box-shadow .15s ease; }
  .cap-slider::-moz-range-thumb { width: 1rem; height: 1rem; border: 3px solid var(--color-accent); border-radius: 50%; background: #fff; box-shadow: 0 2px 6px rgb(0 0 0 / .3); transition: transform .15s ease, box-shadow .15s ease; }
  .slider-hit:is([data-over-thumb], [data-dragging]) .cap-slider::-webkit-slider-thumb { transform: scale(1.1); }
  .slider-hit:is([data-over-thumb], [data-dragging]) .cap-slider::-moz-range-thumb { transform: scale(1.1); }
  .cap-slider:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 30%, transparent); }
  .cap-slider:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 30%, transparent); }
  .simulator-footer { display: grid; gap: .35rem; margin-top: .5rem; }
  .simulator-status { color: var(--color-ink-muted); font-size: .8125rem; line-height: 1.45; }
  .simulator-status:empty { display: none; }
  .method { margin-top: var(--wealth-gap); scroll-margin-top: calc(var(--menu-control-top) + var(--menu-control-size) + .5rem); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 56px; padding: 1rem .125rem; border-top: 1px solid var(--color-divider); cursor: pointer; list-style: none; color: var(--color-ink); }
  summary h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  .details-plus { flex: none; width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; transition: transform .2s ease; }
  summary:hover .details-plus { color: var(--color-accent); }
  details[open]:not([data-closing]) .details-plus { transform: rotate(45deg); }
  .method-content { max-width: 76ch; padding-bottom: 1.5rem; color: var(--color-ink-muted); font-size: .9375rem; line-height: 1.75; }
  .method-content > p + p { margin-top: .75rem; }
  .source-list { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .source-item dt { display: flex; align-items: center; gap: .5rem; color: var(--color-ink); font-weight: 600; }
  .source-swatch { width: .75rem; height: .75rem; border-radius: .2rem; background: var(--swatch); }
  .source-swatch[data-swatch='realEstate'] { --swatch: var(--tile-realEstate); }
  .source-swatch[data-swatch='bonds'] { --swatch: var(--tile-bonds); }
  .source-swatch[data-swatch='equities'] { --swatch: var(--tile-equities); }
  .source-swatch[data-swatch='fiat'] { --swatch: var(--tile-fiat); }
  .source-swatch[data-swatch='gold'] { --swatch: var(--tile-gold); }
  .source-swatch[data-swatch='bitcoin'] { --swatch: var(--tile-bitcoin); }
  .source-item a { color: var(--color-emphasis-ink); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: .25rem; white-space: nowrap; }
  a:focus-visible, summary:focus-visible, button:focus-visible, input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  /* Desktop: the chart and controls fill one screen, so the slider and the boxes are visible together. */
  @media (min-width: 900px) and (min-height: 520px) {
    .wealth-screen { display: flex; flex-direction: column; height: calc(100dvh - var(--menu-control-top) - var(--wealth-gap)); }
    .wealth-stage, .treemap-area { flex: 1; }
    .treemap { aspect-ratio: auto; }
  }
  @media (min-width: 900px) and (max-height: 780px) {
    .wealth-page { --wealth-gap: .625rem; }
      .slider-hit { --slider-h: 2.25rem; }
            }
  @media (max-width: 899px) {
    .wealth-page { padding-bottom: 1.5rem; }
    .treemap { aspect-ratio: 4 / 3; }
  }
  /* Phones: the title on the first row, the price slider across the next, kept clear of the menu button. */
  @media (max-width: 700px) {
    .wealth-header { flex-wrap: wrap; }
    .wealth-header h1 { flex: 1; }
    .header-price { order: 3; flex-basis: 100%; max-width: none; padding-left: 0; border-left: 0; margin: 1.25rem calc((var(--menu-control-size) + 1rem) * -1) 0 0; }
    }
  @media (max-width: 600px) {
    .treemap { aspect-ratio: 4 / 5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .details-plus { transition: none; }
      .cap-slider::-webkit-slider-thumb, .cap-slider::-moz-range-thumb { transition: none; }
        }
</style>
