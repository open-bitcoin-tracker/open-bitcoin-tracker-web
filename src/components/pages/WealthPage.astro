---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLang } from '../../i18n/utils';
import { wealth, type ReportedAsset } from '../../i18n/wealth';
import '../../features/wealth/tiles.css';
import '../../styles/guide-drawer.css';
import { formatDate, formatNumber, interpolate } from '../../features/supply/model';
import { chartSettings } from '../../i18n/chart-settings';
import { currencies } from '../../lib/bitcoin-currency';
import CurrencyOptions from '../ui/CurrencyOptions.astro';
import { ASSET_IDS, formatCompactMoney, formatMoney, SLIDER_STEPS, layoutAssets, tileClipPath, type AssetId } from '../../features/wealth/model';
import { staticWealth } from '../../features/wealth/static';

const lang = resolveLang(Astro.currentLocale);
const t = wealth[lang];
const { assetNames } = t;
const locale = lang;
const date = (value: string) => formatDate(value, locale);
const { snapshot, fiat, supply, base, total } = staticWealth();
const { rects, notches, corners } = layoutAssets(base, 160, 90);
const percent = (value: number, of: number) => `${(value / of * 100).toFixed(4)}%`;
const listed = Object.fromEntries(snapshot.assets.map((asset) => [asset.id, asset]));
const currencyLabel = chartSettings[lang].currency;
const clientCopy = { ...t, locale };
// Without JavaScript, or until a saved currency loads, amounts show in US dollars.
const usd = (value: number, digits = 0) => formatMoney(value, locale, 'USD', digits);
const compactUsd = (value: number, digits?: number) => formatCompactMoney(value, locale, 'USD', digits);
// Currencies the ECB does not quote, converted at their own central bank's rate.
const ownRated = snapshot.fiat.more.filter((money) => money.rate);
const yearOf = (value: string) => value.slice(0, 4);
const sourceFor = (id: AssetId) => id === 'bitcoin' ? snapshot.bitcoin.source : id === 'gold' ? snapshot.gold.source : id === 'silver' ? snapshot.silver.source : id === 'fiat' ? `${getRelativeLocaleUrl(lang, 'bitcoin-and-the-dollar')}#sources` : listed[id].source;
---
<Layout title={`${t.title} — Open Bitcoin Tracker`} description={t.description}>
  <Nav />
  <main id="main-content" class="wealth-page wealth-tiles" data-wealth>
    <!-- Sits beside the menu button, after it in tab order. -->
    <button type="button" class="wealth-help" data-method-trigger aria-haspopup="dialog" aria-controls="wealth-method-dialog" aria-label={t.methodTitle} hidden><span aria-hidden="true">?</span><span class="wealth-help-tooltip" aria-hidden="true">{t.methodTitle}</span></button>
    <div class="wealth-screen">
    <header class="wealth-header">
      <h1>{t.title}</h1>
      <!-- The slider sets the price per bitcoin; the market cap follows and shows on the chart. -->
      <div class="header-price">
        <div class="price-stat">
          <!-- Like the price page, the price opens the currency menu; a chevron beside it shows that it does, and the code is read to screen readers. -->
          <div class="wealth-currency" data-currency-picker>
            <button type="button" class="wealth-currency-trigger" data-currency-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="wealth-currency-options" disabled>
              <span class="wealth-sr-only">{currencyLabel}: </span>
              <output class="cap-value" for="bitcoin-cap" data-price>{usd(snapshot.bitcoin.fallbackPrice)}</output>
              <span class="wealth-sr-only" data-currency-value>USD</span>
              <svg class="wealth-currency-chevron" width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </button>
            <CurrencyOptions id="wealth-currency-options" locale={lang} class="wealth-currency-menu" label={currencyLabel} />
            <select data-currency hidden disabled aria-label={currencyLabel}>{currencies.map((code) => <option value={code}>{code}</option>)}</select>
          </div>
          <label for="bitcoin-cap" class="section-label">{t.priceLabel}</label>
        </div>
        <div class="slider-hit" data-slider-hit>
          <input id="bitcoin-cap" class="cap-slider" type="range" min="0" max={SLIDER_STEPS} step="1" value="0" style="--fill:0%" data-slider disabled
            aria-valuetext={interpolate(t.sliderValue, { cap: compactUsd(base.bitcoin, 4), price: usd(snapshot.bitcoin.fallbackPrice) })} />
          <div class="slider-scale" data-scale aria-hidden="true"></div>
        </div>
      </div>
    </header>

    <div class="wealth-stage">
      <section class="treemap-area" aria-label={t.treemapLabel}>
        {(['bitcoin', 'silver'] as const).map((id) => (
          <p class="tile-callout" data-callout={id} data-visible aria-hidden="true" style={`left:calc(${percent(rects[id].x + rects[id].w, 160)} + 4px);top:${percent(rects[id].y, 90)}`}>{assetNames[id]} <strong data-callout-value>{compactUsd(base[id])}</strong></p>
        ))}
        <ul class="treemap" data-treemap>
          {ASSET_IDS.map((id) => {
            const rect = rects[id];
            const clip = tileClipPath(rect, notches[id], corners[id], percent);
            const notch = clip ? `clip-path:${clip}` : undefined;
            return <li class="tile" data-tile={id} style={`left:${percent(rect.x, 160)};top:${percent(rect.y, 90)};width:calc(${percent(rect.w, 160)} + ${rect.w > 0 ? 1 : 0}px);height:calc(${percent(rect.h, 90)} + ${rect.h > 0 ? 1 : 0}px)`}>
              <div class="tile-body" style={notch}>
                <div class="tile-label">
                  {id === 'bitcoin' && <span class="tile-glyph" aria-hidden="true">₿</span>}
                  <span class="tile-name">{assetNames[id]}</span>
                  <span class="tile-value" data-tile-value>{compactUsd(base[id])}</span>
                  <span class="tile-change" data-tile-change></span>
                </div>
              </div>
            </li>;
          })}
        </ul>
      </section>

    </div>

    <div class="simulator-footer">
      <p class="simulator-status" data-status>{interpolate(t.priceUnavailable, { date: date(snapshot.bitcoin.fallbackPriceDate) })}</p>
      <noscript><p class="simulator-status">{interpolate(t.nojs, { date: date(snapshot.checkedAt) })}</p></noscript>
    </div>
    </div>

    <!-- With JavaScript, the help button beside the title opens the sources in this drawer; without it, the same content stays a disclosure at the bottom. -->
    <section class="method" id="sources">
      <dialog id="wealth-method-dialog" class="method-dialog guide-drawer guide-drawer--right" data-method-dialog aria-labelledby="wealth-method-title">
        <div class="guide-drawer-panels">
          <section class="guide-drawer-overview" data-method-overview>
            <header class="method-header guide-drawer-header">
              <h2 id="wealth-method-title" data-method-title tabindex="-1">{t.methodTitle}</h2>
              <button type="button" class="guide-drawer-close" data-method-close aria-label={t.closeMethod}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
            </header>
            <div class="method-body guide-drawer-scroll" data-method-body></div>
          </section>
        </div>
      </dialog>
      <details data-method-fallback>
        <summary><h2>{t.methodTitle}</h2><svg class="details-plus" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></summary>
        <div class="method-content" data-method-content>
          <p class="method-note">{t.methodNote} {t.currencyMethod}</p>
          <dl class="source-list">
            {ASSET_IDS.map((id) => {
              const asset = listed[id];
              const detail = id === 'bitcoin'
                ? interpolate(t.bitcoinMethod, { height: formatNumber(snapshot.bitcoin.referenceHeight, locale), date: date(snapshot.bitcoin.referenceTime) })
                : id === 'gold'
                  ? interpolate(t.goldMethod, { tonnes: formatNumber(snapshot.gold.tonnes, locale), year: yearOf(snapshot.gold.asOf) })
                  : id === 'silver'
                    ? interpolate(t.silverMethod, { ounces: (snapshot.silver.ounces / t.ouncesUnit).toLocaleString(locale, { maximumFractionDigits: 1 }), year: yearOf(snapshot.silver.asOf), date: date(snapshot.silver.fallbackPriceDate), price: usd(snapshot.silver.fallbackPrice, 2) })
                  : id === 'fiat'
                    ? [interpolate(t.fiatMethod, { count: String(5 + snapshot.fiat.more.length), date: date(snapshot.fiat.fxDate) }), ownRated.length > 0 && interpolate(t.ownRateMethod, { currencies: new Intl.ListFormat(locale).format(ownRated.map(({ currency }) => currency)) })].filter(Boolean).join(' ')
                    : interpolate(t.reportMethod, { publisher: asset.publisher, date: date(asset.asOf), note: t.assetNotes[id as ReportedAsset] });
              return <div class="source-item">
                <dt><span class="source-swatch" data-swatch={id} aria-hidden="true"></span>{assetNames[id]}</dt>
                <dd>{detail} <a href={sourceFor(id)} aria-label={interpolate(t.sourceLabel, { asset: assetNames[id] })}>{t.sourceLink} ↗</a>{id === 'fiat' && <> <a href={snapshot.fiat.fxSource} aria-label={t.ecbLabel}>{t.ecbLink} ↗</a>{snapshot.fiat.more.length > 0 && <span class="other-money">{t.otherMoneyLabel}{' '}{snapshot.fiat.more.map((money, index) => <>{index > 0 && ' · '}<a href={money.source} aria-label={`${money.currency} ${money.aggregate}, ${money.publisher}, ${money.month}`}>{money.currency} ↗</a></>)}</span>}{ownRated.length > 0 && <span class="other-money">{t.ownRateLabel}{' '}{ownRated.map((money, index) => <>{index > 0 && ' · '}<a href={money.rate!.source} aria-label={interpolate(t.perUsdLabel, { currency: money.currency, publisher: money.rate!.publisher, date: date(snapshot.fiat.fxDate) })}>{money.currency} ↗</a></>)}</span>}</>}</dd>
              </div>;
            })}
          </dl>
        </div>
      </details>
    </section>
  </main>
  <script id="wealth-data" type="application/json" set:html={JSON.stringify({ snapshot, fiat, copy: clientCopy }).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/wealth';</script>
</Layout>
<style>
  .wealth-page {
    --wealth-gap: 1rem;
    /* The menu button and the help button beside it. */
    --header-controls-room: calc(var(--menu-control-size) * 2 + .75rem + clamp(1.5rem, 4vw, 4rem));
    width: 100%;
    max-width: 120rem;
    margin: 0 auto;
    padding: var(--menu-control-top) clamp(1rem, 3vw, 2.5rem) var(--wealth-gap);
  }
  /* The title and the price slider share the menu button's row. */
  .wealth-header { position: relative; padding-bottom: .5rem; display: flex; align-items: flex-start; gap: .75rem clamp(1rem, 2.5vw, 2.5rem); min-height: var(--menu-control-size); margin-bottom: var(--wealth-gap); padding-right: var(--header-controls-room); }
  /* The title is centred on the menu button's row at every width. */
  .wealth-header h1 { display: flex; flex: none; align-items: center; min-height: var(--menu-control-size); }
  /* The sources open from a help button that matches the menu button and sits just left of it, so the chart keeps the page's height. */
  .wealth-help { position: fixed; top: var(--menu-control-top); left: calc(var(--menu-viewport-width) - var(--menu-control-right) - var(--menu-control-size) * 2 - .75rem); z-index: 49; display: grid; place-items: center; width: var(--menu-control-size); height: var(--menu-control-size); padding: 0; border: 0; border-radius: 50%; background: var(--menu-control-bg); color: var(--menu-control-ink); font-size: 1.5rem; font-weight: 650; line-height: 1; }
  .wealth-help[hidden] { display: none; }
  .wealth-help-tooltip { position: absolute; top: calc(100% + 8px); left: 50%; z-index: 3; width: max-content; padding: 8px 12px; border: 1px solid var(--color-divider); border-radius: 12px; background: var(--color-surface); color: var(--color-ink); font-size: .875rem; font-weight: 400; line-height: 1.5; opacity: 0; visibility: hidden; transform: translateX(-50%); pointer-events: none; transition: opacity 120ms ease, visibility 0s 120ms; }
  .wealth-help:is(:hover, :focus-visible):not([data-tooltip-dismissed]) .wealth-help-tooltip { opacity: 1; visibility: visible; transition-delay: 150ms; }
  @media (hover: none) { .wealth-help-tooltip { display: none; } }
  /* The price and its label form one block against the slider: the price is as tall as the slider, so it
     centres on the track, and the label below it lines up with the scale's $100K / $1M / $10M labels.
     The slider's track sits on the title's centre line. */
  .header-price { --slider-h: 2.75rem; display: flex; flex: 1 1 22rem; align-items: flex-start; min-height: var(--menu-control-size); gap: 1rem; min-width: 0; padding-top: calc((var(--menu-control-size) - var(--slider-h)) / 2); padding-left: clamp(1rem, 2.5vw, 2.5rem); border-left: 1px solid var(--color-divider); }
  .price-stat { display: grid; flex: none; justify-items: end; }
  .price-stat .cap-value { line-height: var(--slider-h); }
  /* Matches the scale labels: their offset below the track (.5rem + 9px), size and line height. */
  .price-stat .section-label { margin-top: calc(.5rem + 9px - var(--slider-h) / 2); font-size: .6875rem; line-height: 1; }
  /* Room for the widest price (tens of millions, with a spaced symbol in some languages), so the slider never resizes while it moves.
     The block is right-aligned, so the spare room falls on its left rather than before the slider. */
  .header-price .cap-value { min-width: var(--price-room, 12ch); text-align: right; }
  /* The price opens the currency menu, like the price page: a quiet chevron follows it. */
  .wealth-currency { position: relative; }
  .wealth-currency-trigger { display: inline-flex; align-items: center; gap: .25rem; padding: 0; border: 0; border-radius: .25rem; background: none; color: inherit; font: inherit; text-align: inherit; cursor: pointer; }
  .wealth-currency-trigger:disabled { cursor: default; }
  .wealth-currency-chevron { flex: none; color: var(--color-ink-muted); transition: color 150ms ease-out, transform 150ms ease-out; }
  .wealth-currency-trigger:not(:disabled):hover .wealth-currency-chevron, .wealth-currency-trigger:focus-visible .wealth-currency-chevron, .wealth-currency-trigger[aria-expanded='true'] .wealth-currency-chevron { color: var(--color-ink); }
  .wealth-currency-trigger:not(:disabled):hover .wealth-currency-chevron { transform: translateY(2px); }
  .wealth-currency-trigger[aria-expanded='true'] .wealth-currency-chevron { transform: rotate(180deg); }
  /* The menu drops over the chart from the price; on phones, where the price sits below the chart, it opens upward. */
  .wealth-currency :global(.wealth-currency-menu) { position: absolute; top: calc(100% + .5rem); left: 0; z-index: 20; width: min(21rem, calc(100vw - 2rem)); max-height: min(30rem, calc(100dvh - 9rem)); padding: .5rem; overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--menu-dropdown-border); border-radius: var(--radius-lg); color: var(--menu-ink); background: var(--menu-dropdown-bg); box-shadow: var(--menu-dropdown-shadow); animation: wealth-menu-enter 160ms var(--ease-out); }
  .wealth-currency :global(.wealth-currency-menu[hidden]) { display: none; }
  /* Wide screens: the menu lines up with the price's right edge, by the chevron that opened it. */
  @media (min-width: 701px) { .wealth-currency :global(.wealth-currency-menu) { left: auto; right: 0; } }
  @keyframes wealth-menu-enter { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .wealth-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .header-price .slider-hit { flex: 1; min-width: 8rem; margin-top: 0; }
  .wealth-header h1 { font-size: clamp(1.375rem, 2.4vw, 2rem); font-weight: 650; letter-spacing: -.03em; line-height: 1.15; }
  /* When Bitcoin's or silver's box is too small for its own label, its name and value sit beside it, over the neighbouring tile. */
  .tile-callout { position: absolute; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: .05em; padding: .2rem .25rem; color: var(--tile-ink); font-size: .75rem; line-height: 1.2; white-space: nowrap; pointer-events: none; visibility: hidden; }
  .tile-callout strong { font-weight: 700; font-variant-numeric: tabular-nums; }
  .tile-callout[data-visible] { visibility: visible; }
  .wealth-stage { display: flex; flex-direction: column; min-height: 0; }
  /* The chart sits on the page; the controls use the standard OBT card: square corners, a divider border and the surface colour. */
  .treemap-area { position: relative; display: flex; flex-direction: column; min-height: 0; }
  .treemap { position: relative; flex: 1; min-height: 10rem; overflow: hidden; background: var(--tile-seam); list-style: none; }
  .tile { position: absolute; }
  .tile-body { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; padding: .25rem; overflow: hidden; background: var(--tile-color); color: var(--tile-ink); text-align: center; container-type: size; }
  .tile[data-tile='realEstate'] { --tile-color: var(--tile-realEstate); }
  .tile[data-tile='bonds'] { --tile-color: var(--tile-bonds); }
  .tile[data-tile='equities'] { --tile-color: var(--tile-equities); }
  .tile[data-tile='fiat'] { --tile-color: var(--tile-fiat); }
  .tile[data-tile='gold'] { --tile-color: var(--tile-gold); }
  .tile[data-tile='silver'] { --tile-color: var(--tile-silver); z-index: 1; }
  .tile[data-tile='bitcoin'] { --tile-color: var(--tile-bitcoin); z-index: 1; }
  .tile[data-empty] { visibility: hidden; }
  /* The label is laid out inside the tile's container, so container queries can switch it to one line. */
  .tile-label { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .15em; max-width: 100%; }
  .tile-name { font-size: clamp(.75rem, 1.2vw, 1.125rem); line-height: 1.2; }
  .tile-value { font-size: clamp(.875rem, 1.4vw, 1.375rem); font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
  /* The change hangs below the value, so the name and value stay put when it appears. */
  .tile-change { position: absolute; top: calc(100% + .15em); left: 50%; transform: translateX(-50%); font-size: clamp(.6875rem, 1vw, .875rem); font-variant-numeric: tabular-nums; white-space: nowrap; opacity: .8; }
  .tile-change:empty { display: none; }
  .tile-glyph { font-size: clamp(.75rem, 1.4vw, 1.25rem); font-weight: 700; line-height: 1; }
  .tile-name, .tile-value { white-space: nowrap; }
  .tile-glyph { display: none; }
  /* Short, wide boxes put the label on one line. */
  /* Labels that do not fit stay available to screen readers. */
  @container (max-height: 5.25rem) or (max-width: 6rem) { .tile-change { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-height: 3.25rem) and (min-width: 6rem) { .tile-label { flex-direction: row; align-items: baseline; gap: .4em; } }
  /* Small tiles shrink their text before hiding it; short names (Fiat, Gold, Bonds) stay on narrower tiles than long ones. */
  @container (max-width: 5rem) or (max-height: 2rem) { .tile-name { font-size: .6875rem; } .tile-value { font-size: .75rem; } .tile-change { font-size: .625rem; } }
  @container (max-height: 1.25rem) { .tile-name, .tile-value { line-height: 1; } }
  @container (max-width: 4rem) { .tile-change, .tile:is([data-tile='realEstate'], [data-tile='equities'], [data-tile='bitcoin']) .tile-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-width: 2rem) or (max-height: .7rem) { .tile-name, .tile-change { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } }
  @container (max-width: 2.9rem) or (max-height: .7rem) or ((max-width: 6rem) and (max-height: 1.9rem)) { .tile-value { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); } .tile-glyph { display: block; } }
  .tile[data-label-outside] :is(.tile-name, .tile-value, .tile-change) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .tile[data-label-outside] .tile-glyph { display: block; }
  /* Set by the script when a localized name or value is wider than its tile: first a smaller size, then the amount on two lines, then hidden from view only. */
  .tile[data-label-tight] :is(.tile-name, .tile-value) { font-size: .625rem; }
  .tile[data-label-wrap] .tile-value { max-width: 100%; white-space: normal; line-height: 1.1; }
  .tile[data-label-overflow] :is(.tile-name, .tile-value, .tile-change) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .tile[data-label-overflow] .tile-glyph { display: block; }
  @container (max-width: .9rem) or (max-height: .9rem) { .tile-glyph, .tile[data-label-outside] .tile-glyph { display: none; } }
  /* Tall, narrow strips turn the name and value sideways, reading bottom to top. */
  @container (max-width: 2.9rem) and (min-width: 1rem) and (min-height: 4.5rem) {
    .tile-label { flex-direction: row; gap: .35em; writing-mode: vertical-rl; transform: rotate(180deg); }
    .tile[data-tile] .tile-label :is(.tile-name, .tile-value) { position: static; width: auto; height: auto; overflow: visible; clip-path: none; }
    .tile-name { font-size: .75rem; }
    .tile-value { font-size: .8125rem; }
    .tile-glyph { display: none; }
  }
  .section-label { color: var(--color-ink-muted); font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .cap-value { font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 650; line-height: 1.1; font-variant-numeric: tabular-nums; letter-spacing: -.03em; white-space: nowrap; }
  /* A custom slider: a thicker track filled up to the thumb (--fill, set by the script). */
  .cap-slider { --track: color-mix(in srgb, var(--color-ink) 16%, transparent); width: 100%; pointer-events: none; height: var(--slider-h); margin: .25rem 0 0; background: transparent; appearance: none; -webkit-appearance: none; cursor: default; }
  /* The wrapper takes the pointer so vertical swipes still scroll the page; the script drags the thumb. */
  .slider-hit { --thumb: 22px; position: relative; margin-top: .25rem; padding-bottom: 1rem; margin-bottom: -1rem; touch-action: pan-y; -webkit-user-select: none; user-select: none; }
  /* A log ruler under the track: a tick for every round price the drag snaps to, a label on powers of ten. */
  .slider-scale { position: absolute; top: calc(var(--slider-h) / 2 + .5rem); right: calc(var(--thumb) / 2); left: calc(var(--thumb) / 2); height: 1.25rem; pointer-events: none; }
  /* The marks are created by the script, outside Astro's scoped styles. */
  .slider-scale :global(.scale-mark) { position: absolute; top: 0; left: calc(var(--at) * 100%); width: 1px; height: 4px; background: color-mix(in srgb, var(--color-ink) 28%, transparent); }
  .slider-scale :global(.scale-mark--major) { height: 7px; background: color-mix(in srgb, var(--color-ink) 50%, transparent); }
  .slider-scale :global(.scale-mark--major::after) { content: attr(data-label); position: absolute; top: 9px; left: 50%; transform: translateX(-50%); color: var(--color-ink-muted); font-size: .6875rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1; white-space: nowrap; }
  .slider-hit .cap-slider { display: block; margin: 0; }
  .slider-hit[data-over-thumb] { cursor: grab; }
  .slider-hit[data-dragging] { cursor: grabbing; }
  .cap-slider:focus { outline: none; }
  .cap-slider::-webkit-slider-runnable-track { height: .5rem; border-radius: 999px; background: linear-gradient(to right, var(--color-accent) var(--fill), var(--track) var(--fill)); }
  .cap-slider::-moz-range-track { height: .5rem; border-radius: 999px; background: var(--track); }
  .cap-slider::-moz-range-progress { height: .5rem; border-radius: 999px; background: var(--color-accent); }
