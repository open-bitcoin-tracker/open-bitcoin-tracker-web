---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import { resolveLang, htmlLang } from '../../i18n/utils';
import { party } from '../../i18n/party';
import { video } from '../../i18n/video';
import { currencies } from '../../lib/bitcoin-currency';

const lang = resolveLang(Astro.currentLocale);
const t = { ...party[lang], ...video[lang] };
const locale = htmlLang(Astro.currentLocale);
---

<Layout title={`${t.title} — Open Bitcoin Tracker`} description={t.description}>
  <div class="video-page" data-video-mode data-copy={JSON.stringify(t)} data-locale={locale}>
    <div class="video-background" aria-hidden="true"><div data-video-player></div></div>
    <div class="video-shade" aria-hidden="true"></div>
    <Nav />
    <header>
      <h1 class="video-sr-only">{t.title}</h1>
      <div class="video-appearance" role="group" aria-label={t.controlsLabel}>
        <label class="video-sr-only" for="video-currency">{t.currency}</label>
        <div class="video-currency" data-currency-picker>
          <select id="video-currency" data-currency hidden disabled>{currencies.map(code => <option value={code}>{code}</option>)}</select>
          <button type="button" class="video-currency-trigger" data-currency-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="video-currency-options" disabled>
            <span class="video-sr-only">{t.currency}</span>
            <span data-currency-value>USD</span>
            <svg class="video-currency-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div id="video-currency-options" class="video-currency-menu" data-currency-list role="listbox" aria-label={t.currency} hidden>
            {currencies.map(code => (
              <button type="button" class="video-currency-option" data-currency-option={code} role="option" aria-selected={code === 'USD' ? 'true' : 'false'} tabindex="-1">
                <span>{code}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
              </button>
            ))}
          </div>
        </div>
        <button type="button" class="video-icon-button" data-fullscreen aria-label={t.fullscreen} title={t.fullscreen} disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
        </button>
      </div>
    </header>
    <main id="main-content" class="video-main">
      <section class="video-price-stage" data-price-stage aria-label={t.priceLabel}>
        <div class="video-alignment-grid" aria-hidden="true"></div>
        <div class="video-price-position" data-price-position role="group" aria-label={t.movePrice} aria-describedby="video-price-keyboard-hint" tabindex="0">
          <p class="video-price" data-price aria-label={t.unavailable}>—</p>
          <span class="video-sr-only" data-price-status role="status">{t.loadingPrice}</span>
          <div class="video-price-editing">
            {['nw', 'ne', 'sw', 'se'].map(corner => (
              <button type="button" class:list={['video-price-resize', `video-price-resize-${corner}`]} data-price-resize={corner} aria-label={t.resizePrice} title={t.resizePrice} tabindex="-1"></button>
            ))}
          </div>
        </div>
        <div class="video-price-style" data-price-style>
          <button type="button" class="video-style-trigger" data-price-style-trigger title={t.style} aria-expanded="false" aria-controls="video-price-style-panel" disabled>
            <span>{t.style}</span>
          </button>
          <button type="button" class="video-reset-price" data-reset-price data-reset-position-label={t.resetPrice} data-reset-size-label={t.resetPriceSize} title={t.resetPrice} hidden disabled>{t.resetPrice}</button>
          <div id="video-price-style-panel" class="video-style-panel" data-price-style-panel role="group" aria-label={t.priceStyle} hidden>
            <div class="video-style-row">
              <label for="video-price-colour">{t.priceColour}</label>
              <input id="video-price-colour" class="video-colour-input" data-price-colour type="color" value="#ffffff" title={t.priceColour} disabled />
            </div>
            <div class="video-colour-swatches" role="group" aria-label={t.priceColour}>
              {['#ffffff', '#ff981e', '#ffd166', '#80ed99', '#90c7ff', '#ff99c8'].map(colour => (
                <button type="button" class="video-colour-swatch" data-price-swatch={colour} style={`--swatch: ${colour}`} aria-label={`${t.priceColour}: ${colour}`} title={colour} aria-pressed={colour === '#ffffff' ? 'true' : 'false'} disabled></button>
              ))}
            </div>
            <div class="video-style-row video-font-row">
              <label for="video-price-font">{t.priceFont}</label>
              <select id="video-price-font" data-price-font disabled>
                <option value="modern">{t.fontModern}</option>
                <option value="condensed">{t.fontCondensed}</option>
                <option value="serif">{t.fontSerif}</option>
                <option value="mono">{t.fontMono}</option>
                <option value="digital">{t.fontDigital}</option>
              </select>
            </div>
            <div class="video-style-row video-stroke-row">
              <label for="video-price-stroke">{t.priceStroke}</label>
              <input id="video-price-stroke" class="video-stroke-toggle" data-price-stroke type="checkbox" disabled />
            </div>
            <div class="video-stroke-options" data-stroke-options hidden>
              <div class="video-style-row">
                <label for="video-price-stroke-width">{t.strokeWeight}</label>
                <input id="video-price-stroke-width" class="video-stroke-width" data-price-stroke-width type="range" min="0.5" max="6" step="0.5" value="1" disabled />
                <output for="video-price-stroke-width" data-stroke-width-value>1</output>
              </div>
              <div class="video-style-row">
                <label for="video-price-stroke-colour">{t.strokeColour}</label>
                <input id="video-price-stroke-colour" class="video-colour-input" data-price-stroke-colour type="color" value="#000000" disabled />
              </div>
            </div>
            <button type="button" class="video-style-reset" data-reset-price-style disabled>{t.resetPriceStyle}</button>
          </div>
        </div>
        <p id="video-price-keyboard-hint" class="video-sr-only">{t.priceKeyboardHint}</p>
      </section>
      <section class="video-dock" aria-label={t.controlsLabel}>
        <form class="video-form" data-video-form novalidate>
          <button class="video-change video-cancel" type="button" data-cancel-video hidden>{t.cancel}</button>
          <label class="video-sr-only" for="video-url">{t.videoLabel}</label>
          <div class="video-url-field">
            <svg class="video-url-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none" /></svg>
            <input id="video-url" data-video-url type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder={t.urlPlaceholder} aria-describedby="video-error" disabled />
            <button class="video-submit" type="submit" data-load-video aria-label={t.load} title={t.load} disabled>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </button>
          </div>
        </form>
        <div class="video-playback" data-video-controls hidden>
          <button type="button" class="video-change" data-change-video disabled>{t.changeVideo}</button>
          <div class="video-player-panel" role="group" aria-label={t.controlsLabel}>
          <div class="video-timeline">
            <input class="video-seek" data-video-seek type="range" min="0" max="0" value="0" step="1" aria-label={t.seek} aria-valuetext={t.playbackPosition.replace('{current}', '0:00').replace('{duration}', '—')} disabled />
          </div>
          <div class="video-controls">
          <button type="button" class="video-icon-button" data-play-pause aria-label={t.play} title={t.play} disabled>
            <svg data-play-icon width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
            <svg data-pause-icon hidden width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
          </button>
          <div class="video-volume-control">
            <button type="button" class="video-icon-button" data-mute aria-label={t.mute} title={t.mute} disabled>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 5-6 4H2v6h3l6 4z" /><path data-muted-icon hidden d="m16 9 6 6m0-6-6 6" /><path data-sound-icon d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /></svg>
            </button>
            <label for="video-volume" class="video-sr-only">{t.volume}</label>
            <span class="video-volume-reveal">
              <input id="video-volume" class="video-seek video-volume-slider" data-video-volume type="range" min="0" max="100" value="100" step="1" aria-valuetext="100%" disabled />
            </span>
          </div>
          <div class="video-time" aria-hidden="true">
            <span data-video-current>0:00</span><span>/</span><span data-video-duration>—</span>
          </div>
          <button type="button" class="video-icon-button" data-subtitles aria-label={t.subtitles} title={t.subtitlesUnavailable} aria-pressed="false" disabled>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="3" /><path d="M10 9.5C8.5 8 6 9 6 12s2.5 4 4 2.5M18 9.5C16.5 8 14 9 14 12s2.5 4 4 2.5" /></svg>
          </button>
          <button type="button" class="video-icon-button" data-loop aria-label={t.loop} title={t.loop} aria-pressed="false" disabled>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3" /></svg>
          </button>
          </div>
          </div>
        </div>
        <p id="video-error" class="video-message video-error" data-video-error role="alert" hidden></p>
        <p class="video-sr-only" data-video-status role="status" hidden></p>
        <p class="video-message" data-control-status role="status" hidden></p>
        <noscript><p class="video-message">{t.noScript}</p></noscript>
      </section>
    </main>
  </div>
</Layout>

<script>
  import '../../scripts/video-mode';
</script>

<style>
  @font-face {
    font-family: 'OBT Digital';
    src: url('/fonts/OBTDigital-Regular.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }
  :global(html:has(.video-page)) { scrollbar-gutter: auto; background: #080808; }
  :global(body:has(.video-page)) { background: #080808; color: #fff; }
  :global(body:has(.video-page) .nav-menu-trigger) { color: #fff; background: rgb(16 16 16 / .65); box-shadow: none; backdrop-filter: blur(12px); }
  :global(body:has(.video-page) .lang-menu), :global(body:has(.video-page) .theme-menu) { border: 0; }
  .video-page { --video-ui-fade: .25s; min-height: 100svh; position: relative; isolation: isolate; color-scheme: dark; }
  .video-background, .video-shade { position: fixed; inset: 0; pointer-events: none; }
  .video-background { z-index: -2; overflow: hidden; background: #080808; }
  /* Cover the viewport with a 16:9 player in either orientation. */
  .video-background :global(iframe) { position: absolute; top: 50%; left: 50%; width: max(100vw, 177.778vh); height: max(100vh, 56.25vw); min-width: 200px; min-height: 200px; transform: translate(-50%, -50%); border: 0; }
  /* Keep YouTube's native captions inside the visible viewport. */
  .video-page[data-subtitles-enabled] .video-background :global(iframe) { width: 100vw; height: 100vh; }
  .video-shade { z-index: -1; background: linear-gradient(rgb(0 0 0 / .3), transparent 30%, transparent 65%, rgb(0 0 0 / .45)); }
  .video-main { min-height: 100svh; }
  .video-appearance { position: fixed; top: var(--menu-control-top); right: calc(var(--menu-control-right) + var(--menu-control-size) + .75rem); height: var(--menu-control-size); display: flex; align-items: center; gap: .65rem; z-index: 3; }
  button, select { cursor: pointer; }
  button:disabled, input:disabled, select:disabled { cursor: default; opacity: .35; }
  button, input, select { -webkit-tap-highlight-color: transparent; }
  button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid #ffc477; outline-offset: 4px; }
  .video-icon-button { width: var(--menu-control-size); height: var(--menu-control-size); display: grid; place-items: center; border: 0; background: rgb(16 16 16 / .65); backdrop-filter: blur(12px); border-radius: 50%; color: #fff; }
  .video-icon-button:hover { background: rgb(50 50 50 / .85); }
  .video-currency { position: relative; height: var(--menu-control-size); }
  .video-price-style { position: fixed; display: flex; align-items: stretch; gap: .65rem; width: max-content; max-width: calc(100vw - 2rem); z-index: 4; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .15s ease, visibility .15s; text-align: left; }
  .video-page[data-price-layout-ready] .video-price-style { opacity: 1; visibility: visible; pointer-events: auto; }
  .video-style-trigger, .video-reset-price { display: flex; align-items: center; justify-content: center; flex: 1 1 auto; min-width: 0; min-height: 3.25rem; line-height: 1.25; padding: .75rem 1.25rem; border: 0; border-radius: 999px; background: rgb(16 16 16 / .85); backdrop-filter: blur(12px); color: #fff; font-size: 1rem; font-weight: 600; }
  .video-style-trigger:hover, .video-reset-price:hover, .video-style-trigger[aria-expanded="true"] { background: rgb(50 50 50 / .85); }
  .video-style-panel { position: fixed; width: min(260px, calc(100vw - 2rem)); max-height: calc(100svh - 2rem); overflow-y: auto; padding: 1rem; border: 0; border-radius: 14px; background: rgb(16 16 16 / .95); backdrop-filter: blur(16px); box-shadow: 0 8px 40px #0005; font-size: .8rem; }
  .video-style-row { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .video-style-row label { color: #ddd; }
  .video-colour-input { width: 2.75rem; height: 2rem; padding: .2rem; border: 0; border-radius: 7px; cursor: pointer; }
  .video-colour-input::-webkit-color-swatch-wrapper { padding: 0; }
  .video-colour-input::-webkit-color-swatch { border: 0; border-radius: 3px; }
  .video-colour-input::-moz-color-swatch { border: 0; border-radius: 3px; }
  .video-colour-swatches { display: flex; justify-content: space-between; gap: .25rem; margin: .5rem -.25rem .85rem; }
  .video-colour-swatch { display: grid; place-items: center; width: 2rem; height: 2rem; flex-shrink: 0; padding: .25rem; border: 0; border-radius: 50%; background: transparent; }
  .video-colour-swatch::after { content: ''; width: 100%; height: 100%; border-radius: 50%; background: var(--swatch); }
  .video-colour-swatch:hover { background: #ffffff20; }
  .video-colour-swatch[aria-pressed="true"] { background: #ffffff30; }
  .video-font-row { padding-top: .85rem; }
  .video-font-row select { min-width: 0; max-width: 70%; padding: .45rem; border: 0; border-radius: 7px; background: #242424; color: #fff; font-size: .8rem; }
  .video-stroke-row { margin-top: .85rem; padding-top: .85rem; }
  .video-stroke-toggle { appearance: auto; width: 1.1rem; height: 1.1rem; accent-color: #ff981e; cursor: pointer; }
  .video-stroke-options { display: grid; gap: .65rem; margin-top: .65rem; }
  .video-stroke-width { appearance: auto; width: 5rem; height: 2rem; padding: 0; accent-color: #ff981e; cursor: pointer; }
  .video-stroke-options output { min-width: 2.5rem; color: #ccc; font-size: .7rem; text-align: right; font-variant-numeric: tabular-nums; }
  .video-style-reset { display: block; margin: .85rem auto 0; padding: .35rem .5rem; border: 0; border-radius: 5px; background: transparent; color: #ccc; font-size: .75rem; }
  .video-style-reset:hover:enabled { background: #ffffff15; color: #fff; }
  .video-currency-trigger { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; height: var(--menu-control-size); padding: .5rem 1.1rem; border: 0; background: rgb(16 16 16 / .65); backdrop-filter: blur(12px); border-radius: 999px; color: #fff; letter-spacing: .08em; font-size: .85rem; font-weight: 600; }
  .video-currency-trigger:hover, .video-currency-trigger[aria-expanded="true"] { background: rgb(50 50 50 / .85); }
  .video-currency-chevron { flex-shrink: 0; transition: transform .15s ease; }
  .video-currency-trigger[aria-expanded="true"] .video-currency-chevron { transform: rotate(180deg); }
  .video-currency-menu { position: absolute; top: calc(100% + .5rem); right: 0; min-width: 8.5rem; max-height: calc(100svh - var(--menu-control-top) - var(--menu-control-size) - 1.5rem); overflow-y: auto; scrollbar-width: thin; scrollbar-color: rgb(255 255 255 / .25) transparent; padding: .35rem; border: 0; border-radius: 14px; background: rgb(16 16 16 / .9); backdrop-filter: blur(16px); box-shadow: 0 8px 40px #0005; }
  .video-currency-option { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; width: 100%; padding: .7rem .75rem; border: 0; border-radius: 9px; background: transparent; color: #ccc; letter-spacing: .08em; font-size: .8rem; font-weight: 600; }
  .video-currency-option svg { visibility: hidden; flex-shrink: 0; }
  .video-currency-option[aria-selected="true"] { color: #fff; background: rgb(255 255 255 / .09); }
  .video-currency-option[aria-selected="true"] svg { visibility: visible; }
  .video-currency-option:hover, .video-currency-option:focus-visible { color: #fff; background: rgb(255 255 255 / .14); }
  .video-currency-option:focus-visible { outline: 1px solid rgb(255 255 255 / .5); outline-offset: -1px; }
  .video-price-stage { position: absolute; inset: 0; width: 100%; text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 5.5rem 1.5rem 6.5rem; pointer-events: none; }
  .video-alignment-grid { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
  .video-alignment-grid::before, .video-alignment-grid::after { content: ''; position: absolute; background: rgb(255 255 255 / .25); box-shadow: 0 0 2px #0008; }
  .video-alignment-grid::before { top: 0; bottom: 0; left: 50%; width: 1px; }
  .video-alignment-grid::after { left: 0; right: 0; top: 50%; height: 1px; }
  .video-page[data-price-snap-x] .video-alignment-grid, .video-page[data-price-snap-y] .video-alignment-grid { opacity: 1; }
  .video-page[data-price-snap-x] .video-alignment-grid::before, .video-page[data-price-snap-y] .video-alignment-grid::after { background: #ff981e; }
  .video-price-position { display: flex; flex-direction: column; align-items: center; width: max-content; }
  .video-page[data-price-layout-ready] .video-price-position { position: absolute; z-index: 2; pointer-events: auto; cursor: grab; touch-action: none; user-select: none; }
  .video-price-editing { position: absolute; inset: 0; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity var(--video-ui-fade) ease, visibility 0s linear var(--video-ui-fade); }
  .video-price-editing::after { content: ''; position: absolute; inset: 0; border: 1px solid rgb(255 255 255 / .8); border-radius: 3px; pointer-events: none; }
  .video-page[data-price-layout-open] .video-price-editing { opacity: 1; visibility: visible; transition-delay: 0s; }
  .video-price-resize { position: absolute; z-index: 1; width: 32px; height: 32px; display: grid; place-items: center; border: 0; padding: 0; background: transparent; transform: translate(-50%, -50%); touch-action: none; pointer-events: none; }
  .video-price-resize::after { content: ''; width: 16px; height: 16px; border-radius: 50%; background: #ff981e; box-shadow: 0 1px 5px #0008; }
  .video-page[data-price-layout-open] .video-price-resize { pointer-events: auto; }
  .video-price-resize-nw { top: 0; left: 0; cursor: nwse-resize; }
  .video-price-resize-ne { top: 0; left: 100%; cursor: nesw-resize; }
  .video-price-resize-sw { top: 100%; left: 0; cursor: nesw-resize; }
  .video-price-resize-se { top: 100%; left: 100%; cursor: nwse-resize; }
  .video-price-position:focus-visible { outline: none; }
  .video-price-position:focus-visible .video-price-editing::after { border-color: #ffc477; }
  .video-price-resize:focus-visible { outline: none; }
  .video-price-resize:focus-visible::after { outline: 2px solid #ffc477; outline-offset: 3px; }
  .video-page[data-price-dragging] .video-price-position { cursor: grabbing; }
  .video-page[data-price-resizing="nw"] .video-price-position, .video-page[data-price-resizing="se"] .video-price-position { cursor: nwse-resize; }
  .video-page[data-price-resizing="ne"] .video-price-position, .video-page[data-price-resizing="sw"] .video-price-position { cursor: nesw-resize; }
  .video-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  /* Scale the default proportionally up to 4K; saved sizes remain relative multipliers. */
  /* Compensate for the final negative letter spacing so the last glyph stays inside the frame. */
  .video-price { --price-chars: 8; --video-price-base-size: clamp(3rem, min(9.375vw, 16.6667vh, 207vw / var(--price-chars)), 22.5rem); color: var(--video-price-colour, #fff); font-family: var(--video-price-font, var(--font-sans)); font-size: calc(var(--video-price-base-size) * var(--video-price-scale, 1) * var(--video-price-fit, 1)); font-weight: var(--video-price-weight, 750); letter-spacing: var(--video-price-spacing, -.065em); padding-inline-end: .065em; padding-block: var(--video-price-padding, 0); -webkit-text-stroke: var(--video-price-stroke-width, 0px) var(--video-price-stroke-colour, #000); paint-order: stroke fill; line-height: 1.2; font-variant-numeric: tabular-nums; white-space: nowrap; text-shadow: 0 3px 30px #000, 0 0 80px #0009; }
  .video-dock { position: fixed; bottom: max(1rem, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: min(480px, calc(100% - 3rem)); z-index: 3; text-align: center; }
  .video-page[data-subtitles-enabled] .video-dock { bottom: max(7rem, 16svh, env(safe-area-inset-bottom)); }
  .video-url-field { display: flex; align-items: center; gap: .75rem; padding: .5rem; padding-left: 1rem; border: 0; border-radius: 14px; background: rgb(20 20 20 / .85); backdrop-filter: blur(16px); box-shadow: 0 8px 40px #0003; }
  .video-url-icon { flex-shrink: 0; color: #aaa; }
  input { min-width: 0; width: 100%; border: 0; background: transparent; color: #fff; font-size: .85rem; padding: .5rem 0; }
  input::placeholder { color: #aaa; }
  input[aria-invalid="true"] { color: #ffc2b2; }
  [data-video-url]:focus-visible { outline: none; }
  .video-url-field:has([data-video-url]:focus-visible) { background: rgb(35 35 35 / .95); }
