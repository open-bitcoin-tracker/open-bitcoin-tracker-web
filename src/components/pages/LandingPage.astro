---
import { Image } from 'astro:assets';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import AppScreenshot from '../AppScreenshot.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';
import { tracker } from '../../i18n/tracker';
import { aBitOfEarth } from '../../lib/projects';
import BitcoinPreview from '../BitcoinPreview.astro';
import VideoPreview from '../VideoPreview.astro';
import earthPreview from '../../assets/previews/earth.jpg';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
const home = t.landing;
const href = (path: string) => getRelativeLocaleUrl(lang, path);
const repo = 'https://github.com/open-bitcoin-tracker/open-bitcoin-tracker-web';
---

<Layout page="landing">
  <Nav />
  <main id="main-content" class="landing-main">
    <header class="masthead">
      <h1 lang="en" class="brand-name" aria-label="Open Bitcoin Tracker">
        <button class="masthead-brand" type="button" data-brand-toggle aria-label="Open Bitcoin Tracker" aria-expanded="false">
          <img src="/app-icon.png" width="56" height="56" alt="" />
          <span class="brand-wordmark" aria-hidden="true"><span class="brand-word">O<span class="brand-reveal"><span>pen&nbsp;</span></span></span><span class="brand-word">B<span class="brand-reveal"><span>itcoin&nbsp;</span></span></span><span class="brand-word">T<span class="brand-reveal"><span>racker</span></span></span></span>
        </button>
      </h1>
    </header>

    <section id="tools" class="tools" aria-label={home.toolsLabel}>
      <a class="chart-feature tool-link" href={href('price-tracker')}>
        <div class="chart-copy">
          <h2>{tracker[lang].priceChart}</h2>
          <p>{home.priceDescription}</p>
          <span class="text-action">{home.openChart}<span aria-hidden="true">↗</span></span>
        </div>
        <BitcoinPreview />
      </a>

      <div class="explore-grid">
        <article class="earth-tool">
          <a class="tool-link secondary-tool" href={href(aBitOfEarth.path)}>
            <div class="tool-heading"><h2 lang="en">{aBitOfEarth.title}</h2></div>
            <figure class="secondary-preview earth-preview">
              <Image src={earthPreview} alt="" widths={[480, 800, 1280]} sizes="(max-width: 700px) 100vw, 55vw" format="webp" quality={85} loading="lazy" />

            </figure>
            <div class="tool-description"><p>{home.earthDescription}</p><span class="text-action">{home.openEarth}<span aria-hidden="true">↗</span></span></div>
          </a>
        </article>
        <article class="video-tool secondary-tool">
            <div class="tool-heading"><h2><a class="tool-link video-card-link" href={href('video-mode')}>{t.nav.videoMode}</a></h2></div>
            <VideoPreview />
            <div class="tool-description"><p>{home.videoDescription}</p><span class="text-action">{home.openVideo}<span aria-hidden="true">↗</span></span></div>
        </article>
      </div>

      <a class="app-feature tool-link" href={href('android-app')}>
        <div class="app-copy">
          <h2>{tracker[lang].app}</h2>
          <p class="app-description">{home.appDescription}</p>
          <span class="app-action">{home.openApp}<span aria-hidden="true">↗</span></span>
        </div>
        <div class="app-preview" aria-hidden="true">
          <div class="phone-frame"><AppScreenshot name="paper" darkName="deepsea" alt="" /></div>
        </div>
      </a>
    </section>

    <footer class="landing-footer">
      <div class="footer-links">
        <a href={repo} target="_blank" rel="noopener noreferrer">{t.footer.github}<span aria-hidden="true">↗</span></a>
        <a href={href('about')}>{t.footer.about}</a>
        <span>{t.footer.copyright}</span>
      </div>
    </footer>
  </main>
</Layout>

<script>
  const brand = document.querySelector<HTMLButtonElement>('[data-brand-toggle]');
  if (brand) {
    const mobile = window.matchMedia('(max-width: 700px)');
    const hover = window.matchMedia('(hover: hover)');
    const usesHover = () => !mobile.matches && hover.matches;
    const expand = (expanded: boolean) => brand.setAttribute('aria-expanded', String(expanded));
    brand.addEventListener('pointerenter', () => { if (usesHover()) expand(true); });
    brand.addEventListener('pointerleave', () => { if (usesHover() && !brand.matches(':focus-visible')) expand(false); });
    brand.addEventListener('focus', () => { if (usesHover() && brand.matches(':focus-visible')) expand(true); });
    brand.addEventListener('blur', () => expand(usesHover() && brand.matches(':hover')));
    brand.addEventListener('click', () => {
      if (!usesHover()) expand(brand.getAttribute('aria-expanded') !== 'true');
    });
    brand.addEventListener('keydown', (event) => { if (event.key === 'Escape') expand(false); });
    mobile.addEventListener('change', () => expand(false));
    hover.addEventListener('change', () => expand(false));
  }
</script>

<style>
  /* Dark mode inherits the shared Android app palette and menu controls. */
  :global(html:not(.dark):has(.landing-main)) {
    --color-paper: #f4f2eb;
    --color-surface: #fffef9;
    --color-ink: #252722;
    --color-ink-muted: #65675e;
    --color-divider: #d5d6cc;
    --color-ink-rgb: 37 39 34;
    --color-paper-rgb: 244 242 235;
    --menu-control-bg: #e8e8df;
    --menu-control-ink: #252722;
    background: var(--color-paper);
  }
  .landing-main { max-width: 1280px; margin-inline: auto; padding: 0 clamp(1.25rem, 4.5vw, 4rem); }
  .masthead { container-type: inline-size; min-height: 105px; display: flex; align-items: flex-start; padding-top: var(--menu-control-top); padding-right: 4.75rem; }
  .masthead h1 { display: flex; min-width: 0; max-width: 100%; font-size: calc(var(--menu-control-size) * 1.25); line-height: 1.06; letter-spacing: -.015em; white-space: nowrap; transition: font-size 550ms cubic-bezier(.22, 1, .36, 1); }
  .masthead h1:has([aria-expanded="true"]) { font-size: clamp(1rem, calc((100cqi - var(--menu-control-size) - 1rem) / 8.5), calc(var(--menu-control-size) * 1.25)); }
  .masthead-brand { display: inline-flex; align-items: center; height: var(--menu-control-size); gap: .875rem; border-radius: 8px; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: default; }
  .masthead-brand img { flex: none; width: var(--menu-control-size); height: var(--menu-control-size); border-radius: 12px; }
  .brand-wordmark, .brand-word { display: inline-flex; flex-shrink: 0; }
  /* Align the visible capitals with the icon, accounting for the font's descent. */
  .brand-wordmark { transform: translateY(-.05em); }
  .brand-reveal { display: inline-grid; grid-template-columns: 0fr; opacity: 0; transition: grid-template-columns 550ms cubic-bezier(.22, 1, .36, 1), opacity 350ms ease; }
  .brand-reveal > span { min-width: 0; overflow: hidden; }
  .masthead-brand[aria-expanded="true"] .brand-reveal { grid-template-columns: 1fr; opacity: 1; }
  h2 { overflow-wrap: anywhere; font-family: 'Barlow Condensed', var(--font-sans); font-weight: 700; text-transform: uppercase; }
  .app-feature > * { min-width: 0; }
  .text-action { display: inline-flex; align-items: center; gap: .8rem; font-size: .8125rem; font-weight: 600; line-height: 1.4; }
  .text-action > span { font-size: 1.1rem; }
  .tools { padding-top: clamp(1.5rem, 3vw, 2.5rem); }
  .tool-link { display: block; }
  .chart-feature { display: grid; grid-template-columns: 1fr 2.15fr; border: 1px solid var(--color-divider); background: var(--color-surface); }
  .chart-copy { display: flex; flex-direction: column; align-items: start; padding: clamp(1.5rem, 3vw, 2.5rem); }
  .chart-copy h2 { font-size: clamp(2.5rem, 3.8vw, 3.75rem); line-height: 1; letter-spacing: -.015em; }
  .chart-copy > p { margin-top: 1rem; max-width: 20ch; color: var(--color-ink-muted); font-size: .875rem; line-height: 1.65; }
  .chart-copy .text-action { margin-top: auto; padding-top: 2rem; }
  .explore-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.5rem; padding-block: 3rem; }
  .tool-heading { display: flex; align-items: center; gap: .75rem; padding-block: 0 1.2rem; }
  .tool-heading h2 { font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1.1; }
  .secondary-preview { position: relative; height: clamp(200px, 23vw, 280px); background: #202629; overflow: hidden; }
  .secondary-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .earth-preview img { object-fit: contain; object-position: center; }
  .video-tool { position: relative; }
  .video-card-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .video-tool:has(.video-card-link:hover) h2 { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 7px; }
  .video-tool:has(.video-card-link:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .tool-description { display: flex; justify-content: space-between; gap: 1.25rem; align-items: start; padding-top: 1.1rem; }
  .tool-description p { color: var(--color-ink-muted); font-size: .8125rem; line-height: 1.7; max-width: 24ch; }
  .tool-description .text-action { font-size: .75rem; margin-top: .15rem; }
  .tool-link .text-action > span, .app-action > span { transition: transform 180ms ease; }
  .tool-link:hover .text-action > span, .video-tool:has(.video-card-link:hover) .text-action > span, .tool-link:hover .app-action > span { transform: translate(2px, -2px); }
  .tool-link:hover h2 { text-decoration: underline; text-decoration-color: var(--color-accent); text-decoration-thickness: 2px; text-underline-offset: 7px; }
  .app-feature { display: grid; grid-template-columns: 1.35fr 1fr; background: var(--color-surface); border-top: 1px solid var(--color-divider); border-bottom: 1px solid var(--color-divider); overflow: hidden; }
  .app-copy { padding: clamp(2rem, 4vw, 3.5rem); }
  .app-copy h2 { font-size: clamp(2.8rem, 4.6vw, 4.6rem); letter-spacing: -.02em; line-height: .98; max-width: 14ch; text-wrap: balance; }
  .app-description { color: var(--color-ink-muted); font-size: .875rem; line-height: 1.75; max-width: 34ch; margin-top: 1.2rem; }
  .app-action { display: inline-flex; align-items: center; gap: 1.2rem; margin-top: 1.7rem; padding: .9rem 1.15rem; background: var(--color-accent); color: #252722; font-size: .75rem; font-weight: 650; }
  .app-action > span { font-size: 1.1rem; }
  .app-preview { position: relative; min-height: 400px; display: flex; justify-content: center; align-items: start; overflow: hidden; background: #e4e5da; padding-top: 2.25rem; }
  :global(html.dark) .app-preview { background: var(--color-accent-soft); }
  .phone-frame { position: absolute; top: 2.25rem; width: 235px; border: 5px solid #252722; border-radius: 30px; overflow: hidden; box-shadow: 0 20px 35px #0002; transform: rotate(5deg); }
  .phone-frame :global(img) { display: block; width: 100%; height: auto; }
  .landing-footer { display: flex; justify-content: flex-end; align-items: center; gap: 2rem; padding-block: 2.5rem; }
  .footer-links { color: var(--color-ink-muted); font-size: .6875rem; }
  .landing-footer .footer-links { display: flex; align-items: center; flex-wrap: wrap; gap: 1.5rem; padding: 0; border: 0; }
  .footer-links a { display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; }
  .footer-links a:hover { color: var(--color-ink); text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 1450px) { .masthead { padding-right: 0; } }
  @media (max-width: 1000px) {
    .chart-feature { grid-template-columns: 1fr 1.8fr; }
    .explore-grid { gap: 1.5rem; }
    .tool-description { flex-direction: column; gap: .6rem; }
    .tool-description p { max-width: 32ch; }
    .landing-footer { align-items: start; }
  }
  @media (max-width: 700px) {
    .masthead { min-height: 88px; padding-right: 3.75rem; }
    .masthead-brand { gap: .5rem; }
    .chart-feature { grid-template-columns: 1fr; }
    .chart-copy { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: .6rem; padding: 1.25rem; }
    .chart-copy h2 { margin: 0; font-size: 2rem; }
    .chart-copy > p { grid-column: 1 / -1; margin: 0; max-width: none; font-size: .75rem; }
    .chart-copy .text-action { grid-column: 1 / -1; padding-top: .4rem; margin: 0; font-size: .75rem; }
    .explore-grid { grid-template-columns: 1fr; gap: 2rem; padding-block: 2rem; }
    .tool-heading { padding-bottom: .8rem; }
    .tool-heading h2 { font-size: 2rem; }
    .secondary-preview { height: auto; aspect-ratio: 1.8; }
    .tool-description { flex-direction: row; }
    .tool-description p { max-width: 26ch; font-size: .75rem; }
    .tool-description .text-action { font-size: .6875rem; }
    .app-feature { grid-template-columns: 1.25fr 1fr; }
    .app-copy { padding: 1.5rem 1rem; }
    .app-copy h2 { font-size: clamp(2.2rem, 7vw, 3.25rem); }
    .app-description { font-size: .75rem; }
    .app-action { font-size: .6875rem; padding: .75rem; gap: .6rem; }
    .app-preview { min-height: 320px; padding-top: 2.5rem; }
    .phone-frame { width: 175px; flex-shrink: 0; margin-left: 2rem; border-radius: 23px; border-width: 4px; }
    .landing-footer { flex-direction: column; gap: .75rem; padding-block: 2rem; }
    .landing-footer .footer-links { gap: 1.25rem; }
  }
  @media (max-width: 420px) {
    .app-feature { grid-template-columns: minmax(0, 1fr); }
    .app-copy { padding: 1.5rem; }
    .app-copy h2 { max-width: 15ch; }
    .app-preview { min-height: 240px; }
    .phone-frame { width: 200px; top: 1.5rem; margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead h1, .brand-reveal { transition: none; }
    .tool-link .text-action > span, .app-action > span { transition: none; }
    .tool-link:hover .text-action > span, .video-tool:has(.video-card-link:hover) .text-action > span, .tool-link:hover .app-action > span { transform: none; }
  }
</style>
