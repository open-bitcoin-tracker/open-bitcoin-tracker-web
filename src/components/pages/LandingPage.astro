---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';
import { tracker } from '../../i18n/tracker';
import { aBitOfEarth } from '../../lib/projects';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<Layout page="landing">
  <Nav />
  <main id="main-content" class="landing-main">
    <div class="landing-content">
      <header class="landing-brand">
        <img src="/app-icon.png" width="72" height="72" alt="" class="landing-icon" />
        <h1 lang="en" class="brand-name">Open Bitcoin Tracker</h1>
      </header>
      <div class="landing-options">
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'price-tracker')}>
          <div class="option-preview preview-chart" aria-hidden="true">
            <svg viewBox="0 0 360 240" fill="none">
              <rect class="chart-window" x="30" y="40" width="300" height="170" rx="16" />
              <path class="chart-grid" d="M52 80h256M52 120h256M52 160h256M96 64v128M156 64v128M216 64v128M276 64v128" />
              <path class="chart-fill" d="M52 177l27-17 18 9 27-36 21 10 24-28 22 9 28-37 20 12 31-43 38-9v145H52Z" />
              <path class="chart-line" d="m52 177 27-17 18 9 27-36 21 10 24-28 22 9 28-37 20 12 31-43 38-9" />
              <circle class="chart-coin" cx="287" cy="53" r="27" />
              <text class="chart-glyph" x="287" y="63" text-anchor="middle">₿</text>
            </svg>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2>{t.landing.priceTracker}</h2>
              <svg class="option-arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </div>
            <p>{t.landing.priceDescription}</p>
          </div>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'android-app')}>
          <div class="option-preview preview-app" aria-hidden="true">
            <div class="preview-phone">
              <img class="phone-light" src="/screenshots/paper-cream.png" width="1280" height="2856" alt="" />
              <img class="phone-dark" src="/screenshots/deepsea-blue.png" width="1280" height="2856" alt="" />
            </div>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2>{tracker[lang].app}</h2>
              <svg class="option-arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </div>
            <p>{t.hero.tagline}</p>
          </div>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, aBitOfEarth.path)}>
          <div class="option-preview preview-earth" aria-hidden="true">
            <svg viewBox="0 0 360 240" fill="none">
              <defs><clipPath id="landing-earth-clip"><circle cx="180" cy="120" r="76" /></clipPath></defs>
              <circle class="earth-orbit" cx="180" cy="120" r="100" />
              <circle class="earth-water" cx="180" cy="120" r="76" />
              <g class="earth-land" clip-path="url(#landing-earth-clip)">
                <path d="m123 56 24-11 19 8 4 15-19 16-3 16-17 8-20-20-10-9Zm34 56 22 5 14 19-11 24-13 24-11-10 2-25-13-18Zm43-63 20 10 22 15 16 21-11 15-15-10-14-14-18 8-12-13 4-20Zm0 58 25-5 16 21-9 30-20 12-13-27-8-15Zm40 63 19-6 13 17-15 12-20-7ZM141 187l38 8 42-7 21 12-47 6-46-4Z" />
              </g>
              <g class="earth-grid">
                <circle cx="180" cy="120" r="76" />
                <ellipse cx="180" cy="120" rx="34" ry="76" />
                <path d="M104 120h152M114 82q66 26 132 0M114 158q66-26 132 0" />
              </g>
              <rect class="earth-share" x="180" y="117" width="27" height="27" />
              <path class="earth-crosshair" d="M180 16v8m-4-4h8M280 116v8m-4-4h8M80 116v8m-4-4h8M180 216v8m-4-4h8" />
            </svg>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2 lang="en">{aBitOfEarth.title}</h2>
              <svg class="option-arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </div>
            <p>{t.landing.earthDescription}</p>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-main {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: max(7rem, env(safe-area-inset-top, 0px)) clamp(1.25rem, 4vw, 3rem) max(4rem, env(safe-area-inset-bottom, 0px));
    background: radial-gradient(ellipse at 15% 10%, var(--hero-glow), transparent 50%);
  }
  .landing-content { width: 100%; max-width: 72rem; }
  .landing-brand { display: flex; align-items: center; gap: clamp(.75rem, 2vw, 1.5rem); container-type: inline-size; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .landing-icon { width: 72px; height: 72px; flex-shrink: 0; border-radius: 18px; }
  h1 { min-width: 0; font-size: clamp(1.1875rem, 8cqi, 5.5rem); line-height: 1.06; letter-spacing: -.015em; white-space: nowrap; }
  .landing-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .landing-option {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-ink);
    min-width: 0;
    transition: border-color .2s, transform .2s var(--ease-out), box-shadow .2s;
  }
  .landing-option:hover, .landing-option:focus-visible { border-color: var(--color-accent-text); box-shadow: var(--shadow-card-hover); }
  .landing-option:hover { transform: translateY(-4px); }
  .option-preview { position: relative; aspect-ratio: 3 / 2; overflow: hidden; border-radius: calc(var(--radius-xl) - 1px) calc(var(--radius-xl) - 1px) 0 0; background: color-mix(in srgb, var(--color-paper) 80%, var(--color-surface)); }
  .option-preview > svg { display: block; width: 100%; height: 100%; }
  .preview-chart { background: linear-gradient(145deg, var(--color-accent-soft), var(--color-paper)); }
  .chart-window { fill: var(--color-surface); stroke: var(--color-divider); }
  .chart-grid { stroke: var(--color-divider); }
  .chart-fill { fill: var(--color-accent); fill-opacity: .13; }
  .chart-line { stroke: var(--color-accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .chart-coin { fill: var(--color-accent); stroke: var(--color-surface); stroke-width: 5; }
  .chart-glyph { fill: #1F1B14; font-size: 30px; font-weight: 600; }
  .preview-app { background: radial-gradient(ellipse at 50% 95%, var(--hero-glow), transparent 70%), var(--color-paper); }
  .preview-phone { position: absolute; top: 32px; left: 50%; width: 150px; padding: 4px; border: 1px solid rgb(255 255 255 / .15); border-radius: 24px; background: #1F1B14; box-shadow: 12px 16px 32px var(--phone-shadow); transform: translateX(-50%) rotate(-8deg); }
  .preview-phone img { display: block; width: 100%; border-radius: 20px; }
  .preview-phone .phone-dark { display: none; }
  :global(html.dark) .phone-light { display: none; }
  :global(html.dark) .preview-phone .phone-dark { display: block; }
  .preview-earth { background: linear-gradient(155deg, var(--color-paper), var(--color-accent-soft)); }
  .earth-orbit { stroke: var(--color-divider); stroke-dasharray: 3 5; }
  .earth-water { fill: var(--color-surface); }
  .earth-land { fill: var(--color-ink); fill-opacity: .13; }
  .earth-grid { stroke: var(--color-ink); stroke-opacity: .22; }
  .earth-share { fill: var(--color-accent); fill-opacity: .35; stroke: var(--color-accent-text); stroke-width: 2; }
  .earth-crosshair { stroke: var(--color-accent-text); stroke-width: 1.5; }
  .option-copy { padding: 1.5rem; flex: 1; min-width: 0; border-top: 1px solid var(--color-divider); }
  .option-title { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.3; }
  p { margin-top: .75rem; color: var(--color-ink-muted); font-size: .875rem; line-height: 1.65; text-wrap: pretty; }
  .option-arrow { flex-shrink: 0; width: 32px; height: 32px; padding: 6px; border-radius: 50%; background: var(--color-paper); color: var(--color-accent-text); transition: background-color .2s, transform .2s; }
  .landing-option:hover .option-arrow { background: var(--color-accent-soft); transform: translateX(2px); }
  @media (max-width: 700px) {
    .landing-main { padding-top: max(calc(var(--menu-control-top) + var(--menu-control-size) + 1.5rem), env(safe-area-inset-top, 0px)); padding-bottom: max(2rem, env(safe-area-inset-bottom, 0px)); }
    .landing-icon { width: 56px; height: 56px; border-radius: 14px; }
    .landing-options { grid-template-columns: 1fr; gap: .875rem; }
    .landing-option { display: grid; grid-template-columns: 88px minmax(0, 1fr); min-height: 160px; border-radius: 20px; }
    .option-preview { aspect-ratio: auto; border-radius: 19px 0 0 19px; }
    .option-preview > svg { position: absolute; width: 220px; height: 160px; max-width: none; left: 50%; top: 50%; transform: translate(-50%, -50%); }
    .preview-phone { width: 88px; top: 28px; border-radius: 16px; padding: 3px; }
    .preview-phone img { border-radius: 12px; }
    .option-copy { padding: 1.25rem 1rem; border-top: 0; border-left: 1px solid var(--color-divider); }
    .option-title { gap: .5rem; }
    h2 { font-size: 1.0625rem; }
    p { font-size: .8125rem; margin-top: .5rem; }
    .option-arrow { width: 24px; height: 24px; padding: 3px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-option, .option-arrow { transition: none; }
    .landing-option:hover, .landing-option:hover .option-arrow { transform: none; }
  }
</style>
