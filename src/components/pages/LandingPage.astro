---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';
import { tracker } from '../../i18n/tracker';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<Layout page="landing">
  <Nav />
  <main id="main-content" class="landing-main">
    <div class="landing-content">
      <header class="landing-brand">
        <img src="/app-icon.png" width="112" height="112" alt="" class="landing-icon" />
        <h1 lang="en" class="brand-name">Open Bitcoin Tracker</h1>
      </header>
      <div class="landing-options">
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'price-tracker')}>
          <svg class="option-icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3v18h18M6 15l5-5 4 3 6-7" />
          </svg>
          <h2>{t.landing.priceTracker}</h2>
          <p>{t.landing.priceDescription}</p>
          <svg class="option-arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'android-app')}>
          <svg class="option-icon" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="2" width="12" height="20" rx="3" />
            <path d="M10 5h4m-3 14h2" />
          </svg>
          <h2>{tracker[lang].app}</h2>
          <p>{t.hero.tagline}</p>
          <svg class="option-arrow" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-main {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: max(6rem, env(safe-area-inset-top, 0px)) clamp(1.25rem, 4vw, 3rem) max(3rem, env(safe-area-inset-bottom, 0px));
    background: radial-gradient(ellipse at 50% 25%, var(--hero-glow), transparent 60%);
  }
  .landing-content { width: 100%; max-width: 52rem; }
  .landing-brand { text-align: center; margin-bottom: clamp(2.5rem, 6vw, 4rem); }
  .landing-icon { margin: 0 auto 1.75rem; filter: drop-shadow(0 8px 24px var(--hero-glow)); }
  h1 { max-width: 12ch; margin-inline: auto; font-size: clamp(2.75rem, 7vw, 4.75rem); line-height: 1.06; letter-spacing: -.015em; text-wrap: balance; }
  .landing-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .landing-option {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-ink);
    transition: border-color .2s, transform .2s var(--ease-out), box-shadow .2s;
  }
  .landing-option:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow-card-hover); }
  .option-icon { color: var(--color-accent-text); margin-bottom: 1.5rem; }
  h2 { font-size: 1.375rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.3; }
  p { margin-top: .625rem; padding-right: 1rem; color: var(--color-ink-muted); font-size: .9375rem; line-height: 1.65; text-wrap: pretty; }
  .option-arrow { flex-shrink: 0; margin-top: auto; padding-top: 1.5rem; box-sizing: content-box; align-self: flex-end; color: var(--color-accent-text); }
  @media (max-width: 540px) {
    .landing-options { grid-template-columns: 1fr; }
    .landing-icon { width: 88px; height: 88px; margin-bottom: 1.25rem; }
    .landing-option { padding: 1.5rem 3.5rem 1.5rem 1.5rem; }
    .option-icon { width: 28px; height: 28px; margin-bottom: 1rem; }
    .option-arrow { position: absolute; right: 1.25rem; top: 1.625rem; padding-top: 0; }
    p { padding-right: 0; }
  }
</style>
