---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import AppScreenshot from '../AppScreenshot.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';
import { tracker } from '../../i18n/tracker';
import { aBitOfEarth } from '../../lib/projects';

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<Layout page="landing">
  <Nav />
  <main id="main-content" class="landing-main">
    <div class="landing-content">
      <header class="landing-brand">
        <h1 lang="en" class="brand-name" aria-label="Open Bitcoin Tracker">
          <button class="brand-trigger" type="button" data-brand-toggle aria-label="Open Bitcoin Tracker" aria-expanded="false">
            <img class="brand-icon" src="/app-icon.png" width="96" height="96" alt="" />
            <span class="brand-wordmark" aria-hidden="true"><span class="brand-word">O<span class="brand-reveal"><span>pen&nbsp;</span></span></span><span class="brand-word">B<span class="brand-reveal"><span>itcoin&nbsp;</span></span></span><span class="brand-word">T<span class="brand-reveal"><span>racker</span></span></span></span>
          </button>
        </h1>
      </header>
      <div class="landing-options">
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'price-tracker')}>
          <div class="option-preview preview-chart" aria-hidden="true">
            <svg viewBox="0 0 360 240" fill="none">
              <defs><clipPath id="landing-chart-clip"><rect x="30" y="40" width="300" height="170" rx="16" /></clipPath></defs>
              <rect class="chart-window" x="30" y="40" width="300" height="170" rx="16" />
              <g clip-path="url(#landing-chart-clip)">
                <path class="chart-grid" d="M30 80h300M30 120h300M30 160h300M96 64v146M156 64v146M216 64v146M276 64v146" />
                <path class="chart-fill" d="M30 185l22-8 27-17 18 9 27-36 21 10 24-28 22 9 28-37 20 12 31-43 60-9V210H30Z" />
                <path class="chart-line" d="m30 185 22-8 27-17 18 9 27-36 21 10 24-28 22 9 28-37 20 12 31-43 60-9" />
              </g>
            </svg>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2>{tracker[lang].priceChart}</h2>
            </div>
            <p>{t.landing.priceDescription}</p>
          </div>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'video-mode')}>
          <div class="option-preview preview-video" aria-hidden="true">
            <svg viewBox="0 0 360 240" fill="none">
              <defs><clipPath id="landing-video-clip"><rect x="30" y="40" width="300" height="170" rx="16" /></clipPath></defs>
              <rect class="video-window" x="30" y="40" width="300" height="170" rx="16" />
              <g clip-path="url(#landing-video-clip)">
                <path class="video-music-note" transform="translate(242 41) scale(2.5)" d="M12 3v10.55A4 4 0 1 0 14 17V7h4V3Z" />
                <path class="video-landscape" d="m30 162 76-58 65 48 47-25 112 48v35H30Z" />
                <path class="video-landscape video-foreground" d="m30 181 57-28 89 27 75-33 79 40v23H30Z" />
                <text class="video-preview-price" x="180" y="132" text-anchor="middle">$100,000</text>
                <rect class="video-controls" x="30" y="165" width="300" height="45" />
                <path class="video-play" d="m49 180 13 8-13 8z" />
                <path class="video-progress" d="M81 188h228" />
                <path class="video-progress-played" d="M81 188h81" />
                <circle class="video-play" cx="162" cy="188" r="4" />
              </g>
            </svg>
          </div>
          <div class="option-copy">
            <div class="option-title"><h2>{t.nav.videoMode}</h2></div>
            <p>{t.landing.videoDescription}</p>
          </div>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, aBitOfEarth.path)}>
          <div class="option-preview preview-earth" aria-hidden="true">
            <svg viewBox="80 25 200 190" fill="none">
              <defs><clipPath id="landing-earth-clip"><circle cx="180" cy="120" r="76" /></clipPath></defs>
              <circle class="earth-water" cx="180" cy="120" r="76" />
              <g class="earth-land" clip-path="url(#landing-earth-clip)">
                <path d="m123 56 24-11 19 8 4 15-19 16-3 16-17 8-20-20-10-9Zm34 56 22 5 14 19-11 24-13 24-11-10 2-25-13-18Zm43-63 20 10 22 15 16 21-11 15-15-10-14-14-18 8-12-13 4-20Zm0 58 25-5 16 21-9 30-20 12-13-27-8-15Zm40 63 19-6 13 17-15 12-20-7ZM141 187l38 8 42-7 21 12-47 6-46-4Z" />
              </g>
              <g class="earth-grid">
                <circle cx="180" cy="120" r="76" />
                <ellipse cx="180" cy="120" rx="34" ry="76" />
                <path d="M104 120h152M114 82q66 26 132 0M114 158q66-26 132 0" />
              </g>
              <rect class="earth-share" x="180" y="117" width="27" height="27" />
            </svg>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2 lang="en">{aBitOfEarth.title}</h2>
            </div>
            <p>{t.landing.earthDescription}</p>
          </div>
        </a>
        <a class="landing-option" href={getRelativeLocaleUrl(lang, 'android-app')}>
          <div class="option-preview preview-app" aria-hidden="true">
            <div class="preview-phone">
              <AppScreenshot name="paper" darkName="deepsea" alt="" preview />
            </div>
          </div>
          <div class="option-copy">
            <div class="option-title">
              <h2>{tracker[lang].app}</h2>
            </div>
            <p>{t.hero.tagline}</p>
          </div>
        </a>
      </div>
    </div>
  </main>
</Layout>

<script>
  const brand = document.querySelector<HTMLButtonElement>('[data-brand-toggle]');
  if (brand) {
    const mobile = window.matchMedia('(max-width: 700px)');
    const hover = window.matchMedia('(hover: hover)');
    const usesHover = () => !mobile.matches && hover.matches;
    const expand = (expanded: boolean) => brand.setAttribute('aria-expanded', String(expanded));
    brand.addEventListener('pointerenter', () => { if (usesHover()) expand(true); });
    brand.addEventListener('pointerleave', () => { if (usesHover() && !brand.matches(':focus-visible')) expand(false); });
    brand.addEventListener('focus', () => { if (usesHover() && brand.matches(':focus-visible')) expand(true); });
    brand.addEventListener('blur', () => expand(usesHover() && brand.matches(':hover')));
    brand.addEventListener('click', () => {
      if (!usesHover()) expand(brand.getAttribute('aria-expanded') !== 'true');
    });
    brand.addEventListener('keydown', (event) => { if (event.key === 'Escape') expand(false); });
    mobile.addEventListener('change', () => expand(false));
    hover.addEventListener('change', () => expand(false));
  }
</script>

<style>
  .landing-main {
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: max(7rem, env(safe-area-inset-top, 0px)) clamp(1.25rem, 4vw, 3rem) max(7rem, env(safe-area-inset-bottom, 0px));
    background: radial-gradient(ellipse at center, var(--hero-glow), transparent 50%);
  }
  .landing-content { width: 100%; max-width: 72rem; }
  .landing-brand { container-type: inline-size; margin-bottom: clamp(2rem, 4vw, 3rem); text-align: center; }
  h1 { display: inline-flex; min-width: 0; max-width: 100%; font-size: clamp(2rem, 8.4cqi, 6.5rem); line-height: 1.06; letter-spacing: -.015em; white-space: nowrap; }
  .brand-trigger { display: inline-flex; align-items: center; gap: .22em; border-radius: .1em; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: default; }
  .brand-icon { flex: none; width: .8em; height: .8em; }
  .brand-wordmark, .brand-word { display: inline-flex; }
  /* Center the visible capitals, accounting for the wordmark font's descent. */
  .brand-wordmark { transform: translateY(-.05em); }
  .brand-reveal { display: inline-grid; grid-template-columns: 0fr; opacity: 0; transition: grid-template-columns 550ms cubic-bezier(.22, 1, .36, 1), opacity 350ms ease; }
  .brand-reveal > span { min-width: 0; overflow: hidden; }
  .brand-trigger[aria-expanded="true"] .brand-reveal { grid-template-columns: 1fr; opacity: 1; }
  .landing-options { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .landing-option {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-ink);
    min-width: 0;
    transition: border-color .2s, transform .2s var(--ease-out), box-shadow .2s;
  }
  .landing-option:hover, .landing-option:focus-visible { border-color: var(--color-accent); box-shadow: var(--shadow-card-hover); }
  @media (hover: hover) {
    .landing-option:hover { transform: translateY(-4px); }
  }
  .option-preview { position: relative; aspect-ratio: 3 / 2; overflow: hidden; border-radius: calc(var(--radius-xl) - 1px) calc(var(--radius-xl) - 1px) 0 0; background: color-mix(in srgb, var(--color-paper) 80%, var(--color-surface)); }
  .option-preview > svg { display: block; width: 100%; height: 100%; }
  .preview-chart { background: linear-gradient(145deg, var(--color-accent-soft), var(--color-paper)); }
  .chart-window { fill: var(--color-surface); stroke: var(--color-divider); }
  .chart-grid { stroke: var(--color-divider); }
  .chart-fill { fill: var(--color-accent); fill-opacity: .13; }
  .chart-line { stroke: var(--color-accent); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .preview-app { background: radial-gradient(ellipse at 50% 95%, var(--hero-glow), transparent 70%), var(--color-paper); }
  .preview-phone { position: absolute; top: 12%; left: 50%; width: 52%; max-width: 180px; padding: 4px; border: 1px solid rgb(255 255 255 / .15); border-radius: 24px; background: #1F1B14; box-shadow: 12px 16px 32px var(--phone-shadow); transform: translateX(-50%) rotate(-8deg); }
  .preview-phone :global(img) { display: block; width: 100%; border-radius: 20px; }
  .preview-earth { background: linear-gradient(155deg, var(--color-paper), var(--color-accent-soft)); }
  .earth-water { fill: var(--color-surface); }
  .earth-land { fill: var(--color-ink); fill-opacity: .24; }
  .earth-grid { stroke: var(--color-ink); stroke-opacity: .35; }
  .earth-share { fill: var(--color-accent); fill-opacity: .6; stroke: var(--color-accent); stroke-width: 2; }
  .preview-video { background: linear-gradient(145deg, var(--color-paper), var(--color-accent-soft)); }
  .video-window { fill: #172636; stroke: var(--color-divider); }
  .video-music-note { fill: #ffb047; fill-opacity: .9; }
  .video-landscape { fill: #43727b; }
  .video-foreground { fill: #29464c; }
  .video-preview-price { fill: #fff; font-family: var(--font-sans); font-size: 36px; font-weight: 750; letter-spacing: -2px; }
  .video-controls { fill: #080808; fill-opacity: .6; }
  .video-play { fill: #fff; }
  .video-progress { stroke: #ffffff50; stroke-width: 3; stroke-linecap: round; }
  .video-progress-played { stroke: #ff981e; stroke-width: 3; stroke-linecap: round; }
  .option-copy { padding: 1.5rem; flex: 1; min-width: 0; border-top: 1px solid var(--color-divider); }
  .option-title { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  h2 { font-size: 1.125rem; font-weight: 600; letter-spacing: -.025em; line-height: 1.3; }
  p { margin-top: .75rem; color: var(--color-ink-muted); font-size: .875rem; line-height: 1.65; text-wrap: pretty; }
  @media (min-width: 540px) and (max-width: 1100px) { .landing-options { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 700px) {
    :global(body:has(.landing-main)) {
      --landing-gutter: 1.25rem;
    }
    .landing-main { align-items: start; padding: var(--menu-control-top) var(--landing-gutter) max(2rem, env(safe-area-inset-bottom, 0px)); }
    .landing-brand { display: flex; align-items: center; min-height: var(--menu-control-size); padding-right: calc(var(--menu-control-size) + .75rem); margin-bottom: 1.5rem; text-align: left; }
    h1 { font-size: calc(var(--menu-control-size) * 1.25); transition: font-size 550ms cubic-bezier(.22, 1, .36, 1); }
    h1:has(.brand-trigger[aria-expanded="true"]) { font-size: clamp(1rem, calc((100cqi - var(--menu-control-size)) / 8.5), 3.25rem); }
    .brand-trigger { height: var(--menu-control-size); }
    .brand-icon { width: var(--menu-control-size); height: var(--menu-control-size); }
    .landing-options { gap: 1.25rem; }
    .landing-option { border-radius: 20px; box-shadow: var(--shadow-card); }
    /* Keep the whole illustration visible instead of cropping it into a strip. */
    .option-preview { aspect-ratio: 8 / 5; border-radius: 19px 19px 0 0; }
    .option-copy { padding: 1.25rem; }
    h2 { font-size: 1.1875rem; }
    p { font-size: .9375rem; line-height: 1.6; margin-top: .625rem; }
  }
  @media (max-width: 539px) {
    .landing-options { grid-template-columns: 1fr; }
  }
  @media (max-width: 359px) {
    :global(body:has(.landing-main)) { --landing-gutter: 1rem; }
    .option-copy { padding: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, .brand-reveal { transition: none; }
    .landing-option { transition: none; }
    .landing-option:hover { transform: none; }
  }
</style>
