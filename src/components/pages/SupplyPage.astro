---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import SupplyContainer from '../SupplyContainer.astro';
import SupplyPeople from '../SupplyPeople.astro';
import SupplyWorld from '../SupplyWorld.astro';
import { supply, currencies } from '../../i18n/supply';
import rawSnapshot from '../../features/supply/snapshot.json';
import { BITCOIN_MAX, MAX_PROJECTION_DAYS, DAY_MS, annualRate, annualMiningRate, goldAnchor, goldExpiry, goldShareGrams, projectionAnchor, equalShare, formatDate, formatNumber, interpolate, isValidSnapshot, type SupplySnapshot } from '../../features/supply/model';

const t = supply;
const locale = 'en-US';
const snapshot = rawSnapshot as SupplySnapshot;
if (!isValidSnapshot(snapshot)) throw new Error('Invalid supply snapshot. Verify the official data before building.');
const n = (value: number, digits = 0) => formatNumber(value, locale, digits);
const date = (value: string, monthOnly = false) => formatDate(value, locale, monthOnly);
const bitcoinShare = equalShare(BITCOIN_MAX, snapshot.population.persons);
const gold = snapshot.gold;
const clientCopy = Object.fromEntries(['projected', 'recorded', 'goldProjected', 'goldRecorded', 'goldStale', 'goldUnavailable', 'paused', 'pause', 'resume', 'stale', 'reduced', 'unavailable', 'populationEstimate', 'populationRecorded', 'populationFallback', 'populationUnavailable', 'bitcoinShareBasis'].map((key) => [key, t[key as keyof typeof t]]));
---
<Layout title={`${t.title} — Open Bitcoin Tracker`} description={t.intro}>
  <Nav />
  <main id="main-content" class="supply-page" lang="en" aria-labelledby="supply-page-title" data-supply data-motion="still">
    <h1 id="supply-page-title" class="page-title">{t.title}</h1>

    <div class="bitcoin-controls" data-bitcoin-controls hidden>
      <label class="bitcoin-unit-toggle"><input type="checkbox" data-bitcoin-sats /><span>{t.showBitcoinSats}</span></label>
    </div>
    <div class="asset-comparison">
      <div class="asset-totals">
        <section class="bitcoin-feature" aria-labelledby="bitcoin-heading">
          <div class="bitcoin-supply">
            <h2 id="bitcoin-heading" class="column-heading"><span class="currency-icon btc-icon" aria-hidden="true">₿</span>{t.bitcoin}</h2>
            <p class="total-number btc-total"><span aria-hidden="true">₿</span><span data-btc-total>{n(BITCOIN_MAX)}</span><span class="currency-name" data-btc-total-unit> bitcoins</span></p>
            <p class="value-label">{t.maximum}</p>
          </div>
          <SupplyContainer kind="bitcoin" />
        </section>
        <section class="supply-board" aria-labelledby="asset-picker-name">
          <div class="currency-grid">
            <article class="supply-column gold-column" data-gold data-gold-motion="still">
              <p class="total-number gold-total" aria-live="off"><span data-gold-total>{n(gold.stock.tonnes)}</span> <span class="mass-unit">{t.tonnes}</span></p>
              <p class="value-label" data-gold-label>{t.goldRecorded}</p>
              <SupplyContainer kind="gold" />
            </article>
            {snapshot.fiat.map((money) => {
              const currency = currencies[money.id];
              return <article class="supply-column fiat-column" data-currency={money.id} data-selected={money.id === 'usd' ? 'true' : undefined} data-money-motion="still" data-direction={annualRate(money) < 0 ? 'down' : 'up'}>
                {money.id === 'usd' && <div class="column-heading selected-asset-heading" role="heading" aria-level="2" data-asset-picker hidden aria-label={currency.name}>
                  <span class="currency-icon gold-icon" data-picker-gold hidden aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="m6 7-3 10h18L18 7Z" fill="currentColor" /><path d="M8 9h8" stroke="var(--supply-gold)" stroke-width="2" /></svg></span>
                  <span class="currency-icon fiat-icon" data-picker-symbol aria-hidden="true">{currency.symbol}</span>
                  <span class="control-label" id="asset-picker-label">{t.compareBitcoinWith}</span>
                  <details class="asset-choice" data-asset-menu>
                    <summary class="asset-trigger" id="comparison-asset" data-asset-trigger aria-labelledby="asset-picker-label asset-picker-name" aria-controls="asset-options" aria-expanded="false">
                      <span id="asset-picker-name" data-picker-name>{currency.name}</span>
                      <svg class="asset-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                    </summary>
                    <ul class="asset-options" id="asset-options" role="list" aria-label={t.compareBitcoinWith}>
                      <li><button type="button" class="asset-option" data-asset-option="gold" aria-pressed="false">{t.gold}</button></li>
                      {snapshot.fiat.map((asset) => <li><button type="button" class="asset-option" data-asset-option={asset.id} data-symbol={currencies[asset.id].symbol} aria-pressed={asset.id === 'usd' ? 'true' : 'false'}>{currencies[asset.id].name}</button></li>)}
                    </ul>
                  </details>
                </div>}
                {money.id === 'usd' && <h2 data-static-asset-heading class="column-heading"><span class="currency-icon fiat-icon" aria-hidden="true">{currency.symbol}</span>{currency.name}</h2>}
                <p class="total-number fiat-total" aria-live="off"><span aria-hidden="true">{currency.symbol}</span><span data-money-total>{n(money.latest.amount)}</span><span class="currency-name"> {currency.plural}</span></p>
                <p class="value-label" data-total-label>{interpolate(t.recorded, { aggregate: money.aggregate })}</p>
                <SupplyContainer kind="fiat" symbol={currency.symbol} />
              </article>;
            })}
          </div>
        </section>
      </div>
      <section class="population-heading" aria-labelledby="population-heading">
        <div class="population-readout">
          <h2 id="population-heading" class="column-heading"><span class="currency-icon fiat-icon" aria-hidden="true"><svg width="20" height="20" viewBox="90 13 120 120" fill="none" focusable="false"><clipPath id="supply-population-icon-clip"><circle cx="150" cy="73" r="56" /></clipPath><path clip-path="url(#supply-population-icon-clip)" d="m103 35 18-7 13 6 6 16-10 9-13-2-10 10-14-7Zm23 33 13 4 7 17-8 12-2 22-11-5-9-25-5-10Zm35-44 13 2 5 9 23 7 9 20-18 7-13-10-9 8-18-3-7-12 9-8Zm-1 43 21 5 7 12-11 16-12 9-7-21-9-10Zm31 29 14-2 10 13-9 8-19-5Z" fill="currentColor" /><circle cx="150" cy="73" r="57" stroke="currentColor" stroke-width="6" /></svg></span>{t.populationMethodTitle}</h2>
          <p class="population-band" aria-live="off"><strong data-population>{n(snapshot.population.persons)}</strong></p>
        </div>
        <SupplyWorld />
      </section>
      <div class="share-comparison">
        <section class="share bitcoin-share" data-share-asset="bitcoin" aria-labelledby="bitcoin-share-heading">
          <h3 id="bitcoin-share-heading" class="column-heading share-heading"><SupplyPeople accent />{t.perPersonTitle}<span class="share-asset-name">{t.bitcoin}</span></h3>
          <p class="share-number"><span aria-hidden="true">₿</span><span data-btc-share>{n(bitcoinShare, 8)}</span><span class="currency-name" data-btc-share-unit> bitcoins</span></p>
        </section>
        <div class="share-grid">
          <section class="share gold-share" data-share-asset="gold" aria-labelledby="gold-share-heading">
            <h3 id="gold-share-heading" class="column-heading share-heading"><SupplyPeople />{t.perPersonTitle}<span class="share-asset-name">{t.gold}</span></h3>
            <p class="share-number" aria-live="off"><span data-gold-share>{n(goldShareGrams(gold.stock.tonnes, snapshot.population.persons), 2)}</span> <abbr title="grams" class="mass-unit">{t.grams}</abbr></p>
          </section>
          {snapshot.fiat.map((money) => {
            const currency = currencies[money.id];
            return <section class="share fiat-share" data-share-asset={money.id} data-selected={money.id === 'usd' ? 'true' : undefined} aria-labelledby={`${money.id}-share-heading`}>
              <h3 id={`${money.id}-share-heading`} class="column-heading share-heading"><SupplyPeople />{t.perPersonTitle}<span class="share-asset-name">{currency.name}</span></h3>
              <p class="share-number" aria-live="off"><span aria-hidden="true">{currency.symbol}</span><span data-money-share={money.id}>{n(equalShare(money.latest.amount, snapshot.population.persons))}</span><span class="currency-name"> {currency.plural}</span></p>
            </section>;
          })}
        </div>
      </div>
    </div>
    <section class="method" id="sources">
      <details>
        <summary><span>{t.methodTitle}</span><span class="details-plus" aria-hidden="true">+</span></summary>
        <div class="method-content">
          <h3>{t.bitcoin}</h3>
          <p>{t.bitcoinMethod}</p>
          <div class="source-links"><a href="https://bitcoin.org/en/faq#how-are-bitcoins-created">{t.bitcoinLink} ↗</a></div>

          <h3>{t.gold}</h3>
          <p>{interpolate(t.goldMethod, { stock: n(gold.stock.tonnes), date: date(gold.stock.date), rounding: n(gold.stock.roundedToTonnes) })}</p>
          <p>{interpolate(t.goldMiningMethod, { mining: n(gold.mineProduction.tonnes, 1), year: String(gold.mineProduction.year), miningRelease: date(gold.mineProduction.releasedAt) })}</p>
          <p>{interpolate(t.goldProjectionMethod, { anchor: date(new Date(goldAnchor(gold)).toISOString()), year: String(gold.mineProduction.year), release: date(gold.stock.releasedAt), expiry: date(new Date(goldExpiry(gold)).toISOString()), days: n(MAX_PROJECTION_DAYS) })}</p>
          <p>{t.goldShareMethod}</p>
          <dl class="observation-grid">
            <div><dt>{date(gold.stock.date)} · above-ground stock</dt><dd>{n(gold.stock.tonnes)} tonnes</dd></div>
            <div><dt>{gold.mineProduction.year} mine production</dt><dd>{n(gold.mineProduction.tonnes, 1)} tonnes</dd></div>
            <div><dt>Historical mining average / second</dt><dd>{n(annualMiningRate(gold) * 1_000_000, 2)} grams</dd></div>
            <div><dt>Stock released · checked</dt><dd>{date(gold.stock.releasedAt)} · {date(gold.checkedAt)}</dd></div>
          </dl>
          <p data-gold-status></p>
          <div class="source-links"><a href={gold.stock.source}>{t.goldStockLink} ↗</a><a href={gold.mineProduction.source}>{t.goldMiningLink} ↗</a></div>

          <h3>{t.moneyMethodTitle}</h3>
          <p>{t.moneyMethod}</p><p>{t.projectionNote}</p><p>{t.contractionMethod}</p>
          <p>{interpolate(t.anchorMethod, { days: n(MAX_PROJECTION_DAYS) })}</p>
          <p data-motion-status></p>
          {snapshot.fiat.map((money) => {
            const currency = currencies[money.id];
            const rate = annualRate(money);
            const expires = new Date(projectionAnchor(money.latest.month) + MAX_PROJECTION_DAYS * DAY_MS).toISOString();
            return <div class="currency-method">
              <h4>{currency.name} · {money.aggregate}</h4>
              <p>{currency.definition} {money.adjustment}. {money.basis}. Source units: {money.sourceUnit} of {currency.plural}, multiplied by {n(money.sourceMultiplier)}.</p>
              <dl class="observation-grid">
                <div><dt>{date(money.latest.month, true)}</dt><dd>{currency.symbol}{n(money.latest.amount)}</dd></div>
                <div><dt>{date(money.previousYear.month, true)}</dt><dd>{currency.symbol}{n(money.previousYear.amount)}</dd></div>
                <div><dt>Historical average / second</dt><dd>{rate >= 0 ? '+' : '−'}{currency.symbol}{n(Math.abs(rate), 2)}</dd></div>
                <div><dt>Released · checked</dt><dd>{date(money.releasedAt)} · {date(money.checkedAt)}</dd></div>
                <div><dt>Projection expires after</dt><dd>{date(expires)} · 00:00 UTC</dd></div>
              </dl>
              <p class="series-name">Series: {money.series}</p>
              {money.note && <p>{money.note}</p>}
              <p data-projection-status={money.id}></p>
              <div class="source-links">
                <a href={money.source} aria-label={`${currency.name} release`}>{t.releaseLink} ↗</a><a href={money.dataSource} aria-label={`${currency.name} latest data`}>{t.dataLink} ↗</a>
                {money.previousDataSource !== money.dataSource && <a href={money.previousDataSource} aria-label={`${currency.name} previous-year data`}>{t.previousLink} ↗</a>}
                <a href={money.definitionSource} aria-label={`${currency.name} definition`}>{t.definitionLink} ↗</a>
              </div>
            </div>;
          })}
          <noscript><p>{t.nojs}</p></noscript>

          <h3>{t.populationMethodTitle}</h3>
          <p>{interpolate(t.populationMethod, { points: snapshot.population.points.map((point) => `${date(point.date)}: ${n(point.persons)}`).join('; ') })}</p>
          <p>{interpolate(t.populationInterpolation, { start: date(snapshot.population.points[0].date), end: date(snapshot.population.points.at(-1)!.date) })}</p>
          <p>{t.populationIllustrationMethod}</p>
          <p data-population-status></p>
          <div class="source-links"><a href={snapshot.population.source}>{t.unLink} ↗</a><a href={snapshot.population.download}>{t.downloadLink} ↗</a></div>

          <h3>{t.shareMethodTitle}</h3>
          <p>{t.experimentNote}</p><p>{t.shareMethod}</p>
          <p data-btc-basis>{interpolate(t.bitcoinShareBasis, { population: n(snapshot.population.persons) })}</p>
          <p>{interpolate(t.dateMethod, { date: date(snapshot.population.date) })}</p><p>{t.purchasingPowerMethod}</p>
          <p class="refresh-note">{interpolate(t.refreshMethod, { date: date(snapshot.checkedAt) })}</p>
        </div>
      </details>
    </section>
    <footer class="supply-controls">
      <button type="button" class="motion-control" data-pause hidden>
        <svg class="pause-icon" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 2h3v12H3zm7 0h3v12h-3z" /></svg>
        <svg class="play-icon" width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m4 2 10 6-10 6z" /></svg>
        <span data-pause-label>{t.pause}</span>
      </button>
    </footer>
  </main>
  <script id="supply-data" type="application/json" set:html={JSON.stringify({ snapshot, locale, copy: clientCopy }).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/supply';</script>
</Layout>
<style>
  .supply-page { --supply-fiat: #aecdbb; --supply-fiat-text: #286045; --supply-fiat-ink: #234632; --supply-gold: #dfc36b; --supply-gold-text: #79601d; --supply-gold-ink: #604b16; max-width: 1220px; margin: 0 auto; padding: 3.25rem clamp(1.25rem, 4vw, 3rem) 2rem; }
  :global(html.dark) .supply-page { --supply-fiat: #93bfa8; --supply-fiat-text: #a2ceb5; --supply-fiat-ink: #214431; --supply-gold-text: #dfc36b; }
  .asset-comparison { display: grid; gap: 1.25rem; }
  .asset-totals, .share-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; min-width: 0; }
  .bitcoin-feature { display: flex; flex-direction: column; align-items: stretch; padding: 1rem; background: radial-gradient(ellipse at 50% 50%, var(--hero-glow), transparent 75%), var(--color-surface); border: 1px solid var(--color-divider); border-radius: 24px; }
  .asset-comparison :global(.container-scene) { max-width: 200px; }
  .supply-board { min-width: 0; }
  .population-heading { display: flex; align-items: center; justify-content: center; gap: 1.25rem; text-align: center; padding: 1.25rem; border: 1px solid var(--color-divider); border-radius: 24px; background: var(--color-surface); }
  .population-readout { min-width: 0; }
  .population-readout .column-heading { justify-content: center; margin-bottom: .5rem; }
  .population-band { display: flex; flex-direction: column; align-items: center; gap: .5rem; font-size: .8125rem; color: var(--color-ink-muted); }
  .population-band strong { font-size: 1.6rem; font-weight: 650; line-height: 1.1; font-variant-numeric: tabular-nums; color: var(--color-ink); letter-spacing: -.04em; white-space: nowrap; }
  .bitcoin-controls { display: flex; align-items: flex-end; justify-content: flex-end; flex-wrap: wrap; gap: .75rem 1rem; margin-bottom: 1.25rem; }
  .bitcoin-controls[hidden] { display: none; }
  .asset-choice { position: relative; min-width: 0; max-width: 100%; }
  .asset-trigger { display: inline-flex; align-items: center; justify-content: flex-start; gap: .375rem; min-height: 44px; padding: 0; color: var(--color-ink-muted); font-size: 1rem; font-weight: 650; white-space: nowrap; list-style: none; user-select: none; }
  .asset-trigger::-webkit-details-marker { display: none; }
  .asset-chevron { flex-shrink: 0; opacity: .7; transition: transform .2s ease; }
  .asset-choice[open] .asset-chevron { transform: rotate(180deg); }
  .asset-options { position: absolute; top: calc(100% + .5rem); left: 0; z-index: 60; margin: 0; padding: .375rem; list-style: none; min-width: 11rem; max-height: min(50dvh, 24rem); overflow-y: auto; background: var(--menu-dropdown-bg, var(--color-surface)); border: 1px solid var(--menu-dropdown-border, var(--color-divider)); border-radius: var(--radius-md); box-shadow: var(--menu-dropdown-shadow, var(--shadow-card-hover)); }
  .asset-option { display: block; width: 100%; padding: .5rem .75rem; border: 0; border-radius: .5rem; background: transparent; color: var(--menu-link-ink, var(--color-ink-muted)); font-size: 14px; font-weight: 400; text-align: left; white-space: nowrap; cursor: pointer; transition: background-color .15s ease, color .15s ease; }
  .asset-option:hover, .asset-option[aria-pressed='true'] { color: var(--menu-primary-ink, var(--color-ink)); background: var(--menu-option-hover, var(--hover-tint)); }
  .asset-option[aria-pressed='true'] { font-weight: 600; }
  .asset-option:focus-visible { outline-offset: -2px; }
  @media (prefers-reduced-motion: reduce) { .asset-chevron, .asset-option { transition: none; } }
  .selected-asset-heading .currency-icon { flex-shrink: 0; }
  [data-static-asset-heading][hidden], .selected-asset-heading[hidden], [data-picker-gold][hidden], [data-picker-symbol][hidden] { display: none; }
  .bitcoin-unit-toggle { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; padding: .5rem .75rem; border: 1px solid var(--color-divider); border-radius: 10px; background: var(--color-surface); font-size: .8125rem; cursor: pointer; }
  .bitcoin-unit-toggle input { width: 16px; height: 16px; accent-color: var(--color-accent); cursor: pointer; }
  .currency-grid, .share-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .currency-grid { height: 100%; }
  .supply-column:not([data-selected='true']), .share-grid > .share:not([data-selected='true']) { display: none; }
  .supply-column { display: flex; flex-direction: column; min-width: 0; padding: 1rem; border: 1px solid var(--color-divider); border-radius: 24px; }
  .gold-column { --supply-fiat-text: var(--supply-gold-text); background: radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--supply-gold) 15%, transparent), transparent 65%), var(--color-surface); }
  .fiat-column { background: radial-gradient(ellipse at 50% 45%, color-mix(in srgb, var(--supply-fiat) 12%, transparent), transparent 65%), var(--color-surface); }
  .column-heading { display: flex; align-items: center; gap: .625rem; color: var(--color-ink-muted); font-size: 1rem; font-weight: 650; margin-bottom: .75rem; }
  .bitcoin-feature .column-heading, .supply-board .column-heading, .share-heading { min-height: 44px; }
  .currency-icon { width: 28px; height: 28px; display: inline-grid; place-items: center; border-radius: 50%; font-size: 19px; font-weight: 600; }
  .btc-icon { background: var(--color-accent); color: #1F1B14; }
  .fiat-icon { background: var(--supply-fiat); color: var(--supply-fiat-ink); }
  .gold-icon { background: var(--supply-gold); color: var(--supply-gold-ink); }
  .value-label { font-size: .75rem; color: var(--color-ink-muted); font-weight: 550; }
  .total-number { color: var(--color-ink); font-size: clamp(1.25rem, 2.2vw, 1.6rem); font-variant-numeric: tabular-nums; letter-spacing: -.04em; line-height: 1.5; margin-top: .25rem; font-weight: 600; min-height: 2.5rem; white-space: nowrap; }
  .btc-total { font-size: 1.8rem; }
  .fiat-total { padding-top: .35rem; }
  .gold-share { --supply-fiat-text: var(--supply-gold-text); }
  .gold-total { padding-top: .35rem; }
  .mass-unit { font-size: .75em; letter-spacing: 0; text-decoration: none; }
  .bitcoin-unit { font-size: .75em; letter-spacing: 0; }
  .page-title, .currency-name, .control-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .share { min-width: 0; padding: 1rem; border: 1px solid var(--color-divider); border-radius: 24px; background: var(--color-surface); text-align: left; }
  .share-asset-name { margin-left: auto; font-size: .75rem; font-weight: 550; }
  .share-number { color: var(--color-ink); font-size: clamp(1.1rem, 2.3vw, 1.5rem); font-weight: 600; letter-spacing: -.045em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .supply-controls { display: flex; justify-content: center; margin-top: 1.25rem; }
  .motion-control { display: inline-flex; flex-shrink: 0; align-items: center; gap: .375rem; min-height: 44px; padding: .375rem .75rem; border: 1px solid var(--color-divider); border-radius: 8px; cursor: pointer; background: var(--color-surface); font-size: .75rem; }
  .motion-control .play-icon { display: none; }
  .motion-control[aria-pressed="true"] .pause-icon { display: none; }
  .motion-control[aria-pressed="true"] .play-icon { display: block; }
  .motion-control[hidden] { display: none; }
  .motion-control:hover { border-color: var(--color-ink-muted); }
  .method { margin-top: 1rem; border-bottom: 1px solid var(--color-divider); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem .125rem; cursor: pointer; list-style: none; font-size: .875rem; color: var(--color-ink-muted); }
  summary::-webkit-details-marker { display: none; }
  .details-plus { font-size: 1.25rem; }
  details[open] .details-plus { transform: rotate(45deg); }
  .method-content { max-width: 850px; padding: .5rem 0 1.75rem; font-size: .8125rem; line-height: 1.8; color: var(--color-ink-muted); }
  .method-content h3 { color: var(--color-ink); font-weight: 600; font-size: .9375rem; margin-bottom: .75rem; }
  .method-content h3:not(:first-child) { margin-top: 2rem; }
  .method-content p + p { margin-top: .75rem; }
  .currency-method { border-top: 1px solid var(--color-divider); padding-top: 1rem; margin-top: 1.25rem; }
  .currency-method h4 { font-weight: 600; color: var(--color-ink); margin-bottom: .5rem; }
  .observation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem 1rem; margin-block: .75rem; }
  dt { font-size: .6875rem; }
  dd { color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .series-name { overflow-wrap: anywhere; font-size: .6875rem; }
  [data-population-status]:empty, [data-projection-status]:empty, [data-motion-status]:empty, [data-gold-status]:empty { display: none; }
