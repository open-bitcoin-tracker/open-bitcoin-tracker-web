---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import SupplyContainer from '../SupplyContainer.astro';
import SupplyPeople from '../SupplyPeople.astro';
import { supply, currencies } from '../../i18n/supply';
import rawSnapshot from '../../features/supply/snapshot.json';
import { BITCOIN_MAX, SATOSHIS_PER_BTC, MAX_PROJECTION_DAYS, DAY_MS, annualRate, projectionAnchor, equalShare, formatDate, formatNumber, interpolate, isValidSnapshot, type SupplySnapshot } from '../../features/supply/model';

const t = supply;
const locale = 'en-US';
const snapshot = rawSnapshot as SupplySnapshot;
if (!isValidSnapshot(snapshot)) throw new Error('Invalid supply snapshot. Verify the official data before building.');
const n = (value: number, digits = 0) => formatNumber(value, locale, digits);
const date = (value: string, monthOnly = false) => formatDate(value, locale, monthOnly);
const bitcoinShare = equalShare(BITCOIN_MAX, snapshot.population.persons);
const clientCopy = Object.fromEntries(['projected', 'recorded', 'paused', 'pause', 'resume', 'stale', 'reduced', 'unavailable', 'populationFallback', 'populationUnavailable', 'bitcoinShareBasis', 'todayNote', 'scenarioNote', 'scenarioUnavailable', 'scenarioProjected', 'bitcoinScenarioBasis'].map((key) => [key, t[key as keyof typeof t]]));
---
<Layout title={`${t.title} — Open Bitcoin Tracker`} description={t.intro}>
  <Nav />
  <main id="main-content" class="supply-page" lang="en" aria-labelledby="supply-page-title" data-supply data-motion="still">
    <h1 id="supply-page-title" class="page-title">{t.title}</h1>

    <div class="year-controls" data-year-controls hidden role="group" aria-label={t.yearControls}>
      <button type="button" data-year-previous disabled><svg class="year-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg><span class="year-label">{t.previousYear}</span></button>
      <output class="selected-year" data-selected-year aria-live="polite" aria-atomic="true"></output>
      <button type="button" data-year-next><span class="year-label">{t.nextYear}</span><svg class="year-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></button>
    </div>
    <div class="asset-comparison">
      <section class="population-heading" aria-labelledby="population-heading">
        <div class="population-readout">
          <h2 id="population-heading" class="column-heading"><span class="currency-icon population-icon" aria-hidden="true"><svg width="20" height="20" viewBox="90 13 120 120" fill="none" focusable="false"><clipPath id="supply-population-icon-clip"><circle cx="150" cy="73" r="56" /></clipPath><path clip-path="url(#supply-population-icon-clip)" d="m103 35 18-7 13 6 6 16-10 9-13-2-10 10-14-7Zm23 33 13 4 7 17-8 12-2 22-11-5-9-25-5-10Zm35-44 13 2 5 9 23 7 9 20-18 7-13-10-9 8-18-3-7-12 9-8Zm-1 43 21 5 7 12-11 16-12 9-7-21-9-10Zm31 29 14-2 10 13-9 8-19-5Z" fill="currentColor" /><circle cx="150" cy="73" r="57" stroke="currentColor" stroke-width="6" /></svg></span>{t.populationMethodTitle}</h2>
          <p class="population-band" aria-live="off"><strong data-population>{n(snapshot.population.persons)}</strong></p>
        </div>
      </section>
      <div class="asset-totals">
        <section class="bitcoin-feature" aria-labelledby="bitcoin-heading">
          <div class="bitcoin-supply">
            <h2 id="bitcoin-heading" class="column-heading"><span class="currency-icon btc-icon" aria-hidden="true">₿</span>{t.bitcoin}</h2>
            <p class="total-number btc-total"><span class="bitcoin-amount"><span aria-hidden="true">₿</span><span data-btc-total>{n(BITCOIN_MAX * SATOSHIS_PER_BTC)}</span></span><span class="bitcoin-unit"> sats</span></p>
            <p class="value-label">{t.maximum}</p>
          </div>
          <SupplyContainer kind="bitcoin" />
        </section>
        <section class="supply-board" aria-labelledby="asset-picker-name">
          <div class="currency-grid">
            {snapshot.fiat.map((money) => {
              const currency = currencies[money.id];
              return <article class="supply-column fiat-column" data-currency={money.id} data-selected={money.id === 'usd' ? 'true' : undefined} data-money-motion="still" data-direction={annualRate(money) < 0 ? 'down' : 'up'}>
                {money.id === 'usd' && <div class="column-heading selected-asset-heading" role="heading" aria-level="2" data-asset-picker hidden aria-label={currency.name}>
                  <span class="currency-icon fiat-icon" data-picker-symbol aria-hidden="true">{currency.symbol}</span>
                  <span class="control-label" id="asset-picker-label">{t.compareBitcoinWith}</span>
                  <details class="asset-choice" data-asset-menu>
                    <summary class="asset-trigger" id="comparison-asset" data-asset-trigger aria-labelledby="asset-picker-label asset-picker-name" aria-controls="asset-options" aria-expanded="false">
                      <span id="asset-picker-name" data-picker-name>{currency.name}</span>
                      <svg class="asset-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
                    </summary>
                    <ul class="asset-options" id="asset-options" role="list" aria-label={t.compareBitcoinWith}>
                      {snapshot.fiat.map((asset) => <li><button type="button" class="asset-option" data-asset-option={asset.id} data-symbol={currencies[asset.id].symbol} aria-pressed={asset.id === 'usd' ? 'true' : 'false'}>{currencies[asset.id].name}</button></li>)}
                    </ul>
                  </details>
                </div>}
                {money.id === 'usd' && <h2 data-static-asset-heading class="column-heading"><span class="currency-icon fiat-icon" aria-hidden="true">{currency.symbol}</span>{currency.name}</h2>}
                <p class="total-number fiat-total" aria-live="off"><span aria-hidden="true">{currency.symbol}</span><span data-money-total>{n(money.latest.amount)}</span><span class="currency-name"> {currency.plural}</span></p>
                <p class="value-label">{t.fiatSupplyCap}</p>
                <SupplyContainer kind="fiat" symbol={currency.symbol} assetId={money.id} />
              </article>;
            })}
          </div>
        </section>
      </div>
      <div class="share-comparison">
        <section class="share bitcoin-share" data-share-asset="bitcoin" aria-labelledby="bitcoin-share-heading">
          <h3 id="bitcoin-share-heading" class="column-heading share-heading"><SupplyPeople accent />{interpolate(t.perPersonTitle, { asset: t.bitcoin })}</h3>
          <p class="share-number"><span aria-hidden="true">₿</span><span data-btc-share>{n(bitcoinShare * SATOSHIS_PER_BTC)}</span><span class="bitcoin-unit"> sats</span></p>
        </section>
        <div class="share-grid">
          {snapshot.fiat.map((money) => {
            const currency = currencies[money.id];
            return <section class="share fiat-share" data-share-asset={money.id} data-selected={money.id === 'usd' ? 'true' : undefined} aria-labelledby={`${money.id}-share-heading`}>
              <h3 id={`${money.id}-share-heading`} class="column-heading share-heading"><SupplyPeople />{interpolate(t.perPersonTitle, { asset: currency.name })}</h3>
              <p class="share-number" aria-live="off"><span aria-hidden="true">{currency.symbol}</span><span data-money-share={money.id}>{n(equalShare(money.latest.amount, snapshot.population.persons))}</span><span class="currency-name"> {currency.plural}</span></p>
            </section>;
          })}
        </div>
      </div>
    </div>
    <section class="method" id="sources">
      <details>
        <summary><span>{t.methodTitle}</span><span class="details-plus" aria-hidden="true">+</span></summary>
        <div class="method-content">
          <p data-scenario-note></p>
          <h3>{t.bitcoin}</h3>
          <p>{t.bitcoinMethod}</p>
          <div class="source-links"><a href="https://bitcoin.org/en/faq#how-are-bitcoins-created">{t.bitcoinLink} ↗</a></div>

          <h3>{t.moneyMethodTitle}</h3>
          <p>{t.moneyMethod}</p><p>{t.projectionNote}</p><p>{t.contractionMethod}</p>
          <p>{interpolate(t.anchorMethod, { days: n(MAX_PROJECTION_DAYS) })}</p>
          <p data-motion-status></p>
          {snapshot.fiat.map((money) => {
            const currency = currencies[money.id];
            const rate = annualRate(money);
            const expires = new Date(projectionAnchor(money.latest.month) + MAX_PROJECTION_DAYS * DAY_MS).toISOString();
            return <div class="currency-method">
              <h4>{currency.name} · {money.aggregate}</h4>
              <p data-total-label={money.id}>{interpolate(t.recorded, { aggregate: money.aggregate })}</p>
              <p>{currency.definition} {money.adjustment}. {money.basis}. Source units: {money.sourceUnit} of {currency.plural}, multiplied by {n(money.sourceMultiplier)}.</p>
              <dl class="observation-grid">
                <div><dt>{date(money.latest.month, true)}</dt><dd>{currency.symbol}{n(money.latest.amount)}</dd></div>
                <div><dt>{date(money.previousYear.month, true)}</dt><dd>{currency.symbol}{n(money.previousYear.amount)}</dd></div>
                <div><dt>Historical average / second</dt><dd>{rate >= 0 ? '+' : '−'}{currency.symbol}{n(Math.abs(rate), 2)}</dd></div>
                <div><dt>Released · checked</dt><dd>{date(money.releasedAt)} · {date(money.checkedAt)}</dd></div>
                <div><dt>Projection expires after</dt><dd>{date(expires)} · 00:00 UTC</dd></div>
              </dl>
              <p class="series-name">Series: {money.series}</p>
              {money.note && <p>{money.note}</p>}
              <p data-projection-status={money.id}></p>
              <div class="source-links">
                <a href={money.source} aria-label={`${currency.name} release`}>{t.releaseLink} ↗</a><a href={money.dataSource} aria-label={`${currency.name} latest data`}>{t.dataLink} ↗</a>
                {money.previousDataSource !== money.dataSource && <a href={money.previousDataSource} aria-label={`${currency.name} previous-year data`}>{t.previousLink} ↗</a>}
                <a href={money.definitionSource} aria-label={`${currency.name} definition`}>{t.definitionLink} ↗</a>
              </div>
            </div>;
          })}
          <noscript><p>{t.nojs}</p></noscript>

          <h3>{t.scenarioMethodTitle}</h3>
          <p>{t.scenarioMethod}</p>
          <p>{interpolate(t.scenarioPopulationMethod, { start: date(snapshot.population.scenarioPoints[0].date), end: date(snapshot.population.scenarioPoints.at(-1)!.date), checked: date(snapshot.population.checkedAt) })}</p>

          <h3>{t.populationMethodTitle}</h3>
          <p>{interpolate(t.populationMethod, { points: snapshot.population.points.map((point) => `${date(point.date)}: ${n(point.persons)}`).join('; ') })}</p>
          <p>{interpolate(t.populationInterpolation, { start: date(snapshot.population.points[0].date), end: date(snapshot.population.points.at(-1)!.date) })}</p>
          <p data-population-status></p>
          <div class="source-links"><a href={snapshot.population.source}>{t.unLink} ↗</a><a href={snapshot.population.download}>{t.downloadLink} ↗</a></div>

          <h3>{t.shareMethodTitle}</h3>
          <p>{t.experimentNote}</p><p>{t.shareMethod}</p>
          <p data-btc-basis>{interpolate(t.bitcoinShareBasis, { population: n(snapshot.population.persons) })}</p>
          <p>{interpolate(t.dateMethod, { date: date(snapshot.population.date) })}</p><p>{t.purchasingPowerMethod}</p>
          <p class="refresh-note">{interpolate(t.refreshMethod, { date: date(snapshot.checkedAt) })}</p>
        </div>
      </details>
    </section>
  </main>
  <script id="supply-data" type="application/json" set:html={JSON.stringify({ snapshot: { checkedAt: snapshot.checkedAt, population: snapshot.population, fiat: snapshot.fiat }, locale, copy: clientCopy }).replace(/</g, '\\u003c')} />
  <script>import '../../scripts/supply';</script>
</Layout>
<style>
  .supply-page {
    --supply-fiat: #aecdbb;
    --supply-fiat-text: #286045;
    --supply-fiat-ink: #234632;
    --supply-population: #b1cdec;
    --supply-population-ink: #27527f;
    --supply-population-land: #6d99c8;
    --supply-population-text: #2f6398;
    --supply-gap: 1.25rem;
    --supply-padding: 1.25rem;
    --supply-radius: 24px;
    --supply-heading-size: 1rem;
    --supply-icon-size: 32px;
    --supply-total-size: clamp(1.25rem, 2.2vw, 1.6rem);
    --supply-share-size: clamp(1.1rem, 2.3vw, 1.5rem);
    --supply-label-size: .8125rem;
    --supply-control-size: .875rem;
    --supply-scene-width: 240px;
    --supply-page-padding-block: 2rem;
    width: 100%;
    max-width: 3840px;
    min-height: 100dvh;
    margin: 0 auto;
    padding: var(--supply-page-padding-block) clamp(1.25rem, 3vw, 7.5rem);
    /* Share the top row with the menu; the cards begin below both controls. */
    padding-top: max(var(--supply-page-padding-block), var(--menu-control-top));
  }
  .supply-page:has(> .year-controls[hidden]) { padding-top: max(var(--supply-page-padding-block), calc(var(--menu-control-top) + var(--menu-control-size) + 1rem)); }
  :global(html.dark) .supply-page { --supply-fiat: #93bfa8; --supply-fiat-text: #a2ceb5; --supply-fiat-ink: #214431; --supply-population: #8db8e8; --supply-population-ink: #183e69; --supply-population-land: #82aee1; --supply-population-text: #a5caf2; }
  .asset-comparison { display: grid; gap: var(--supply-gap); }
  .asset-totals, .share-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--supply-gap); min-width: 0; }
  .bitcoin-feature { display: flex; flex-direction: column; align-items: stretch; padding: var(--supply-padding); background: radial-gradient(ellipse at 50% 65%, var(--hero-glow), transparent 75%), var(--color-surface); border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-divider)); border-radius: var(--supply-radius); }
  .asset-comparison :global(.container-scene) { width: min(100%, var(--supply-scene-width)); max-width: none; margin-block: auto 0; }
  .supply-board { min-width: 0; }
  .population-heading { display: flex; align-items: center; justify-content: center; text-align: center; padding: var(--supply-padding); border: 1px solid transparent; }
  .population-readout { min-width: 0; }
  .population-readout .column-heading { justify-content: center; margin-bottom: .5rem; }
  .population-band { display: flex; flex-direction: column; align-items: center; gap: .5rem; font-size: .8125rem; color: var(--color-ink-muted); }
  .population-band strong { font-size: var(--supply-total-size); font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; color: var(--color-ink); letter-spacing: -.045em; white-space: nowrap; }
  .year-controls { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: clamp(.5rem, 1.25vw, 2rem); min-height: var(--menu-control-size); width: min(36rem, calc(100% - var(--menu-control-size) - 1rem)); margin: 0 auto var(--supply-gap); }
  .year-controls[hidden] { display: none; }
  .year-controls button { display: grid; place-items: center; width: 44px; max-width: 100%; min-height: 44px; padding: .5rem; border: 1px solid var(--color-divider); border-radius: .8em; background: var(--color-surface); font-size: var(--supply-control-size); cursor: pointer; }
  .year-controls button:first-child { justify-self: end; }
  .year-controls button:last-child { justify-self: start; }
  .year-arrow { display: block; }
  .year-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .year-controls button:disabled { opacity: .45; cursor: default; }
  .year-controls button:hover:not(:disabled) { border-color: var(--color-ink-muted); }
  .selected-year { min-width: 4rem; text-align: center; font-size: clamp(2rem, min(3.5vw, 5dvh), 4rem); line-height: 1.1; font-weight: 650; font-variant-numeric: tabular-nums; }
  .asset-choice { position: relative; min-width: 0; max-width: 100%; }
  .asset-trigger { display: inline-flex; align-items: center; justify-content: flex-start; gap: .5em; min-height: 44px; padding: 0; color: var(--color-ink-muted); font-size: var(--supply-heading-size); font-weight: 650; white-space: nowrap; list-style: none; user-select: none; }
  .asset-trigger::-webkit-details-marker { display: none; }
  .asset-chevron { width: .75em; height: .75em; flex-shrink: 0; opacity: .7; transition: transform .2s ease; }
  .asset-choice[open] .asset-chevron { transform: rotate(180deg); }
  .asset-options { position: absolute; top: calc(100% + .5rem); left: 0; z-index: 60; margin: 0; padding: .375rem; list-style: none; min-width: 11rem; max-height: min(50dvh, 24rem); overflow-y: auto; background: var(--menu-dropdown-bg, var(--color-surface)); border: 1px solid var(--menu-dropdown-border, var(--color-divider)); border-radius: var(--radius-md); box-shadow: var(--menu-dropdown-shadow, var(--shadow-card-hover)); }
  .asset-option { display: block; width: 100%; min-height: 44px; padding: .6em .85em; border: 0; border-radius: .5rem; background: transparent; color: var(--menu-link-ink, var(--color-ink-muted)); font-size: var(--supply-control-size); font-weight: 400; text-align: left; white-space: nowrap; cursor: pointer; transition: background-color .15s ease, color .15s ease; }
  .asset-option:hover, .asset-option[aria-pressed='true'] { color: var(--menu-primary-ink, var(--color-ink)); background: var(--menu-option-hover, var(--hover-tint)); }
  .asset-option[aria-pressed='true'] { font-weight: 600; }
  .asset-option:focus-visible { outline-offset: -2px; }
  @media (prefers-reduced-motion: reduce) { .asset-chevron, .asset-option { transition: none; } }
  .selected-asset-heading .currency-icon { flex-shrink: 0; }
  [data-static-asset-heading][hidden], .selected-asset-heading[hidden] { display: none; }
  .currency-grid, .share-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .currency-grid { height: 100%; }
  .supply-column:not([data-selected='true']), .share-grid > .share:not([data-selected='true']) { display: none; }
  .supply-column { display: flex; flex-direction: column; min-width: 0; padding: var(--supply-padding); border: 1px solid color-mix(in srgb, var(--supply-fiat-text) 24%, var(--color-divider)); border-radius: var(--supply-radius); }
  .fiat-column { background: radial-gradient(ellipse at 50% 65%, color-mix(in srgb, var(--supply-fiat) 18%, transparent), transparent 75%), var(--color-surface); }
  .column-heading { display: flex; align-items: center; gap: .6em; color: var(--color-ink-muted); font-size: var(--supply-heading-size); font-weight: 650; margin-bottom: .35rem; }
  .bitcoin-feature .column-heading, .supply-board .column-heading, .share-heading { min-height: 44px; }
  .currency-icon { width: var(--supply-icon-size); height: var(--supply-icon-size); flex-shrink: 0; display: inline-grid; place-items: center; border-radius: 50%; font-size: calc(var(--supply-icon-size) * .68); font-weight: 600; }
  .population-icon svg { width: 72%; height: 72%; }
  .btc-icon { background: var(--color-accent); color: #1F1B14; }
  .fiat-icon { background: var(--supply-fiat); color: var(--supply-fiat-ink); }
  .population-icon { background: var(--supply-population); color: var(--supply-population-ink); }
  .value-label { font-size: var(--supply-label-size); color: var(--color-ink-muted); font-weight: 550; margin-top: .3em; }
  .total-number { color: var(--color-ink); font-size: var(--supply-total-size); font-variant-numeric: tabular-nums; letter-spacing: -.045em; line-height: 1.2; margin-top: .1em; font-weight: 600; min-height: 2.5rem; white-space: nowrap; }
  .btc-total { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: .25em; white-space: normal; }
  .bitcoin-amount { white-space: nowrap; }
  .bitcoin-unit { font-size: .75em; letter-spacing: 0; }
  .page-title, .currency-name, .control-label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .share { min-width: 0; padding: var(--supply-padding); border: 1px solid var(--color-divider); border-radius: var(--supply-radius); background: var(--color-surface); text-align: left; }
  .share-heading :global(.people-illustration) { width: var(--supply-icon-size); height: var(--supply-icon-size); }
  .share-number { color: var(--color-ink); font-size: var(--supply-share-size); font-weight: 600; letter-spacing: -.045em; line-height: 1.2; margin-top: .2em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .method { width: 100%; max-width: 90rem; margin: var(--supply-gap) auto 0; border-bottom: 1px solid var(--color-divider); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem .125rem; cursor: pointer; list-style: none; font-size: .875rem; color: var(--color-ink-muted); }
  summary::-webkit-details-marker { display: none; }
  .details-plus { font-size: 1.25rem; }
  .method summary { padding-block: .75em; font-size: var(--supply-control-size); }
  details[open] .details-plus { transform: rotate(45deg); }
  .method-content { max-width: 76ch; margin-inline: auto; padding: .5rem 0 1.75rem; font-size: clamp(.875rem, .9vw, 1.25rem); line-height: 1.8; color: var(--color-ink-muted); }
  .method-content h3 { color: var(--color-ink); font-weight: 600; font-size: 1.1em; margin-bottom: .75rem; }
  .method-content h3:not(:first-child) { margin-top: 2rem; }
  .method-content p + p { margin-top: .75rem; }
  .currency-method { border-top: 1px solid var(--color-divider); padding-top: 1rem; margin-top: 1.25rem; }
  .currency-method h4 { font-weight: 600; color: var(--color-ink); margin-bottom: .5rem; }
  .observation-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem 1rem; margin-block: .75rem; }
  dt { font-size: .85em; }
  dd { color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .series-name { overflow-wrap: anywhere; font-size: .85em; }
  [data-population-status]:empty, [data-projection-status]:empty, [data-motion-status]:empty, [data-scenario-note]:empty { display: none; }
  .source-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-top: .75rem; }
  .source-links a { color: var(--color-emphasis-ink); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: .25rem; padding-block: .25rem; }
  .refresh-note { margin-top: 2rem; border-top: 1px solid var(--color-divider); padding-top: 1rem; }
  a:focus-visible, summary:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (min-width: 1000px) {
    /* Height limits keep wide, short displays and scaled 4K screens comfortable. */
    .supply-page {
      --supply-gap: clamp(.75rem, min(1.25vw, 1.6dvh), 2.5rem);
      --supply-padding: clamp(1.25rem, min(2vw, 2.2dvh), 3rem);
