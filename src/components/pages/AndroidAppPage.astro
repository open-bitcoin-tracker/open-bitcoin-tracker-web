---
// Android app page, shared by the English and localized routes. All copy comes
// from the child components via Astro.currentLocale, so no props are needed.
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import Hero from '../Hero.astro';
import Prices from '../Prices.astro';
import Privacy from '../Privacy.astro';
import KeepAndroidOpen from '../KeepAndroidOpen.astro';
import Footer from '../Footer.astro';
import '../../styles/android-app.css';
---

<Layout page="home">
  <Nav />
  <main id="main-content" class="android-app-page">
    <Hero />
    <Prices />
    <Privacy />
    <KeepAndroidOpen />
  </main>
  <Footer showAppAbout />
</Layout>

<script>
  import '../../scripts/motion';
</script>

<style>
  :global(body:has(.android-app-page)) {
    --android-title-size: clamp(4rem, 6.5vw, 6.5rem);
    --android-header-top: max(clamp(4rem, 6vw, 6rem), env(safe-area-inset-top, 0px));
  }
  @media (min-width: 1200px) {
    :global(body:has(.android-app-page)) { --android-title-size: clamp(7rem, 9vw, 9rem); }
  }
  @media (max-width: 767px) {
    :global(body:has(.android-app-page)) {
      --android-title-size: clamp(2.75rem, 14vw, 4.5rem);
      --android-header-top: var(--menu-control-top);
    }
  }
</style>
