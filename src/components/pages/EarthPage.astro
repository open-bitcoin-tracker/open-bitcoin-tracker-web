---
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import EarthApp from '../../features/earth/App';
import { earth } from '../../i18n/earth';
import { resolveLang, useTranslations } from '../../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);
const copy = earth[lang];
---

<Layout title="A Bit of Earth" description={t.landing.earthDescription} noReferrer>
  <Nav />
  <main id="main-content" class="earth-page">
    <EarthApp client:only="react" lang={lang} copy={copy}>
      <div slot="fallback" class="earth-fallback">
        <noscript>{copy.noScript}</noscript>
      </div>
    </EarthApp>
  </main>
</Layout>

<style>
  :global(html:has(.earth-page)) { overflow: hidden; scrollbar-gutter: auto; }
  .earth-page { position: fixed; inset: 0; }
  .earth-fallback { display: grid; place-content: center; height: 100dvh; padding: 2rem; text-align: center; }
</style>
