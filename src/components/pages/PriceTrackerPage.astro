---
import Layout from '../../layouts/Layout.astro';
import BitcoinChart from '../BitcoinChart.astro';
import Nav from '../Nav.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';
import { tracker } from '../../i18n/tracker';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const pageTitle = `${useTranslations(Astro.currentLocale).landing.priceTracker} — Open Bitcoin Tracker`;
---

<Layout title={pageTitle} description={t.description}>
  <div class="tracker-page">
    <Nav />
    <main id="main-content" class="tracker-main">
      <BitcoinChart />
    </main>
  </div>
</Layout>

<style>
  .tracker-page { display: flex; flex-direction: column; min-height: 100dvh; }
  .tracker-main { display: flex; flex-direction: column; flex: 1; }
  @media (max-width: 700px) {
    /* The dialog is moved into body; keep its close control at the same point. */
    :global(body:has(.tracker-page)) {
      --menu-control-top: max(env(safe-area-inset-top, 0px), calc(var(--live-price-top) + var(--tracker-price-height, var(--live-price-font-size)) / 2 - var(--menu-control-size) / 2));
    }
    :global(body:has(.tracker-page) .nav-menu-settings) { padding-right: 3.5rem; }
  }
</style>
