---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import Nav from '../Nav.astro';
import ProjectFooter from '../ProjectFooter.astro';
import LinkedText from '../LinkedText.astro';
import { resolveLang, useTranslations } from '../../i18n/utils';

const websiteRepo = 'https://github.com/open-bitcoin-tracker/open-bitcoin-tracker-web';
const appRepo = 'https://github.com/Max-Hodler/open-bitcoin-tracker';
const t = useTranslations(Astro.currentLocale);
const copy = t.projectAbout;
const earthHref = getRelativeLocaleUrl(resolveLang(Astro.currentLocale), 'a-bit-of-earth');
const appAboutHref = getRelativeLocaleUrl(resolveLang(Astro.currentLocale), 'android-app/about');
const links = {
  website: { label: copy.website, href: websiteRepo },
  app: { label: copy.app, href: appRepo },
  websiteIssues: { label: copy.websiteIssues, href: `${websiteRepo}/issues` },
  appIssues: { label: copy.appIssues, href: `${appRepo}/issues` },
  websiteLicense: { label: copy.website, href: `${websiteRepo}/blob/main/LICENSE` },
  appLicense: { label: copy.app, href: `${appRepo}/blob/main/LICENSE` },
};
---

<Layout page="about">
  <Nav />
  <main id="main-content" class="document-page">
    <header class="document-container document-header">
      <h1 class="document-title">{copy.h1}</h1>
    </header>

    <div class="document-container about-content">
      <section aria-labelledby="creator-heading" class="about-prose">
        <h2 id="creator-heading">{t.about.profileHeader}</h2>
        <div class="about-creator">
          <img class="about-profile-avatar" src="/avatar.jpg" alt="" width="64" height="64" loading="lazy" />
          <div class="about-profile-links">
            <a href="https://x.com/MaxHodler" target="_blank" rel="noopener noreferrer" aria-label={t.about.followAria}>X</a>
            <a href="https://primal.net/p/nprofile1qqstl0zduk7yrhpcg08mltjhpdmjfghr2lmkeu6qdtve27vrn72fwvqxhwm2z" target="_blank" rel="noopener noreferrer" aria-label={t.about.primalAria}>Nostr</a>
          </div>
        </div>
      </section>

      <section aria-labelledby="contribute-heading" class="about-prose">
        <h2 id="contribute-heading">{copy.contributeHeading}</h2>
        <p>{copy.contributeIntro} <LinkedText text={copy.repositories} links={links} /> <LinkedText text={copy.issues} links={links} /></p>
        <p><LinkedText text={copy.license} links={links} /> {copy.credits}</p>
      </section>
      <section aria-labelledby="data-heading" class="about-prose">
        <h2 id="data-heading">{copy.dataHeading}</h2>
        <ul class="about-sources">
          <li><strong>{copy.livePrices}:</strong> <a href="https://www.kraken.com" target="_blank" rel="noopener noreferrer">Kraken</a></li>
          <li><strong>{copy.history}:</strong> <a href="https://coinmetrics.io" target="_blank" rel="noopener noreferrer">Coin Metrics</a> / <a href="https://www.kraken.com" target="_blank" rel="noopener noreferrer">Kraken</a></li>
          <li><strong>{copy.fx}:</strong> <a href="https://www.ecb.europa.eu/stats/policy_and_exchange_rates/euro_reference_exchange_rates/html/index.en.html" target="_blank" rel="noopener noreferrer">{copy.ecb}</a> (<a href="https://www.frankfurter.dev" target="_blank" rel="noopener noreferrer">Frankfurter</a>)</li>
          <li><strong lang="en">A Bit of Earth:</strong> <a href={earthHref}>{copy.earthSources}</a></li>
          <li><a href={appAboutHref}>{copy.appAboutLabel}</a></li>
        </ul>
      </section>
      <ProjectFooter />
    </div>
  </main>
</Layout>

<style>
  .about-prose { color: var(--color-ink-muted); font-size: 1.0625rem; line-height: 1.85; }
  .about-prose p { margin: 0 0 1rem; }
  .about-content section + section { margin-top: 3rem; }
  h2 { color: var(--color-ink); font-size: 1.25rem; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; margin: 0 0 1rem; }
  .about-sources { list-style: disc; padding-left: 1.25rem; margin: 0; }
  .about-sources li { padding-left: .25rem; margin-bottom: .625rem; }
  .about-sources strong { font-weight: 700; color: var(--color-ink); }
  .about-creator { display: flex; align-items: center; gap: 1rem; }
  .about-profile-avatar { width: 4rem; height: 4rem; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .about-profile-links { display: flex; flex-wrap: wrap; gap: .75rem; }
  .about-profile-links a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 3rem; min-height: 44px; padding: .625rem 1rem;
    border: 1px solid var(--color-divider); border-radius: .75rem;
    background: var(--color-surface); font-weight: 600; line-height: 1.2; text-decoration: none;
  }
  .about-profile-links a:hover { background: var(--hover-tint); border-color: var(--color-ink-muted); }
  .about-prose :global(a) { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-divider); }
  .about-prose :global(a:hover) { text-decoration-color: currentColor; }
</style>
