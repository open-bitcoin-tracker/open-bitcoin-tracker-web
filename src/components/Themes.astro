---
import Phone from './Phone.astro';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const srcs = ['/screenshots/paper-cream.png', '/screenshots/salmon-press.png', '/screenshots/deepsea-blue.png', '/screenshots/oled-black.png'];
const swatches = ['#F8F7F3', '#F3C7B6', '#0F1E3A', '#080808'];
---
<section id="themes" class="themes-section section-space" data-scene>
  <div class="site-container">
    <div class="section-intro" data-reveal-stagger="90">
      <span class="section-index" aria-hidden="true" data-reveal>02 / UI</span>
      <h2 class="section-heading" data-reveal>{t.themes.heading}</h2>
      <p class="section-description" data-reveal>{t.themes.sub}</p>
    </div>
    <div class="theme-controls" role="group" aria-label={t.themes.regionAria} data-reveal>
      {srcs.map((_, i) => (
        <button type="button" class="theme-choice" data-theme-index={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={t.themes.showAria.replace('{label}', t.themes.labels[i])}>
          <span class="theme-swatch" style={`--swatch: ${swatches[i]}`} aria-hidden="true"></span>{t.themes.labels[i]}
        </button>
      ))}
    </div>
    <div class="themes-gallery" role="region" aria-label={t.themes.regionAria} data-reveal="scale">
      {srcs.map((src, i) => (
        <button type="button" class:list={['gallery-item', { 'is-active': i === 0 }]} data-gallery-index={i} aria-label={t.themes.showAria.replace('{label}', t.themes.labels[i])} aria-pressed={i === 0 ? 'true' : 'false'}>
          <Phone src={src} alt={`${t.themes.altPrefix}${t.themes.labels[i]}${t.themes.altSuffix}`} />
          <span class="gallery-label"><span class="gallery-number" aria-hidden="true">0{i + 1}</span>{t.themes.labels[i]}</span>
        </button>
      ))}
    </div>
  </div>
</section>
<script>
  const gallery = document.querySelector<HTMLElement>('.themes-gallery');
  if (gallery) {
    const choices = [...document.querySelectorAll<HTMLButtonElement>('.theme-choice')];
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('.gallery-item')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let picked = false;
    let current = 0;
    const select = (index: number, scroll = false, animate = true) => {
      current = index;
      choices.forEach((choice, i) => choice.setAttribute('aria-pressed', String(i === index)));
      items.forEach((item, i) => { item.classList.toggle('is-active', i === index); item.setAttribute('aria-pressed', String(i === index)); });
      if (scroll && window.matchMedia('(max-width: 767px)').matches) {
        const itemBounds = items[index].getBoundingClientRect();
        const galleryBounds = gallery.getBoundingClientRect();
        gallery.scrollTo({ left: gallery.scrollLeft + itemBounds.left - galleryBounds.left - (gallery.clientWidth - itemBounds.width) / 2, behavior: reduce.matches || !animate ? 'instant' : 'smooth' });
      }
    };
    choices.forEach((choice, index) => {
      choice.addEventListener('click', () => { picked = true; select(index, true); });
      choice.addEventListener('keydown', (event) => {
        let next = current;
        if (event.key === 'ArrowRight') next = (index + 1) % choices.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + choices.length) % choices.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = choices.length - 1;
        else return;
        event.preventDefault(); picked = true; choices[next].focus(); select(next, true);
      });
    });
    items.forEach((item, index) => item.addEventListener('click', () => { picked = true; select(index, true); }));
    // Keep the visible mobile screenshot in sync without moving the page vertically.
    select(document.documentElement.classList.contains('dark') ? 2 : 0, true, false);
    document.addEventListener('themechange', () => { if (!picked) select(document.documentElement.classList.contains('dark') ? 2 : 0, true); });
    const syncScroll = () => {
      if (!window.matchMedia('(max-width: 767px)').matches) return;
      const bounds = gallery.getBoundingClientRect();
      const center = bounds.left + bounds.width / 2;
      let nearest = 0;
      let distance = Infinity;
      items.forEach((item, index) => {
        const itemBounds = item.getBoundingClientRect();
        const offset = Math.abs(itemBounds.left + itemBounds.width / 2 - center);
        if (offset < distance) { distance = offset; nearest = index; }
      });
      select(nearest);
    };
    gallery.addEventListener('pointerdown', () => { picked = true; }, { passive: true });
    if ('onscrollend' in gallery) gallery.addEventListener('scrollend', syncScroll);
    else {
      let scrollTimer: ReturnType<typeof setTimeout>;
      gallery.addEventListener('scroll', () => { clearTimeout(scrollTimer); scrollTimer = setTimeout(syncScroll, 120); }, { passive: true });
    }
  }
</script>
