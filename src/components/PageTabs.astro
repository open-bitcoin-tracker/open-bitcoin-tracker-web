---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLang, stripLocale, useTranslations } from '../i18n/utils';
import { tracker } from '../i18n/tracker';
import { aBitOfEarth } from '../lib/projects';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const nav = useTranslations(Astro.currentLocale).nav;
const currentPage = stripLocale(Astro.url.pathname);
const pages = [
  { path: 'price-tracker', label: t.priceChart, english: false },
  { path: 'video-mode', label: nav.videoMode, english: false },
  { path: aBitOfEarth.path, label: aBitOfEarth.title, english: true },
  { path: 'android-app', label: t.app, english: false },
];
---

<div class="menu-page-links">
  {pages.map(({ path, label, english }) => (
    <a
      href={getRelativeLocaleUrl(lang, path)}
      class="page-link"
      lang={english ? 'en' : undefined}
      aria-current={currentPage === path ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
  <a href={getRelativeLocaleUrl(lang, 'about')} class="page-link" aria-current={currentPage === 'about' ? 'page' : undefined}>{t.about}</a>
</div>
