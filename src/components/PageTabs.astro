---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { resolveLang, stripLocale } from '../i18n/utils';
import { tracker } from '../i18n/tracker';
import { aBitOfEarth } from '../lib/projects';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const currentPage = stripLocale(Astro.url.pathname);
const pages = [
  { path: 'price-tracker', label: t.priceChart },
  { path: 'android-app', label: t.app },
];
const visiblePages = pages.filter(({ path }) => currentPage !== path);
---

<div class="menu-page-links">
  {visiblePages.map(({ path, label }) => (
    <a
      href={getRelativeLocaleUrl(lang, path)}
      class="page-link"
    >
      {label}
    </a>
  ))}
  {currentPage !== aBitOfEarth.path && <a href={getRelativeLocaleUrl(lang, aBitOfEarth.path)} class="page-link" lang="en">{aBitOfEarth.title}</a>}
</div>
