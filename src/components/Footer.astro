---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, resolveLang } from '../i18n/utils';
import DownloadButton from './DownloadButton.astro';

interface Props {
  showAppAbout?: boolean;
}
const { showAppAbout = false } = Astro.props;
const repoUrl = 'https://github.com/Max-Hodler/open-bitcoin-tracker';

const t = useTranslations(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);
const aboutHref = getRelativeLocaleUrl(lang, 'about');
const appAboutHref = getRelativeLocaleUrl(lang, 'android-app/about');
const privacyHref = getRelativeLocaleUrl(lang, 'privacy');
---

<footer class="footer-section">
  <div class="site-container footer-container">
    <div class="footer-layout">
      <div class="footer-brand" data-reveal>
        <div class="flex items-center gap-3">
          <img src="/app-icon.webp" width="48" height="48" alt="" class="footer-app-icon h-11 w-11 shrink-0" />
          <span lang="en" class="brand-name text-lg tracking-tight text-ink">Open Bitcoin Tracker</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">{t.hero.tagline}</p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <DownloadButton variant="footer" placement="up" />
        </div>
        <p class="mt-5 text-sm leading-relaxed text-ink-muted">{t.footer.copyright}</p>
      </div>

      <div class="footer-links text-sm text-ink-muted" data-reveal>
        <a href={repoUrl} rel="noopener noreferrer" target="_blank" class="footer-link hover:text-ink">{t.footer.github}</a>
        <a href={aboutHref} class="footer-link hover:text-ink">{t.footer.about}</a>
        {showAppAbout && <a href={appAboutHref} class="footer-link hover:text-ink">{t.projectAbout.appAboutLabel}</a>}
        <a href={privacyHref} class="footer-link hover:text-ink">{t.footer.privacy}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    border-top: 1px solid var(--color-divider);
    background: var(--color-surface);
  }
  .footer-link {
    transition: color 0.15s ease;
  }
  .footer-app-icon {
    filter: drop-shadow(0 1px 2px rgb(var(--color-ink-rgb) / 0.04)) drop-shadow(0 4px 12px rgb(var(--color-ink-rgb) / 0.05));
  }
</style>
