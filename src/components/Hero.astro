---
import FeatureCard from './FeatureCard.astro';
import Phone from './Phone.astro';
import DownloadButton from './DownloadButton.astro';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const screens = [
  { src: '/screenshots/paper-cream.png', alt: `${t.hero.altPrefix}${t.themes.labels[0]}${t.hero.altSuffix}` },
  { src: '/screenshots/deepsea-blue.png', alt: `${t.hero.altPrefix}${t.themes.labels[2]}${t.hero.altSuffix}` },
];
---
<section class="hero-section" id="hero" data-scene>
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <h1 data-reveal><span lang="en" class="brand-name">Open <span class="hero-bitcoin">Bitcoin</span> Tracker</span>{' '}<span class="hero-subtitle">{t.hero.subtitle}</span></h1>
      <p class="hero-description" data-reveal>{t.hero.reasons[0].body}</p>
      <div class="hero-actions" data-reveal>
        <DownloadButton />
      </div>
      <div class="hero-trust" data-reveal>
        <span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>{t.privacy.cards[0].title}</span>
        <span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>{t.privacy.cards[1].title}</span>
        <a href="https://github.com/Max-Hodler/open-bitcoin-tracker" target="_blank" rel="noopener noreferrer">{t.privacy.cards[3].title}<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 5-7 7 7 7m8-14 7 7-7 7" /></svg></a>
      </div>
    </div>
    <div class="hero-stage" data-reveal="scale">
      <div class="stage-grid" aria-hidden="true"></div>
      <div class="orbit" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-device-position">
        <Phone src={screens[0].src} alt={screens[0].alt} id="hero-phone" class="hero-device" tilt eager />
      </div>
    </div>
  </div>
  <div class="site-container hero-benefits" data-reveal-stagger="120">
    <div data-reveal><FeatureCard title={t.hero.reasons[1].title} body={t.hero.reasons[1].body} icon="lock" headingLevel="h2" /></div>
    <div data-reveal><FeatureCard title={t.hero.reasons[2].title} body={t.hero.reasons[2].body} icon="bolt" headingLevel="h2" /></div>
  </div>
</section>
<script is:inline define:vars={{ screens }}>
  (() => {
    const screen = document.querySelector('#hero-phone img');
    if (!screen) return;
    const syncTheme = () => {
      const { src, alt } = screens[document.documentElement.classList.contains('dark') ? 1 : 0];
      screen.src = src;
      screen.alt = alt;
    };
    syncTheme();
    document.addEventListener('themechange', syncTheme);
  })();
</script>
