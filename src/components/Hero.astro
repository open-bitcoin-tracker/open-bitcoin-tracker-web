---
import FeatureCard from './FeatureCard.astro';
import Phone from './Phone.astro';
import DownloadButton from './DownloadButton.astro';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const titleParts = t.hero.reasons[0].title.split(t.hero.titleHighlight);
const screenSrcs = ['/screenshots/paper-cream.png', '/screenshots/salmon-press.png', '/screenshots/deepsea-blue.png', '/screenshots/oled-black.png'];
const themeLabels = t.themes.labels;
const altPrefix = t.hero.altPrefix;
const altSuffix = t.hero.altSuffix;
---
<section class="hero-section" id="hero" data-scene>
  <div class="site-container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow" data-reveal><span class="eyebrow-line" aria-hidden="true"></span>{t.hero.tagline}</p>
      <h1 data-reveal>{titleParts[0]}<em>{t.hero.titleHighlight}</em>{titleParts[1]}</h1>
      <p class="hero-description" data-reveal>{t.hero.reasons[0].body}</p>
      <div class="hero-actions" data-reveal>
        <DownloadButton />
      </div>
      <div class="hero-trust" data-reveal>
        <span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>{t.privacy.cards[0].title}</span>
        <span><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4 10-10" /></svg>{t.privacy.cards[1].title}</span>
        <a href="https://github.com/Max-Hodler/open-bitcoin-tracker" target="_blank" rel="noopener noreferrer">{t.privacy.cards[3].title}<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 5-7 7 7 7m8-14 7 7-7 7" /></svg></a>
      </div>
    </div>
    <div class="hero-stage" data-reveal="scale">
      <div class="stage-grid" aria-hidden="true"></div>
      <div class="orbit" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>
      <div class="hero-device-position">
        <Phone src={screenSrcs[0]} alt={t.hero.phoneAria} id="hero-phone" class="hero-device" interactive eager />
      </div>
    </div>
  </div>
  <div class="site-container hero-benefits" data-reveal-stagger="120">
    <div data-reveal><FeatureCard title={t.hero.reasons[1].title} body={t.hero.reasons[1].body} icon="lock" headingLevel="h2" /></div>
    <div data-reveal><FeatureCard title={t.hero.reasons[2].title} body={t.hero.reasons[2].body} icon="bolt" headingLevel="h2" /></div>
  </div>
</section>
<script is:inline define:vars={{ screenSrcs, themeLabels, altPrefix, altSuffix }}>
  (() => {
    const phone = document.getElementById('hero-phone');
    if (!phone) return;
    const screen = phone.querySelector('img');
    const nextScreen = phone.querySelector('.device-next');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = document.documentElement.classList.contains('dark') ? 2 : 0;
    let picked = false;
    let version = 0;
    const setScreen = (index, animate = true) => {
      current = index;
      const token = ++version;
      const src = screenSrcs[index];
      const alt = `${altPrefix}${themeLabels[index]}${altSuffix}`;
      nextScreen.getAnimations().forEach((animation) => animation.cancel());
      const show = () => {
        if (token !== version) return;
        if (!animate || reduce.matches) { screen.src = src; screen.alt = alt; return; }
        nextScreen.src = src;
        const animation = nextScreen.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 360, easing: 'ease-out', fill: 'forwards' });
        animation.finished.then(() => {
          if (token !== version) return;
          screen.src = src;
          screen.alt = alt;
          animation.cancel();
        }).catch(() => {});
      };
      const preload = new Image();
      preload.src = src;
      if (preload.complete) show();
      else preload.onload = show;
    };
    setScreen(current, false);
    const cycle = () => { picked = true; setScreen((current + 1) % screenSrcs.length); };
    phone.addEventListener('click', cycle);
    phone.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); cycle(); }
    });
    document.addEventListener('themechange', () => {
      if (!picked) setScreen(document.documentElement.classList.contains('dark') ? 2 : 0);
    });
  })();
</script>
