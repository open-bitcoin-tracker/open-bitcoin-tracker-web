---
import Phone from './Phone.astro';
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
---
<section id="prices" class="prices-section section-space" data-scene>
  <div class="site-container prices-grid">
    <div class="prices-copy">
      <h2 class="section-heading" data-reveal>{t.prices.heading}</h2>
      <p class="section-description" data-reveal>{t.prices.sub}</p>
      <div class="price-features" data-reveal-stagger="120">
        {t.prices.cards.map((card, i) => (
          <div class="price-feature" data-reveal>
            <span class="price-feature-icon" aria-hidden="true">
              {i === 0 ? <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 2.6-6.4L3 8m0-5v5h5m4-1v5l3 2" /></svg> : <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18 9 12l4 4 8-10m-6 0h6v6" /></svg>}
            </span>
            <div><h3>{card.title}</h3><p>{card.body}</p></div>
          </div>
        ))}
      </div>
    </div>
    <div class="prices-stage" data-reveal="scale">
      <div class="price-grid-lines" aria-hidden="true"></div>
      <div class="prices-device-position"><Phone src="stack" alt={`${t.themes.altPrefix}${t.prices.heading}`} class="prices-device" /></div>
      <span class="stage-corner corner-top" aria-hidden="true"></span>
      <span class="stage-corner corner-bottom" aria-hidden="true"></span>
    </div>
  </div>
</section>
