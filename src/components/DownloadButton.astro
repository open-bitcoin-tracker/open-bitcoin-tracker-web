---
import DisclosureMenu from './ui/DisclosureMenu.astro';
import { useTranslations } from '../i18n/utils';

interface Props {
  variant?: 'default' | 'nav' | 'footer';
  placement?: 'down' | 'up';
}

const { variant = 'default', placement = 'down' } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const releasesUrl = 'https://github.com/Max-Hodler/open-bitcoin-tracker/releases/latest';
const zapstoreUrl = 'https://zapstore.dev/apps/com.openbitcointracker.app';
---

<DisclosureMenu placement={placement} closeOnSelect class:list={['download-dropdown', `download-dropdown--${placement}`, `download-dropdown--${variant}`]}>
  <summary class:list={['download-trigger button cta-primary', { 'nav-download': variant === 'nav' }]}>
    {variant !== 'nav' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v4a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-4" /></svg>
    )}
    <span>{t.nav.download}</span>
    <svg class="download-caret" data-menu-caret width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <ul class="download-menu menu-panel">
    <li>
      <a href={releasesUrl} rel="noopener noreferrer" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 5-7 7 7 7m8-14 7 7-7 7" /></svg>
        {t.nav.github}
      </a>
    </li>
    <li>
      <a href={zapstoreUrl} rel="noopener noreferrer" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13 2-9 12h7l-1 8 10-12h-8l1-8Z" /></svg>
        {t.hero.viewZapstore}
      </a>
    </li>
  </ul>
</DisclosureMenu>



<style>
  .download-dropdown { position: relative; width: fit-content; }
  .download-dropdown[open] { z-index: 60; }
  .download-trigger > svg { flex-shrink: 0; }
  .download-dropdown--footer .download-trigger { min-height: 44px; padding: .625rem 1.25rem; border-radius: 12px; font-size: .875rem; }
  .download-menu { min-width: max(100%, 11rem); max-height: none; overflow: visible; }
  .download-dropdown { --disclosure-bg: var(--color-surface); --disclosure-border: var(--color-divider); --disclosure-shadow: var(--shadow-card-hover); }
  .download-dropdown--nav .download-menu { left: auto; right: 0; }
  .download-menu a {
    display: flex;
    align-items: center;
    gap: .625rem;
    min-height: 44px;
    padding: .625rem .75rem;
    border-radius: .5rem;
    color: var(--color-ink);
    font-size: .875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color .15s ease;
  }
  .download-menu a:hover, .download-menu a:focus-visible { background: var(--hover-tint); }
</style>
