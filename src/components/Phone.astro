---
import AppScreenshot from './AppScreenshot.astro';
import type { ScreenshotName } from '../lib/screenshots';
interface Props {
  src: ScreenshotName;
  alt: string;
  darkSrc?: ScreenshotName;
  darkAlt?: string;
  id?: string;
  class?: string;
  tilt?: boolean;
  eager?: boolean;
}
const { src, alt, darkSrc, darkAlt, id, class: className, tilt = false, eager = false } = Astro.props;
---
<div class:list={['device', className]} id={id} data-tilt={tilt || undefined}>
  <div class="device-tilt">
    <div class="device-frame">
      <div class="device-screen">
        <AppScreenshot name={src} alt={alt} darkName={darkSrc} darkAlt={darkAlt} eager={eager} />
      </div>
    </div>
  </div>
</div>
