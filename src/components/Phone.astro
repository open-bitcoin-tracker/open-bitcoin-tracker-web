---
interface Props {
  src: string;
  alt: string;
  id?: string;
  class?: string;
  tilt?: boolean;
  eager?: boolean;
}
const { src, alt, id, class: className, tilt = false, eager = false } = Astro.props;
---
<div class:list={['device', className]} id={id} data-tilt={tilt || undefined}>
  <div class="device-tilt">
    <div class="device-frame">
      <div class="device-screen">
        <img src={src} alt={alt} width="1280" height="2856" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
      </div>
    </div>
  </div>
</div>
