<div class="landing-particles" aria-hidden="true">
  <canvas data-landing-particles></canvas>
</div>

<script>
  import { createLandingParticles } from '../lib/landing-particles';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-landing-particles]');
  if (canvas) {
    const particles = createLandingParticles(canvas);
    document.addEventListener('astro:before-swap', particles.destroy, { once: true });
  }
</script>

<style>
  .landing-particles {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(ellipse at 15% 70%, rgb(247 147 26 / .045), transparent 55%),
      radial-gradient(ellipse at 85% 25%, rgb(247 147 26 / .035), transparent 50%);
  }
  canvas { display: block; width: 100%; height: 100%; opacity: .8; }
  :global(html.dark) canvas { opacity: .95; }
</style>
