---
import FeatureCard from './FeatureCard.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, resolveLang } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
const icons = ['user-x', 'eye-off', 'lock', 'code'] as const;
---
<section id="privacy" class="privacy-section section-space">
  <div class="site-container">
    <div class="privacy-panel">
      <div class="privacy-intro" data-reveal>
        <span class="section-index" aria-hidden="true">02 / OBT</span>
        <div class="privacy-symbol" aria-hidden="true">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M32 5 53 14v17c0 14-21 25-21 25S11 45 11 31V14L32 5Z"/><rect x="23" y="27" width="18" height="15" rx="4"/><path d="M27 27v-5a5 5 0 0 1 10 0v5m-5 6v3"/></svg>
        </div>
        <h2 class="section-heading">{t.privacy.heading}</h2>
        <p class="section-description">{t.privacy.sub}</p>
        <a class="text-link" href={getRelativeLocaleUrl(resolveLang(Astro.currentLocale), 'privacy')}>{t.footer.privacy}</a>
      </div>
      <div class="privacy-cards" data-reveal-stagger="90">
        {t.privacy.cards.map((card, i) => (
          <div class="privacy-card" data-reveal>
            <FeatureCard title={card.title} body={card.body} icon={icons[i]} />
            {i === 3 && <a class="text-link source-link" href="https://github.com/Max-Hodler/open-bitcoin-tracker" target="_blank" rel="noopener noreferrer">{t.hero.viewGithub}</a>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
