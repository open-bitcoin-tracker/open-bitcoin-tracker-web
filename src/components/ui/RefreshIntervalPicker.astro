---
import { priceTabRefreshSeconds } from '../../lib/price-tab-title';

interface Props {
  id: string;
  label: string;
  locale: string;
  variant: 'menu' | 'dialog';
}
const { id, label, locale, variant } = Astro.props;
const interval = new Intl.NumberFormat(locale, { style: 'unit', unit: 'second', unitDisplay: 'long' });
---

<div class:list={['refresh-picker', `refresh-picker--${variant}`]} data-refresh-picker={variant}>
  <span class="refresh-label" id={`${id}-label`}>{label}</span>
  <select hidden tabindex="-1" aria-hidden="true" data-price-tab-refresh={variant === 'menu' ? true : undefined} data-price-tab-dialog-refresh={variant === 'dialog' ? true : undefined}>
    {priceTabRefreshSeconds.map(seconds => <option value={seconds}>{interval.format(seconds)}</option>)}
  </select>
  <div class="refresh-control">
    <button type="button" class="refresh-trigger" data-refresh-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls={`${id}-options`} aria-labelledby={`${id}-label ${id}-value`}>
      <span id={`${id}-value`} data-refresh-value>{interval.format(1)}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </button>
  </div>
</div>

<style>
  .refresh-picker { position: relative; display: grid; gap: .5rem; width: 100%; min-width: 0; color: var(--menu-link-ink); font-size: .875rem; }
  .refresh-label { min-width: 0; line-height: 1.4; }
  .refresh-control { position: relative; min-width: 0; }
  .refresh-trigger { display: flex; align-items: center; justify-content: space-between; gap: .75rem; width: 100%; min-width: 0; min-height: 48px; padding: .75rem; border: 0; border-radius: .625rem; background: var(--menu-option-hover); color: var(--menu-link-ink); font-size: .875rem; text-align: start; cursor: pointer; transition: color 150ms ease, background-color 150ms ease; }
  .refresh-trigger:hover, .refresh-trigger[aria-expanded='true'] { color: var(--menu-primary-ink); background: var(--hover-tint); }
  .refresh-trigger svg { flex-shrink: 0; color: var(--color-ink-muted); }
  .refresh-picker--menu { grid-template-columns: minmax(0, 1fr) auto; align-items: center; font-size: .8125rem; }
  .refresh-picker--menu .refresh-label { overflow-wrap: anywhere; }
  .refresh-picker--menu .refresh-control { display: contents; }
  .refresh-picker--menu .refresh-trigger { min-height: 44px; padding: .5rem; border: 0; background: transparent; font-size: .8125rem; }
  @media (prefers-reduced-motion: reduce) {
    .refresh-trigger { transition: none; }
  }
</style>
