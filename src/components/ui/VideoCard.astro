---
import '../../styles/video-card.css';
interface Props { id?: string; title?: string; isLive?: boolean; isSilent?: boolean; liveLabel: string; noSoundLabel: string; loadLabel?: string; class?: string; }
const { id, title = '', isLive = false, isSilent = false, liveLabel, noSoundLabel, loadLabel, class: className } = Astro.props;
---
<button type="button" class:list={['video-card', className]} data-video-suggestion={id} aria-label={loadLabel && `${loadLabel}: ${title}${isLive ? ` (${liveLabel})` : ''}${isSilent ? ` (${noSoundLabel})` : ''}`} title={title} disabled={!!id}>
  <span class="video-card-preview">
    <img src={id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined} width="480" height="360" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
    <span class="video-card-badge video-no-sound-badge" data-video-no-sound hidden={!isSilent} aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 5-6 4H2v6h3l6 4zM17 9l6 6m0-6-6 6" /></svg>
      {noSoundLabel}
    </span>
    <span class="video-card-badge video-live-badge" data-video-live hidden={!isLive} aria-hidden="true">{liveLabel}</span>
  </span>
  <span class="video-card-title">{title}</span>
</button>
