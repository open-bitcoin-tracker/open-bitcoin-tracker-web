---
import { useTranslations } from '../i18n/utils';
const t = useTranslations(Astro.currentLocale);
---
<aside class="kao-section">
  <div class="site-container">
    <div class="kao-panel" data-reveal>
      <div class="kao-title">
        <span class="kao-icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V6a4 4 0 0 1 7.8-1.2m-3.8 10v2"/></svg></span>
        <h2>Keep Android Open</h2>
      </div>
      <div><p>{t.kao.body}</p><a href="https://keepandroidopen.org/" rel="noopener noreferrer" target="_blank" class="text-link">{t.kao.linkText}</a></div>
    </div>
  </div>
</aside>
