---
import DisclosureMenu from './ui/DisclosureMenu.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, resolveLang, stripLocale } from '../i18n/utils';
import { languages } from '../i18n/languages';
import '../styles/preference-selectors.css';

interface Props {
  // Which way the menu opens. In the footer there's no room below, so the menu
  // flips above the trigger.
  placement?: 'down' | 'up';
}
const { placement = 'down' } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const current = resolveLang(Astro.currentLocale);

// The locale-agnostic remainder of the current path, so each option links to
// the SAME page in its language (e.g. /es/about -> /de/about, /about).
const localePath = stripLocale(Astro.url.pathname);

// Sorted A–Z by autonym, matching the app's language list.
const LANGS = [...languages].sort((a, b) => a.label.localeCompare(b.label, 'en'));

const currentLabel = LANGS.find((l) => l.code === current)?.label ?? 'English';
---

<DisclosureMenu placement={placement} class:list={['lang-switcher', `lang-switcher--${placement}`]}>
  <summary aria-label={t.nav.langLabel} class="lang-summary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20" />
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
    </svg>
    <span class="lang-current">{currentLabel}</span>
    <svg class="lang-caret" data-menu-caret width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </summary>
  <ul class="lang-menu menu-panel" role="list">
    {LANGS.map((l) => (
      <li>
        <a
          href={getRelativeLocaleUrl(l.loc, localePath)}
          data-language={l.loc}
          hreflang={l.code}
          lang={l.code}
          class:list={['lang-option', 'menu-option', { 'is-current': l.code === current }]}
          aria-current={l.code === current ? 'true' : undefined}
        >
          {l.label}
        </a>
      </li>
    ))}
  </ul>
</DisclosureMenu>

<script>
  // Remember explicit choices before navigating, including English at the root.
  document.querySelectorAll<HTMLAnchorElement>('.lang-option').forEach((link) => {
    link.addEventListener('click', () => {
      const secure = location.protocol === 'https:' ? '; Secure' : '';
      try {
        document.cookie = `lang=${link.dataset.language}; Path=/; Max-Age=15552000; SameSite=Lax${secure}`;
      } catch {}
    });
  });

</script>
