---
import CurrencyOptions from './ui/CurrencyOptions.astro';
import bundledHistory from '../../public/data/btc-history.csv?raw';
import { parseHistory, chartPaths } from '../lib/bitcoin-chart';
import { resolveLang } from '../i18n/utils';
import { tracker } from '../i18n/tracker';
import { ranges } from '../i18n/ranges';
import { rangeSlots } from '../lib/bitcoin-range';
import { currencies } from '../lib/bitcoin-currency';
import { chartSettings } from '../i18n/chart-settings';
import { party } from '../i18n/party';
import RefreshIntervalPicker from './ui/RefreshIntervalPicker.astro';
import RefreshIntervalOptions from './ui/RefreshIntervalOptions.astro';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const r = ranges[lang];
const { exitFullscreen, fullscreenUnavailable } = party[lang];
const settings = { ...chartSettings[lang], fullscreen: chartSettings[lang].enterFullscreen, exitFullscreen, fullscreenUnavailable };
const history = parseHistory(bundledHistory);
const paths = chartPaths(history, 1200, 440);
const lastDate = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(history.at(-1)!.time);
---

<section class="bitcoin-tracker" data-bitcoin-tracker data-copy={JSON.stringify(t)} data-range-copy={JSON.stringify(r)} data-settings-copy={JSON.stringify(settings)} data-history-start={history[0].time} data-locale={lang} aria-label={t.price}>
  <p class="sr-only" data-control-status role="status" hidden></p>
  <div class="price-header">
    <div>
      <div class="price-currency-picker" data-price-currency-picker>
        <button type="button" class="price-currency-trigger" data-currency-trigger aria-haspopup="listbox" aria-expanded="false" aria-controls="price-currency-options" disabled>
          <span class="sr-only">{settings.currency}: </span>
          <span class="current-price" data-price aria-label={t.unavailable}>—</span>
          <span class="sr-only" data-currency-value>USD</span>
        </button>
        <CurrencyOptions id="price-currency-options" locale={lang} class="price-currency-menu chart-menu-panel" label={settings.currency} />
      </div>
      <p class="price-change" data-price-change></p>
      <p class="currency-status" data-currency-status role="status" hidden></p>
    </div>
  </div>

  <p class="history-status" data-history-status role="status" hidden>{t.history}</p>
  <noscript><p class="history-status">{t.unavailable}.</p></noscript>
  <figure class="price-history">
    <div class="chart-plot">
      <svg class="price-chart" data-chart viewBox="0 0 1200 440" preserveAspectRatio="none" role="img" tabindex="0" aria-label={`${t.price} — ${t.scale}`} aria-describedby="chart-description">
        <desc id="chart-description" data-chart-description>{t.all}: 2010 — {lastDate}. {t.scale}.</desc>
        <defs>
          <linearGradient id="price-fill" data-chart-fill-gradient gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="440">
            <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.18" />
            <stop offset="60%" stop-color="var(--color-accent)" stop-opacity="0.12" />
            <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="price-marker-fade" data-chart-marker-gradient gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="440">
            <stop offset="0%" stop-color="var(--color-ink-muted)" stop-opacity="0" />
            <stop offset="15%" stop-color="var(--color-ink-muted)" />
            <stop offset="85%" stop-color="var(--color-ink-muted)" />
            <stop offset="100%" stop-color="var(--color-ink-muted)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path data-chart-area d={paths.area} fill="url(#price-fill)" />
        <path data-chart-line d={paths.line} fill="none" stroke="var(--color-accent)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
        <g data-chart-marker visibility="hidden" pointer-events="none" aria-hidden="true">
          <line data-chart-marker-line stroke="url(#price-marker-fade)" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
          <g data-chart-marker-point>
            <circle data-chart-marker-dot r="5" fill="var(--color-accent)" stroke="var(--color-ink)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          </g>
        </g>
      </svg>
      <div class="chart-marker-waves" data-chart-marker-waves hidden aria-hidden="true">
        <span class="chart-marker-wave"></span>
        <span class="chart-marker-wave"></span>
        <span class="chart-marker-wave"></span>
      </div>
    </div>
  </figure>
  <div class="chart-loading" data-chart-loading role="status" hidden>
    <span class="loading-wave" aria-hidden="true"></span>
    <span class="loading-description" data-loading-description>{r.loading}</span>
  </div>
  <div class="chart-controls" data-chart-controls hidden>
    <div class="range-bar" data-range-bar role="group" aria-label={r.label}>
      <div class="range-pill" data-range-pill aria-hidden="true" hidden></div>
      {rangeSlots.map(({ unit, initial }) => (
        <div class="range-slot" data-range-slot={unit}>
          <button type="button" class="range-step" data-range-step="1" aria-label={r.increase} tabindex="-1" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 10 4-4 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="range-select" data-range-select={unit} aria-pressed="false"><span data-range-label>{initial}{r.suffixes[unit]}</span></button>
          <button type="button" class="range-step" data-range-step="-1" aria-label={r.decrease} tabindex="-1" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      ))}
      <div class="range-slot" data-range-slot="all" data-selected="true">
        <button type="button" class="range-select" data-range-select="all" aria-label={t.all} aria-pressed="true"><span data-range-label>{r.all}</span></button>
      </div>
    </div>
    <details class="chart-settings" data-chart-settings data-currency-picker>
      <summary class="chart-settings-trigger" data-settings-trigger aria-label={settings.settings} title={settings.settings}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
      </summary>
      <div class="chart-settings-menu chart-menu-panel" data-settings-menu role="group" aria-label={settings.settings}>
        <section class="chart-settings-group" aria-label={settings.chartDisplay}>
          <label class="sr-only" for="chart-currency">{settings.currency}</label>
          <select id="chart-currency" data-currency hidden disabled>{currencies.map(code => <option value={code}>{code}</option>)}</select>
          <div class="chart-setting-row">
            <span class="chart-setting-label" id="chart-currency-label">{settings.currency}</span>
            <button type="button" class="chart-currency-control" data-currency-trigger aria-labelledby="chart-currency-label chart-currency-value" aria-haspopup="listbox" aria-expanded="false" aria-controls="chart-currency-options" disabled>
              <span class="chart-currency-value" id="chart-currency-value" data-currency-value>USD</span>
              <svg class="chart-action-chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
            </button>
          </div>
          <hr class="chart-settings-divider" />
          <fieldset class="chart-setting-row chart-scale-row">
            <legend class="sr-only">{settings.scale}</legend>
            <span class="chart-setting-label" aria-hidden="true">{settings.scale}</span>
            <div class="chart-scale-choices">
              <label class="chart-scale-choice"><input class="sr-only" type="radio" name="chart-scale" value="logarithmic" data-scale-option aria-label={settings.logarithmic} checked /><span>{t.logScaleShort}</span></label>
              <label class="chart-scale-choice"><input class="sr-only" type="radio" name="chart-scale" value="linear" data-scale-option aria-label={settings.linear} /><span>{settings.linear}</span></label>
            </div>
          </fieldset>
        </section>
        <section class="chart-settings-group" aria-label={settings.browserTab}>
          <button type="button" class="chart-setting-row chart-tab-toggle" role="switch" data-price-tab-toggle aria-checked="false" aria-labelledby="chart-tab-label" aria-controls="price-tab-dialog">
            <span class="chart-setting-label" id="chart-tab-label">{settings.priceTab}</span>
            <span class="chart-switch-control" aria-hidden="true">
              <span class="chart-switch-state chart-switch-on">{settings.on}</span>
              <span class="chart-switch-state chart-switch-off">{settings.off}</span>
              <span class="chart-switch-track"></span>
            </span>
          </button>
          <div class="chart-tab-refresh" data-price-tab-refresh-row hidden>
            <RefreshIntervalPicker id="chart-tab-refresh" label={settings.priceTabRefreshMenu} locale={lang} variant="menu" />
          </div>
        </section>
        <div class="chart-settings-footer">
          <button type="button" class="chart-menu-action chart-fullscreen-button" data-fullscreen aria-label={settings.fullscreen} title={settings.fullscreen} hidden disabled>
            <svg class="chart-action-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /></svg>
            <span data-fullscreen-label>{settings.fullscreen}</span>
          </button>
        </div>
      </div>
      <div class="chart-currency-panel chart-menu-panel" data-currency-panel hidden>
        <div class="chart-currency-header">
          <button type="button" class="chart-currency-back" data-currency-back aria-label={settings.settings}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <h2 class="chart-menu-title" id="chart-currency-title">{settings.currency}</h2>
        </div>
        <CurrencyOptions id="chart-currency-options" locale={lang} class="chart-currency-menu" labelledby="chart-currency-title" />
      </div>
      <div class="chart-refresh-panel chart-menu-panel" data-refresh-panel hidden>
        <div class="chart-currency-header">
          <button type="button" class="chart-currency-back" data-refresh-back aria-label={settings.settings}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <h2 class="chart-menu-title" id="chart-refresh-title">{settings.priceTabRefresh}</h2>
        </div>
        <RefreshIntervalOptions id="chart-tab-refresh-options" locale={lang} class="chart-refresh-options" labelledby="chart-refresh-title" />
      </div>
    </details>
  </div>
  <dialog class="price-tab-dialog" id="price-tab-dialog" data-price-tab-dialog aria-labelledby="price-tab-heading" aria-describedby="price-tab-description price-tab-note">
    <div data-price-tab-confirmation>
      <header class="price-tab-header">
        <h2 id="price-tab-heading" data-price-tab-heading tabindex="-1">{settings.priceTab}</h2>
      </header>
      <div class="price-tab-body">
        <p id="price-tab-description">{settings.priceTabDescription}</p>
        <p id="price-tab-note">{settings.priceTabNote}</p>
        <RefreshIntervalPicker id="dialog-tab-refresh" label={settings.priceTabRefresh} locale={lang} variant="dialog" />
      </div>
      <footer class="price-tab-footer">
        <button type="button" class="price-tab-confirm" data-price-tab-confirm>{settings.priceTabConfirm}</button>
        <button type="button" class="price-tab-cancel" data-price-tab-cancel>{settings.cancel}</button>
      </footer>
    </div>
    <div class="price-tab-refresh-panel" data-price-tab-refresh-panel hidden>
      <div class="chart-currency-header">
        <button type="button" class="chart-currency-back" data-price-tab-refresh-back aria-label={settings.priceTab}>
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
        </button>
        <h2 class="chart-menu-title" id="dialog-tab-refresh-heading" data-price-tab-refresh-heading>{settings.priceTabRefresh}</h2>
      </div>
      <RefreshIntervalOptions id="dialog-tab-refresh-options" locale={lang} class="price-tab-refresh-options" labelledby="dialog-tab-refresh-heading" />
    </div>
  </dialog>
</section>

<script>
  import '../scripts/bitcoin-price';
</script>

<style>
  .bitcoin-tracker { position: relative; isolation: isolate; overflow: clip; display: flex; flex-direction: column; flex: 1; min-height: 0; padding-top: var(--live-price-top); }
  :global(.chart-menu-panel) { position: absolute; right: 0; bottom: calc(100% + .75rem); width: min(21rem, calc(100vw - 2 * var(--tracker-gutter, 1rem))); max-height: calc(100dvh - 6rem - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)); padding: .5rem; overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--menu-dropdown-border); border-radius: var(--radius-lg); color: var(--menu-ink); background: var(--menu-dropdown-bg); box-shadow: var(--menu-dropdown-shadow); animation: chart-menu-enter 160ms var(--ease-out); }
  :global(.chart-menu-panel)[hidden], .chart-fullscreen-button[hidden], :global(.chart-currency-menu)[hidden], .bitcoin-tracker[data-currency-open] .chart-settings-menu, .chart-settings[data-refresh-open] .chart-settings-menu { display: none; }
  .chart-menu-title { min-width: 0; margin: 0; padding: .625rem .75rem; font-size: 1.25rem; font-weight: 600; line-height: 1.3; letter-spacing: -.02em; overflow-wrap: anywhere; }
  .chart-settings-menu { width: min(24rem, calc(100vw - 2 * var(--tracker-gutter, 1rem))); padding: 1.25rem; scrollbar-width: thin; scrollbar-color: var(--menu-dropdown-border) transparent; }
  .chart-settings-divider { margin: .5rem 0; border: 0; border-top: 1px solid var(--menu-dropdown-border); }
  .chart-settings-group + .chart-settings-group { margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--menu-dropdown-border); }
  .chart-setting-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .75rem; width: 100%; min-width: 0; min-height: 64px; margin: 0; padding: .5rem 0; color: var(--menu-ink); font-size: 1rem; line-height: 1.4; text-align: start; }
  .chart-setting-label { min-width: 0; font-weight: 500; overflow-wrap: anywhere; }
  .chart-currency-control { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 6.5rem; min-height: 48px; padding: .625rem .75rem; border: 0; border-radius: var(--radius-control-small); background: var(--menu-option-hover); }
  .chart-currency-control:hover { color: var(--menu-primary-ink); }
  .chart-currency-control:disabled { opacity: .35; cursor: default; }
  .chart-tab-toggle { border-radius: var(--radius-control-small); cursor: pointer; }
  .chart-tab-toggle:hover .chart-setting-label { color: var(--menu-primary-ink); }
  .chart-switch-control { display: flex; align-items: center; gap: .5rem; }
  .chart-switch-state { color: var(--menu-link-ink); font-size: .8125rem; }
  .chart-switch-track { position: relative; flex-shrink: 0; width: 48px; height: 28px; border-radius: 999px; background: var(--menu-option-hover); transition: background-color 150ms ease; }
  .chart-switch-track::after { content: ''; position: absolute; inset-block-start: 4px; inset-inline-start: 4px; width: 20px; height: 20px; border-radius: 50%; background: var(--menu-ink); transition: inset-inline-start 150ms ease; }
  [data-price-tab-toggle][aria-checked="true"] .chart-switch-track { background: var(--color-accent); }
  [data-price-tab-toggle][aria-checked="true"] .chart-switch-track::after { inset-inline-start: 24px; background: #101820; }
  [data-price-tab-toggle][aria-checked="false"] .chart-switch-on, [data-price-tab-toggle][aria-checked="true"] .chart-switch-off { display: none; }
  .chart-tab-refresh { margin-inline-start: .75rem; padding-inline-start: .875rem; border-inline-start: 2px solid var(--menu-dropdown-border); }
  .chart-tab-refresh[hidden] { display: none; }
  .chart-tab-refresh :global(.refresh-picker--menu) { grid-template-columns: minmax(0, 1fr) minmax(0, auto); gap: .5rem; padding-block: .5rem; color: var(--menu-ink); font-size: 1rem; }
  .chart-tab-refresh :global(.refresh-picker--menu .refresh-trigger) { min-height: 48px; padding: .625rem .75rem; border-radius: var(--radius-control-small); background: var(--menu-option-hover); color: var(--menu-ink); font-size: 1rem; }
  .chart-tab-refresh :global(.refresh-label) { overflow-wrap: normal; }
  .chart-settings-footer { margin-top: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--menu-dropdown-border); }
  .chart-settings-footer:has(.chart-fullscreen-button[hidden]) { display: none; }
  .chart-menu-action { display: flex; align-items: center; justify-content: center; gap: .625rem; width: 100%; min-height: 48px; padding: .625rem .75rem; border-radius: var(--radius-control-small); color: var(--menu-ink); font-size: 1rem; font-weight: 500; line-height: 1.4; cursor: pointer; transition: color 150ms ease, background-color 150ms ease; }
  .chart-menu-action:hover { background: var(--menu-option-hover); color: var(--menu-primary-ink); }
  .chart-menu-action:disabled { cursor: default; opacity: .35; }
  .chart-action-icon, .chart-action-chevron { flex-shrink: 0; color: var(--menu-link-ink); }
  .price-tab-dialog { position: fixed; inset: 0; width: min(460px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)); margin: auto; padding: 0; overflow-y: auto; overscroll-behavior: contain; border: 1px solid var(--menu-dropdown-border); border-radius: 20px; background: var(--menu-dropdown-bg); color: var(--menu-ink); box-shadow: 0 24px 80px #0006; }
  .price-tab-dialog::backdrop { background: #000b; }
  .price-tab-dialog { scrollbar-width: thin; scrollbar-color: var(--menu-dropdown-border) transparent; }
  .price-tab-refresh-panel { padding: .5rem; }
  .price-tab-dialog[open], .price-tab-dialog[open]::backdrop { animation: price-tab-enter 240ms ease-out; }
  @keyframes price-tab-enter { from { opacity: 0; } to { opacity: 1; } }
  .price-tab-header { padding: 28px 28px 16px; }
  .price-tab-header h2 { margin: 0; font-family: 'Barlow Condensed', var(--font-sans); font-size: 1.625rem; font-weight: 700; line-height: 1.2; text-transform: uppercase; letter-spacing: .015em; }
  .price-tab-header h2:focus { outline: none; }
  .price-tab-body { display: grid; gap: 1rem; padding: 0 28px 24px; color: var(--menu-link-ink); font-size: .9375rem; line-height: 1.6; }
  .price-tab-body p { margin: 0; }
  .price-tab-footer { display: flex; flex-direction: column; gap: 10px; padding: 0 28px 28px; }
  .price-tab-footer button { min-height: 48px; padding: 12px 16px; border-radius: 10px; font-size: .875rem; font-weight: 600; line-height: 1.4; text-align: center; }
  .price-tab-confirm { background: var(--color-accent); color: #101820; }
  .price-tab-confirm:hover { filter: brightness(1.08); }
  .price-tab-cancel { color: var(--menu-link-ink); background: var(--menu-option-hover); }
  .price-tab-cancel:hover { color: var(--menu-primary-ink); }
  .chart-currency-value { font-size: 1rem; font-weight: 500; color: var(--menu-ink); }
  .chart-currency-header { display: flex; align-items: center; gap: .25rem; padding: 0 .25rem .5rem; border-bottom: 1px solid var(--menu-dropdown-border); }
  .chart-currency-header .chart-menu-title { padding: .625rem .25rem; }
  .chart-currency-back { display: grid; place-items: center; flex-shrink: 0; width: 44px; height: 44px; border-radius: 50%; color: var(--menu-link-ink); }
  .chart-currency-back:hover { color: var(--menu-primary-ink); background: var(--menu-option-hover); }
  :global(.chart-currency-menu), :global(.chart-refresh-options), :global(.price-tab-refresh-options) { padding-top: .375rem; }
  @keyframes chart-menu-enter { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .price-header, .history-status { padding-inline: var(--tracker-gutter, 1rem); }
  .price-header { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding-inline-end: calc(var(--tracker-gutter, 1rem) + 48px + 1rem); }
  .price-header > div { flex: 1; min-width: 0; container-type: inline-size; }
  .price-header:has([data-currency-open]) { z-index: 3; }
  .price-currency-picker { position: relative; width: fit-content; max-width: 100%; }
  .price-currency-trigger { position: relative; display: inline-flex; align-items: center; max-width: 100%; padding: 0; border-radius: .25rem; color: inherit; cursor: pointer; }
  .price-currency-trigger:disabled { cursor: default; }
  :global(.price-currency-menu) { top: calc(100% + .5rem); bottom: auto; left: 0; right: auto; max-height: min(30rem, calc(100dvh - var(--live-price-top) - var(--live-price-font-size) - 5rem)); }
  .current-price { font-size: min(var(--live-price-font-size), calc(170cqw / var(--price-chars, 1))); font-weight: 700; line-height: 1.1; letter-spacing: -.06em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .price-change { min-height: 1.5em; margin-top: .375rem; color: var(--color-ink-muted); font-size: clamp(.9375rem, 1.5vw, 1.125rem); font-variant-numeric: tabular-nums; }
  .price-history { position: relative; z-index: 0; display: flex; flex-direction: column; flex: 1; min-height: 0; margin: .25rem 0 0; padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px)); }
  /* Shrink the plot on short screens so controls remain inside the viewport. */
  .chart-plot { position: relative; flex: 1; min-height: 0; }
  /* Let zooming curves rise behind the price; the tracker clips at the page edges. */
  .price-chart { position: absolute; inset: 0; display: block; width: 100%; height: 100%; overflow: visible; cursor: crosshair; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; outline: none; }
  /* Keep the plot frameless on touch; indicate keyboard focus with a short line. */
  .chart-plot:has(.price-chart:focus-visible)::after { content: ''; position: absolute; top: .75rem; left: var(--tracker-gutter, 1rem); width: 2.5rem; height: 3px; border-radius: 999px; background: var(--color-emphasis-ink); pointer-events: none; }
  /* Animate small composited layers independently of the full history SVG. */
  .chart-marker-waves { position: absolute; top: 0; left: 0; width: 0; height: 0; pointer-events: none; }
  .chart-marker-waves[hidden] { display: none; }
  .chart-marker-wave { position: absolute; top: -30px; left: -30px; width: 60px; height: 60px; border: 1.5px solid var(--color-accent); border-radius: 50%; opacity: 0; animation: marker-wave 5s linear infinite; will-change: transform, opacity; }
  .chart-marker-wave:nth-child(2) { animation-delay: -1.666667s; }
  .chart-marker-wave:nth-child(3) { animation-delay: -3.333333s; }
  @keyframes marker-wave {
    from { transform: scale(.166667); opacity: .3; }
    to { transform: scale(1); opacity: 0; }
