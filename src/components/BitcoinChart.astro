---
import bundledHistory from '../../public/data/btc-history.csv?raw';
import { parseHistory, chartPaths } from '../lib/bitcoin-chart';
import { resolveLang } from '../i18n/utils';
import { tracker } from '../i18n/tracker';
import { ranges } from '../i18n/ranges';
import { rangeSlots } from '../lib/bitcoin-range';
import { currencies } from '../lib/bitcoin-currency';
import { chartSettings } from '../i18n/chart-settings';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const r = ranges[lang];
const settings = chartSettings[lang];
const currencyNames = new Intl.DisplayNames(lang, { type: 'currency' });
const history = parseHistory(bundledHistory);
const paths = chartPaths(history, 1200, 440);
const lastDate = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(history.at(-1)!.time);
---

<section class="bitcoin-tracker" data-bitcoin-tracker data-copy={JSON.stringify(t)} data-range-copy={JSON.stringify(r)} data-settings-copy={JSON.stringify(settings)} data-history-start={history[0].time} data-locale={lang} aria-label={t.price}>
  <div class="price-header">
    <div>
      <p class="current-price" data-price aria-label={t.unavailable}>—</p>
      <p class="price-change" data-price-change></p>
      <p class="currency-status" data-currency-status role="status" hidden></p>
    </div>
  </div>

  <p class="history-status" data-history-status role="status" hidden>{t.history}</p>
  <noscript><p class="history-status">{t.unavailable}.</p></noscript>
  <figure class="price-history">
    <div class="chart-plot">
      <svg class="price-chart" data-chart viewBox="0 0 1200 440" preserveAspectRatio="none" role="img" tabindex="0" aria-label={`${t.price} — ${t.scale}`} aria-describedby="chart-description">
        <desc id="chart-description" data-chart-description>{t.all}: 2010 — {lastDate}. {t.scale}.</desc>
        <defs>
          <linearGradient id="price-fill" data-chart-fill-gradient gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="440">
            <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.18" />
            <stop offset="60%" stop-color="var(--color-accent)" stop-opacity="0.12" />
            <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="price-marker-fade" data-chart-marker-gradient gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="440">
            <stop offset="0%" stop-color="var(--color-ink-muted)" stop-opacity="0" />
            <stop offset="15%" stop-color="var(--color-ink-muted)" />
            <stop offset="85%" stop-color="var(--color-ink-muted)" />
            <stop offset="100%" stop-color="var(--color-ink-muted)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path data-chart-area d={paths.area} fill="url(#price-fill)" />
        <path data-chart-line d={paths.line} fill="none" stroke="var(--color-accent)" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linejoin="round" />
        <g data-chart-marker visibility="hidden" pointer-events="none" aria-hidden="true">
          <line data-chart-marker-line stroke="url(#price-marker-fade)" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
          <g data-chart-marker-point>
            <circle data-chart-marker-dot r="5" fill="var(--color-accent)" stroke="var(--color-ink)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          </g>
        </g>
      </svg>
      <div class="chart-marker-waves" data-chart-marker-waves hidden aria-hidden="true">
        <span class="chart-marker-wave"></span>
        <span class="chart-marker-wave"></span>
        <span class="chart-marker-wave"></span>
      </div>
    </div>
  </figure>
  <div class="chart-loading" data-chart-loading role="status" hidden>
    <span class="loading-spinner" aria-hidden="true"></span>
    <span class="loading-description" data-loading-description>{r.loading}</span>
  </div>
  <div class="chart-controls" data-chart-controls hidden>
    <div class="range-bar" data-range-bar role="group" aria-label={r.label}>
      <div class="range-pill" data-range-pill aria-hidden="true" hidden></div>
      {rangeSlots.map(({ unit, initial }) => (
        <div class="range-slot" data-range-slot={unit}>
          <button type="button" class="range-step" data-range-step="1" aria-label={r.increase} tabindex="-1" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 10 4-4 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="range-select" data-range-select={unit} aria-pressed="false"><span data-range-label>{initial}{r.suffixes[unit]}</span></button>
          <button type="button" class="range-step" data-range-step="-1" aria-label={r.decrease} tabindex="-1" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      ))}
      <div class="range-slot" data-range-slot="all" data-selected="true">
        <button type="button" class="range-select" data-range-select="all" aria-label={t.all} aria-pressed="true"><span data-range-label>{r.all}</span></button>
      </div>
    </div>
    <details class="chart-settings" data-chart-settings>
      <summary class="chart-settings-trigger" data-settings-trigger aria-label={settings.settings} title={settings.settings}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="12" cy="19" r="2" /></svg>
      </summary>
      <div class="chart-settings-menu" data-settings-menu>
        <fieldset class="scale-options">
          <legend>{settings.scale}</legend>
          <label class="scale-option"><input type="radio" name="chart-scale" value="logarithmic" data-scale-option checked /><span>{settings.logarithmic}</span></label>
          <label class="scale-option"><input type="radio" name="chart-scale" value="linear" data-scale-option /><span>{settings.linear}</span></label>
        </fieldset>
        <fieldset class="currency-options">
          <legend>{settings.currency}</legend>
            {currencies.map(code => (
              <label class="currency-option">
                <input type="radio" name="chart-currency" value={code} data-currency-option checked={code === 'USD'} />
                <span>{code} — {currencyNames.of(code)}</span>
              </label>
            ))}
        </fieldset>
      </div>
    </details>
  </div>
</section>

<script>
  import '../scripts/bitcoin-price';
</script>

<style>
  .bitcoin-tracker { position: relative; isolation: isolate; overflow: clip; display: flex; flex-direction: column; flex: 1; padding-top: var(--live-price-top); }
  .price-header, .history-status { padding-inline: var(--tracker-gutter, 1rem); }
  .price-header { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding-inline-end: calc(var(--tracker-gutter, 1rem) + 48px + 1rem); }
  .price-header > div { flex: 1; min-width: 0; container-type: inline-size; }
  .current-price { font-size: min(var(--live-price-font-size), calc(170cqw / var(--price-chars, 1))); font-weight: 700; line-height: 1.1; letter-spacing: -.06em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .price-change { min-height: 1.5em; margin-top: .375rem; color: var(--color-ink-muted); font-size: clamp(.9375rem, 1.5vw, 1.125rem); font-variant-numeric: tabular-nums; }
  .price-history { position: relative; z-index: 0; display: flex; flex-direction: column; flex: 1; margin: .25rem 0 0; }
  /* Fill all remaining viewport space; keep a usable plot on short screens. */
  .chart-plot { position: relative; flex: 1; min-height: 180px; }
  /* Let zooming curves rise behind the price; the tracker clips at the page edges. */
  .price-chart { position: absolute; inset: 0; display: block; width: 100%; height: 100%; overflow: visible; cursor: crosshair; touch-action: none; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; outline: none; }
  /* Keep the plot frameless on touch; indicate keyboard focus with a short line. */
  .chart-plot:has(.price-chart:focus-visible)::after { content: ''; position: absolute; top: .75rem; left: var(--tracker-gutter, 1rem); width: 2.5rem; height: 3px; border-radius: 999px; background: var(--color-emphasis-ink); pointer-events: none; }
  /* Animate small composited layers independently of the full history SVG. */
  .chart-marker-waves { position: absolute; top: 0; left: 0; width: 0; height: 0; pointer-events: none; }
  .chart-marker-waves[hidden] { display: none; }
  .chart-marker-wave { position: absolute; top: -30px; left: -30px; width: 60px; height: 60px; border: 1.5px solid var(--color-accent); border-radius: 50%; opacity: 0; animation: marker-wave 5s linear infinite; will-change: transform, opacity; }
  .chart-marker-wave:nth-child(2) { animation-delay: -1.666667s; }
  .chart-marker-wave:nth-child(3) { animation-delay: -3.333333s; }
  @keyframes marker-wave {
    from { transform: scale(.166667); opacity: .3; }
    to { transform: scale(1); opacity: 0; }
  }
  .history-status { position: relative; z-index: 1; margin-top: .65rem; color: var(--color-ink-muted); font-size: .6875rem; }
  .chart-loading { position: fixed; inset: 0; width: var(--menu-viewport-width, 100vw); height: 100dvh; z-index: 2; display: grid; place-items: center; pointer-events: none; }
  .chart-loading[hidden] { display: none; }
  .loading-spinner { width: clamp(7rem, 16vw, 11rem); aspect-ratio: 1; border: 20px solid rgb(247 147 26 / .18); border-top-color: var(--color-accent); border-right-color: var(--color-accent); border-radius: 50%; animation: chart-loading-spin 1.1s linear infinite; will-change: transform; }
  .loading-description { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @keyframes chart-loading-spin { to { transform: rotate(360deg); } }
  /* Overlay the plot without reserving space beneath the price line. */
  .chart-controls { position: absolute; z-index: 1; left: 50%; bottom: calc(1rem + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); display: flex; align-items: stretch; gap: .5rem; width: calc(100% - 2 * var(--tracker-gutter, 1rem)); max-width: 48rem; }
  .chart-controls[hidden] { display: none; }
  .range-bar, .chart-settings-trigger { padding: .25rem; border-radius: 999px; background: rgb(var(--color-ink-rgb) / .055); }
  .range-bar { position: relative; display: flex; flex: 1; min-width: 0; align-items: stretch; gap: .25rem; margin: 0; }
  .chart-settings { position: relative; flex: 0 0 44px; }
  .chart-settings-trigger { display: flex; align-items: center; justify-content: center; height: 100%; min-height: 44px; color: var(--color-ink-muted); cursor: pointer; list-style: none; }
  .chart-settings-trigger::-webkit-details-marker { display: none; }
  .chart-settings-trigger:hover { background: var(--hover-tint); color: var(--color-ink); }
  .chart-settings-menu { position: absolute; right: 0; bottom: calc(100% + .5rem); width: min(19rem, calc(100vw - 2 * var(--tracker-gutter, 1rem))); max-height: min(70dvh, 30rem); overflow-y: auto; padding: 1rem; border: 1px solid var(--color-divider); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-card-hover); }
  .scale-options { margin: 0 0 1rem; padding: 0 0 .75rem; border: 0; border-bottom: 1px solid var(--color-divider); }
  .currency-options { margin: 0; padding: 0; border: 0; }
  .scale-options legend, .currency-options legend { display: block; margin-bottom: .5rem; color: var(--color-ink-muted); font-size: .8125rem; }
  .scale-option, .currency-option { display: flex; align-items: center; gap: .625rem; min-height: 40px; padding: .375rem .5rem; border-radius: .5rem; font-size: .875rem; cursor: pointer; }
  .scale-option:hover, .currency-option:hover { background: var(--hover-tint); }
  .scale-option input, .currency-option input { accent-color: var(--color-accent); flex-shrink: 0; }
  .currency-status { margin-top: .375rem; color: var(--color-ink-muted); font-size: .75rem; }
  .range-pill { position: absolute; left: 0; top: 0; border-radius: 999px; background: var(--color-surface); box-shadow: var(--shadow-card); pointer-events: none; transition: transform 260ms cubic-bezier(.215, .61, .355, 1), width 260ms cubic-bezier(.215, .61, .355, 1), height 260ms cubic-bezier(.215, .61, .355, 1); }
  .range-pill[hidden] { display: none; }
  .range-bar[data-dragging="true"] { cursor: grabbing; }
  .range-bar[data-dragging="true"] .range-pill { box-shadow: var(--shadow-card-hover); transition: none; }
  .range-slot { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; border-radius: 999px; }
  .range-select { width: 100%; min-height: 36px; padding-inline: .25rem; font-size: .875rem; font-variant-numeric: tabular-nums; color: var(--color-ink-muted); border-radius: 999px; transition: color 200ms ease-out, font-weight 200ms ease-out; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  /* Reserve both gesture axes only on the selected, adjustable pill. */
  .range-slot[data-selected="true"]:not([data-range-slot="all"]) { touch-action: none; }
  /* Equal side columns center each chevron between the label and pill edge. */
  .range-slot:has(.range-step) { display: grid; grid-template-columns: minmax(0, 1fr) max-content minmax(0, 1fr); }
  .range-slot:has(.range-step) .range-select { grid-area: 1 / 1 / 2 / -1; display: grid; grid-template-columns: subgrid; align-items: center; padding-inline: 0; }
  .range-slot:has(.range-step) [data-range-label] { grid-column: 2; }
  [data-range-label] { display: inline-block; }
  .range-slot[data-highlighted="true"] .range-select { color: var(--color-emphasis-ink); font-weight: 700; cursor: grab; }
  .range-bar[data-dragging="true"] .range-select { cursor: grabbing; }
  .range-step { grid-row: 1; justify-self: center; z-index: 1; display: flex; justify-content: center; align-items: center; width: 100%; max-width: 20px; height: 100%; border-radius: 999px; visibility: hidden; color: var(--color-accent); }
  .range-step svg { max-width: 100%; }
  .range-step[data-range-step="1"] { grid-column: 1; }
  .range-step[data-range-step="-1"] { grid-column: 3; }
  .range-bar:hover .range-slot[data-selected="true"] .range-step,
  .range-bar:has(:focus-visible) .range-slot[data-selected="true"] .range-step { visibility: visible; }
  .range-bar[data-dragging="true"] .range-step,
  .range-bar[data-moving="true"] .range-step { visibility: hidden !important; }
  @media (hover: none) {
    .range-bar:focus-within .range-slot[data-selected="true"] .range-step { visibility: visible; }
  }
  .chart-controls button:focus-visible { outline-offset: 0; }
  @media (prefers-reduced-motion: reduce) {
    .range-pill, .range-select { transition: none; }
    .chart-marker-wave { animation: none; will-change: auto; }
    .chart-marker-wave:first-child { transform: scale(.333333); opacity: .15; }
    .loading-spinner { animation: none; will-change: auto; }
  }
  @media (min-width: 701px) {
    .bitcoin-tracker { --live-price-top: max(1rem, env(safe-area-inset-top, 0px)); --live-price-font-size: clamp(5.75rem, 14.5vw, 11.5rem); }
  }
  @media (max-width: 600px) {
    .price-header { display: block; position: relative; }
    .range-step { display: none; }
  }
</style>
