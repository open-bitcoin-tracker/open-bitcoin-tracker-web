---
import { videoPreviewBackgrounds } from '../lib/video-preview-backgrounds';
import { resolveLang } from '../i18n/utils';
import { tracker } from '../i18n/tracker';
import { party } from '../i18n/party';

const lang = resolveLang(Astro.currentLocale);
const t = tracker[lang];
const { play, pause } = party[lang];
const copy = { price: t.price, updated: t.updated, unavailable: t.unavailable, connecting: t.connecting, live: t.live, delayed: t.delayed, offline: t.offline, play, pause };
---

<figure class="video-preview" data-video-preview data-locale={lang} data-copy={JSON.stringify(copy)} data-backgrounds={JSON.stringify(videoPreviewBackgrounds)}>
  <video data-preview-video poster={videoPreviewBackgrounds[0].poster} muted loop playsinline preload="none" aria-hidden="true"></video>
  <figcaption class="video-price-overlay">
    <span class="video-price" data-video-price aria-label={t.unavailable}>—</span>
    <span class="sr-only" data-video-price-status>{t.unavailable}</span>
  </figcaption>
  <div class="video-preview-controls">
    <button class="video-preview-control" type="button" data-preview-motion aria-label={play} title={play} hidden>
      <svg data-motion-play width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7z" /></svg>
      <svg data-motion-pause width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
    </button>
    <button class="video-preview-control" type="button" data-preview-next aria-label="Next animation" lang="en" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m5 5 10 7L5 19zm12 0h2v14h-2z" /></svg>
    </button>
  </div>
</figure>

<script>
  import { startVideoPreview } from '../scripts/video-preview';
  const root = document.querySelector<HTMLElement>('[data-video-preview]');
  if (root) startVideoPreview(root);
</script>

<style>
  .video-preview { container-type: inline-size; position: relative; height: clamp(200px, 23vw, 280px); margin: 0; border: 1px solid var(--color-divider); overflow: hidden; background: #21130d; color: #fff; }
  video { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .video-price-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .5rem; padding: 1rem; background: #0003; text-shadow: 0 2px 6px #000, 0 0 20px #0009; pointer-events: none; }
  .video-price { font-size: clamp(2rem, 13cqi, 4.5rem); font-weight: 750; line-height: 1.1; letter-spacing: -.045em; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .video-preview-controls { position: absolute; left: 50%; bottom: .75rem; transform: translateX(-50%); z-index: 2; display: flex; align-items: center; gap: .5rem; }
  .video-preview-control { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid #fff6; border-radius: 50%; background: #0009; color: #fff; cursor: pointer; }
  .video-preview-control:hover { background: #000c; }
  .video-preview-control:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  [hidden] { display: none; }
  @media (max-width: 700px) { .video-preview { height: auto; aspect-ratio: 1.8; } }
</style>
