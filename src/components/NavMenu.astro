---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, resolveLang, stripLocale } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
const homeHref = getRelativeLocaleUrl(resolveLang(Astro.currentLocale), '');
const isHome = stripLocale(Astro.url.pathname) === '';
---

<details class="nav-menu">
  <summary class="nav-menu-trigger" aria-label={t.nav.menuLabel} aria-haspopup="dialog" aria-controls="site-navigation-dialog">
    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
      <path class="menu-bar menu-bar--top" d="M2 12h20" />
      <path class="menu-bar menu-bar--middle" d="M2 12h20" />
      <path class="menu-bar menu-bar--bottom" d="M2 12h20" />
    </svg>
  </summary>
  <!-- Open inside details preserves navigation when JavaScript is unavailable. -->
  <dialog open id="site-navigation-dialog" class="nav-menu-dialog" aria-label={t.nav.mainAria}>
    <button class="nav-menu-close" type="button" aria-label={t.nav.closeMenu} autofocus>
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
        <path class="menu-bar menu-bar--top" d="M2 12h20" />
        <path class="menu-bar menu-bar--middle" d="M2 12h20" />
        <path class="menu-bar menu-bar--bottom" d="M2 12h20" />
      </svg>
    </button>
    <div class="nav-menu-panel">
      <a class="menu-brand" href={homeHref} aria-label="Open Bitcoin Tracker" aria-current={isHome ? 'page' : undefined}>
        <img class="menu-brand-icon" src="/app-icon.png" width="96" height="96" alt="" />
        <span lang="en" class="brand-name">OBT</span>
      </a>
      <div class="menu-links"><slot /></div>
      <div class="nav-menu-settings">
        <LanguageSwitcher placement="up" />
        <ThemeToggle showLabel />
      </div>
    </div>
  </dialog>
</details>
<noscript><style is:inline>.nav-menu-close { display: none; }</style></noscript>

<script>
  // Root scrollbar-gutter changes CSS viewport units when the modal opens.
  // Keep both controls anchored to the same actual viewport width instead.
  const syncMenuViewport = () => {
    document.documentElement.style.setProperty('--menu-viewport-width', `${window.innerWidth}px`);
  };
  syncMenuViewport();
  window.addEventListener('resize', syncMenuViewport);
  document.querySelectorAll<HTMLDetailsElement>('.nav-menu').forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('.nav-menu-trigger');
    const dialog = menu.querySelector<HTMLDialogElement>('.nav-menu-dialog');
    const panel = menu.querySelector<HTMLElement>('.nav-menu-panel');
    const close = menu.querySelector<HTMLButtonElement>('.nav-menu-close');
    if (!dialog || !panel || !trigger || !close) return;

    dialog.removeAttribute('open');
    // Collapsing the trigger must not interrupt the modal's closing transition.
    document.body.append(dialog);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let closing: Promise<void> | undefined;
    let openingFrame: number | undefined;
    const closeDialog = () => {
      if (openingFrame !== undefined) window.cancelAnimationFrame(openingFrame);
      openingFrame = undefined;
      dialog.classList.remove('is-opening');
      // Reveal the identical resting control before leaving the top layer.
      // Waiting for the asynchronous close event leaves a blank frame.
      menu.open = false;
      document.documentElement.classList.remove('nav-menu-open');
      dialog.close();
      trigger.focus({ preventScroll: true });
    };
    const dismiss = (): Promise<void> => {
      if (!dialog.open) return Promise.resolve();
      if (closing) return closing;
      if (openingFrame !== undefined) window.cancelAnimationFrame(openingFrame);
      openingFrame = undefined;
      dialog.classList.remove('is-opening');
      if (reduce.matches) {
        closeDialog();
        return Promise.resolve();
      }
      closing = new Promise<void>((resolve) => {
        const finish = () => {
          window.clearTimeout(timeout);
          dialog.removeEventListener('transitionend', onTransitionEnd);
          closeDialog();
          dialog.classList.remove('is-closing');
          closing = undefined;
          resolve();
        };
        const onTransitionEnd = (event: TransitionEvent) => {
          if (event.target === panel && event.propertyName === 'transform') finish();
        };
        // Complete dismissal even if a browser cancels a transition event.
        const timeout = window.setTimeout(finish, 500);
        dialog.addEventListener('transitionend', onTransitionEnd);
        dialog.classList.add('is-closing');
      });
      return closing;
    };
    close.addEventListener('click', () => { void dismiss(); });
    dialog.addEventListener('close', () => {
      menu.open = false;
      document.documentElement.classList.remove('nav-menu-open');
      dialog.querySelectorAll('details').forEach((dropdown) => { dropdown.open = false; });
      trigger.focus({ preventScroll: true });
    });
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      const dropdown = dialog.querySelector<HTMLDetailsElement>('.lang-switcher[open]');
      if (dropdown) {
        dropdown.open = false;
        dropdown.querySelector<HTMLElement>('summary')?.focus();
      } else void dismiss();
    });
    dialog.addEventListener('keydown', (event) => {
      const dropdown = dialog.querySelector<HTMLDetailsElement>('.lang-switcher[open]');
      if (event.key === 'Escape' && dropdown) {
        event.preventDefault();
        event.stopPropagation();
        dropdown.open = false;
        dropdown.querySelector<HTMLElement>('summary')?.focus();
      }
      if (event.key === 'Tab') {
        const controls = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary, [tabindex="0"]'))
          .filter((control) => control.checkVisibility());
        const first = controls[0];
        const last = controls.at(-1);
        if (event.shiftKey && (document.activeElement === first || !dialog.contains(document.activeElement))) {
          event.preventDefault();
          last?.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first?.focus();
        }
      }
    }, { capture: true });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) void dismiss();
    });
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target === '_blank') {
        void dismiss();
        return;
      }
      event.preventDefault();
      void dismiss().then(() => { window.location.assign(link.href); });
    }));
    menu.addEventListener('toggle', () => {
      if (menu.open && !dialog.open) {
        document.documentElement.classList.add('nav-menu-open');
        dialog.classList.add('is-opening');
        dialog.showModal();
        // Establish the hamburger's initial frame explicitly: opening must
        // animate even when entering the top layer skips @starting-style.
        void close.offsetWidth;
        if (reduce.matches) dialog.classList.remove('is-opening');
        else openingFrame = window.requestAnimationFrame(() => {
          // Paint the resting bars in the top layer before starting the morph.
          // A single callback may run before the new control's first paint.
          openingFrame = window.requestAnimationFrame(() => {
            dialog.classList.remove('is-opening');
            openingFrame = undefined;
          });
        });
      } else if (!menu.open && dialog.open) void dismiss();
    });
  });
</script>

<style>
  :global(html.nav-menu-open) { overflow: hidden; scrollbar-gutter: auto; }
  /* Share the page theme even after the modal is moved into body. */
  :global(:root) {
    --menu-ink: var(--color-ink);
    --menu-panel-bg: linear-gradient(165deg, var(--color-surface), var(--color-paper) 80%);
    --menu-panel-shadow: -12px 0 32px rgb(0 0 0 / .12);
    --menu-link-ink: var(--color-ink-muted);
    --menu-primary-ink: var(--color-ink);
    --menu-brand-ink: var(--color-ink);
    --menu-dropdown-bg: var(--color-surface);
    --menu-dropdown-border: var(--color-divider);
    --menu-dropdown-shadow: var(--shadow-card-hover);
    --menu-option-hover: var(--hover-tint);
  }
  :global(html.dark) {
    --menu-ink: #E9E6DF;
    --menu-panel-bg: linear-gradient(165deg, #14213D, #0B1428 80%);
    --menu-panel-shadow: -12px 0 32px rgb(0 0 0 / .3);
    --menu-link-ink: #CBD3E6;
    --menu-primary-ink: #FFF3D9;
    --menu-brand-ink: #FFFFFF;
    --menu-dropdown-bg: #14213D;
    --menu-dropdown-border: rgb(255 255 255 / .12);
    --menu-dropdown-shadow: 0 12px 40px rgb(0 0 0 / .4);
    --menu-option-hover: rgb(255 255 255 / .06);
  }
  .nav-menu { position: relative; flex-shrink: 0; }
  .nav-menu-trigger, .nav-menu-close {
    display: flex; align-items: center; justify-content: center;
    width: var(--menu-control-size); height: var(--menu-control-size); border: 0; border-radius: 50%;
    color: var(--menu-control-ink);
    background: var(--menu-control-bg);
  }
  .nav-menu-trigger {
    position: relative; z-index: 1;
    cursor: pointer; list-style: none;
  }
  .nav-menu-trigger::-webkit-details-marker { display: none; }
  :global(html.nav-menu-open) .nav-menu-trigger { visibility: hidden; }
  .menu-bar { transform-box: view-box; transform-origin: 12px 12px; transition: transform 240ms cubic-bezier(.22, 1, .36, 1), opacity 160ms ease; }
  .menu-bar--top { transform: translateY(-7px); }
  .menu-bar--bottom { transform: translateY(7px); }
  .nav-menu-dialog[open]:not(.is-closing):not(.is-opening) .menu-bar--top { transform: rotate(45deg); }
  .nav-menu-dialog[open]:not(.is-closing):not(.is-opening) .menu-bar--middle { transform: scaleX(0); opacity: 0; }
  .nav-menu-dialog[open]:not(.is-closing):not(.is-opening) .menu-bar--bottom { transform: rotate(-45deg); }
  .nav-menu-dialog {
    position: fixed; inset: 0 0 0 auto; width: clamp(400px, 40vw, 640px); height: 100dvh;
    max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    color: var(--menu-ink); background: transparent;
    overflow: visible;
    transition: display 420ms allow-discrete, overlay 420ms allow-discrete;
  }
  .nav-menu-dialog[open] { display: block; }
  .nav-menu-dialog[open] .nav-menu-panel { opacity: 1; transform: translateX(0); }
  .nav-menu-dialog[open].is-opening .nav-menu-panel,
  .nav-menu-dialog[open].is-closing .nav-menu-panel { transform: translateX(100%); opacity: 0; }
  .nav-menu-dialog::backdrop { background: transparent; }
  .nav-menu-panel {
    position: relative; display: flex; flex-direction: column; gap: var(--menu-panel-gap);
    min-height: 100dvh; max-height: 100dvh; padding: var(--menu-panel-top) clamp(2rem, 3.5vw, 4rem) 2.5rem;
    overflow-x: hidden; overflow-y: auto;
    background: var(--menu-panel-bg); box-shadow: var(--menu-panel-shadow);
    opacity: 0; transform: translateX(100%);
    transition: transform 420ms cubic-bezier(.22, 1, .36, 1), opacity 300ms ease;
  }
  .nav-menu-close {
    position: fixed; z-index: 1; top: var(--menu-control-top); right: var(--menu-control-right);
    cursor: pointer;
  }
  .menu-brand { --menu-brand-size: 36px; display: flex; align-items: center; gap: .22em; min-height: var(--menu-control-size); padding-right: 3.5rem; font-size: calc(var(--menu-brand-size) * 1.25); line-height: 1.06; color: var(--menu-brand-ink); text-decoration: none; }
  .menu-brand-icon { flex: none; width: var(--menu-brand-size); height: var(--menu-brand-size); }
  .menu-brand .brand-name { line-height: .8; transform: translateY(-.05em); }
  .menu-links { display: grid; align-content: start; gap: 1.25rem; }
  .menu-links :global(.menu-page-links) { display: contents; }
  .menu-links :global(a) {
    display: block; width: fit-content; max-width: 100%; padding: .125rem 0;
    font-family: 'Barlow Condensed', 'Inter', sans-serif; font-size: clamp(2.5rem, 4.3vw, 4rem);
    font-weight: 700; line-height: 1.04; letter-spacing: -.015em; text-transform: uppercase;
    color: var(--menu-link-ink); overflow-wrap: anywhere; text-decoration: none;
  }
  .menu-links :global(a.page-link) { color: var(--menu-primary-ink); transition: color 200ms ease; }
  .menu-links :global(a:hover) { color: var(--color-accent); }
  .menu-links :global(a:focus-visible) { color: var(--color-accent); }
  .menu-links :global(a[aria-current='page']) { color: var(--color-accent); }
  .nav-menu-settings { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; }
  .nav-menu-settings :global(.lang-summary), .nav-menu-settings :global(.theme-toggle) {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 44px;
    color: var(--menu-link-ink); font-size: .875rem; cursor: pointer;
  }
  .nav-menu-settings :global(.lang-summary:hover), .nav-menu-settings :global(.theme-toggle:hover) { color: var(--menu-primary-ink); }
  .nav-menu-settings :global(.lang-menu) {
    background: var(--menu-dropdown-bg); border-color: var(--menu-dropdown-border); box-shadow: var(--menu-dropdown-shadow);
    max-height: min(50dvh, 24rem);
  }
  .nav-menu-settings :global(.lang-option) { color: var(--menu-link-ink); }
  .nav-menu-settings :global(.lang-option:hover), .nav-menu-settings :global(.lang-option.is-current) { color: var(--menu-primary-ink); background: var(--menu-option-hover); }
  @starting-style {
    .nav-menu-dialog[open] .nav-menu-panel { opacity: 0; transform: translateX(100%); }
  }
  @media (max-width: 700px) {
    .nav-menu-trigger svg, .nav-menu-close svg { width: 20px; height: 20px; }
    .nav-menu-dialog { width: 100vw; }
    .nav-menu-panel { padding: var(--menu-panel-top) 1.5rem max(1.5rem, env(safe-area-inset-bottom)); }
    .nav-menu-settings { flex-direction: column; align-items: flex-start; gap: .25rem; }
    .menu-links { gap: 1.125rem; }
    .menu-links :global(a) { font-size: clamp(2rem, 9vw, 3.25rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-menu-dialog, .nav-menu-panel, .menu-bar { transition: none; }
    .menu-links :global(a.page-link) { transition: none; }
  }
</style>
