---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations(Astro.currentLocale);
---

<details class="nav-menu">
  <summary class="nav-menu-trigger" aria-label={t.nav.menuLabel}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path class="menu-bars" d="M1 5h22M1 12h22M1 19h22" />
      <path class="menu-close" d="m3 3 18 18M3 21 21 3" />
    </svg>
  </summary>
  <div class="nav-menu-panel">
    <slot />
    <div class="nav-menu-settings">
      <LanguageSwitcher />
      <ThemeToggle showLabel />
    </div>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.nav-menu').forEach((menu) => {
    const trigger = menu.querySelector<HTMLElement>('.nav-menu-trigger');

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        event.preventDefault();
        menu.open = false;
        trigger?.focus();
      }
    });

    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) menu.open = false;
    });

    menu.addEventListener('toggle', () => {
      if (!menu.open) {
        menu.querySelectorAll('details').forEach((dropdown) => { dropdown.open = false; });
      }
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
        trigger?.focus();
      });
    });
  });
</script>

<style>
  .nav-menu { position: relative; flex-shrink: 0; }
  .nav-menu-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 0;
    color: var(--color-ink);
    background: transparent;
    cursor: pointer;
    list-style: none;
  }
  .nav-menu-trigger::-webkit-details-marker { display: none; }
  :global(html.dark) .nav-menu-trigger { color: #fff; }
  .nav-menu-trigger:hover { opacity: .75; }
  .menu-close, .nav-menu[open] .menu-bars { display: none; }
  .nav-menu[open] .menu-close { display: inline; }
  .nav-menu-panel {
    position: absolute;
    top: calc(100% + .75rem);
    right: 0;
    width: min(17rem, calc(100vw - 2rem));
    max-height: calc(100dvh - var(--nav-top, 1rem) - 48px - .75rem - max(1rem, env(safe-area-inset-bottom, 0px)));
    overflow-y: auto;
    padding: .5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover);
  }
  .nav-menu-panel :global(a), .nav-menu-panel :global(.lang-summary), .nav-menu-panel :global(.theme-toggle) {
    display: flex;
    align-items: center;
    gap: .5rem;
    width: 100%;
    min-height: 44px;
    padding: .625rem .75rem;
    border-radius: .5rem;
    color: var(--color-ink);
    font-size: .875rem;
  }
  .nav-menu-panel :global(a:hover), .nav-menu-panel :global(.lang-summary:hover), .nav-menu-panel :global(.theme-toggle:hover) { background: var(--hover-tint); }
  .nav-menu-settings { display: grid; gap: .25rem; }
  .nav-menu-panel > :global(a) ~ .nav-menu-settings { margin-top: .5rem; padding-top: .5rem; border-top: 1px solid var(--color-divider); }
  .nav-menu-panel :global(.theme-toggle) { justify-content: flex-start; cursor: pointer; }
  .nav-menu-panel :global(.lang-current) { display: inline; }
  .nav-menu-panel :global(.lang-caret) { margin-left: auto; }
  .nav-menu-panel :global(.lang-menu) {
    position: static;
    min-width: 0;
    max-height: none;
    margin-top: .25rem;
    box-shadow: none;
  }
</style>
