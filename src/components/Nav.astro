---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, resolveLang, stripLocale } from '../i18n/utils';
import NavMenu from './NavMenu.astro';
import PageTabs from './PageTabs.astro';
import { tracker } from '../i18n/tracker';
const t = useTranslations(Astro.currentLocale);
const lang = resolveLang(Astro.currentLocale);
const links = tracker[lang];
const pagePath = stripLocale(Astro.url.pathname);
const alignWithPrice = pagePath === '' || pagePath === 'android-app';
---
<nav class:list={['floating-nav', { 'floating-nav--chart': alignWithPrice }]} aria-label={t.nav.mainAria}>
  <NavMenu>
    <PageTabs />
    <a href={getRelativeLocaleUrl(lang, 'about')}>{links.about}</a>
    <a href={getRelativeLocaleUrl(lang, 'privacy')}>{links.privacy}</a>
    <a href="https://github.com/open-bitcoin-tracker/open-bitcoin-tracker-web" target="_blank" rel="noopener noreferrer">GitHub</a>
  </NavMenu>
</nav>

<style>
  .floating-nav { --nav-top: max(1rem, env(safe-area-inset-top, 0px)); position: fixed; top: var(--nav-top); right: clamp(1rem, 3vw, 4rem); z-index: 50; }
  .floating-nav--chart { --nav-top: calc(var(--live-price-top) + var(--live-price-font-size) * .55 - 24px); }
</style>
