---
import DisclosureMenu from './ui/DisclosureMenu.astro';
import { useTranslations } from '../i18n/utils';
import '../styles/preference-selectors.css';

interface Props {
  placement?: 'down' | 'up';
}
const { placement = 'up' } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const choices = [
  { value: 'auto', label: t.nav.themeAuto },
  { value: 'light', label: t.nav.themeLight },
  { value: 'dark', label: t.nav.themeDark },
];
---

<DisclosureMenu placement={placement} class:list={['theme-selector', `theme-selector--${placement}`]}>
  <summary class="theme-summary" aria-label={t.nav.themeLabel}>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="14" rx="2" />
      <path d="M8 21h8M12 17v4" />
    </svg>
    <span>{t.nav.themeLabel}: <span data-theme-current>{t.nav.themeAuto}</span></span>
    <svg class="theme-caret" data-menu-caret width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="6 9 12 15 18 9" />
    </svg>
  </summary>
  <ul class="theme-menu menu-panel" role="list">
    {choices.map(({ value, label }) => (
      <li><button type="button" class="theme-toggle menu-option" data-theme-preference={value} aria-label={label} aria-pressed="false">{label}</button></li>
    ))}
  </ul>
</DisclosureMenu>

<script>
  const root = document.documentElement;
  const selectors = document.querySelectorAll<HTMLDetailsElement>('.theme-selector');
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const sync = () => {
    toggles.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themePreference === root.dataset.themePreference)));
    selectors.forEach((selector) => {
      const label = selector.querySelector<HTMLElement>('[data-theme-current]');
      const selected = selector.querySelector<HTMLButtonElement>('[aria-pressed="true"]');
      if (label && selected) label.textContent = selected.textContent;
    });
  };
  sync();
  document.addEventListener('themechange', sync);
  let transition: ViewTransition | undefined;
  toggles.forEach((toggle) => toggle.addEventListener('click', () => {
    // Let the current wave finish while keeping keyboard focus available.
    if (transition) return;
    const selector = toggle.closest<HTMLDetailsElement>('.theme-selector');
    const summary = selector?.querySelector<HTMLElement>('summary');
    if (selector) selector.open = false;
    summary?.focus({ preventScroll: true });
    const preference = toggle.dataset.themePreference;
    if (preference === root.dataset.themePreference) return;
    const apply = () => document.dispatchEvent(new CustomEvent('themepreferencechange', { detail: { preference } }));
    const dark = preference === 'auto' ? system.matches : preference === 'dark';
    // Remember Auto even when it currently resolves to the same appearance.
    if (dark === root.classList.contains('dark')) {
      apply();
      return;
    }
    if (!document.startViewTransition || reduce.matches) {
      root.classList.add('theme-transition');
      apply();
      return;
    }
    root.classList.remove('theme-transition');
    const bounds = (summary ?? toggle).getBoundingClientRect();
    const x = bounds.left + bounds.width / 2;
    const y = bounds.top + bounds.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.style.setProperty('--theme-reveal-x', `${x}px`);
    root.style.setProperty('--theme-reveal-y', `${y}px`);
    root.style.setProperty('--theme-reveal-radius', `${radius}px`);
    root.classList.add('theme-revealing');
    transition = document.startViewTransition(apply);
    // CSS clips the new snapshot from its very first frame, rather than
    // attaching the reveal after the browser has created that snapshot.
    void transition.ready.catch(() => {});
    const finish = () => {
      root.classList.remove('theme-revealing');
      root.style.removeProperty('--theme-reveal-x');
      root.style.removeProperty('--theme-reveal-y');
      root.style.removeProperty('--theme-reveal-radius');
      transition = undefined;
    };
    void transition.finished.then(finish, finish);
  }));
</script>
