---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { useTranslations, htmlLang, stripLocale } from '../i18n/utils';

interface Props {
  // Which page's metadata to use for <title>/description. Pages pass this;
  // explicit title/description props still override if ever needed.
  page?: 'landing' | 'home' | 'about' | 'privacy';
  title?: string;
  description?: string;
  noReferrer?: boolean;
  // Immersive pages can draw around camera cutouts while controls use safe-area insets.
  viewportFit?: 'auto' | 'cover';
}

const { page = 'home', title: titleProp, description: descriptionProp, noReferrer = false, viewportFit = 'auto' } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const lang = htmlLang(Astro.currentLocale);

const title = titleProp ?? t.meta[page].title;
const description = descriptionProp ?? t.meta[page].description;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(`/og-bitcoin-tools${lang === 'en' ? '' : `-${lang}`}.png`, Astro.site).toString();
const ogImageAlt = t.meta.ogImageAlt;
const siteName = 'Open Bitcoin Tracker';
const appUrl = new URL('/android-app', Astro.site).toString();

// The locale-agnostic remainder of the current path,
// used to build this same page's URL in every language for hreflang.
const localePath = stripLocale(Astro.url.pathname);

// All translated homepages describe the same site at its canonical root.
// SoftwareApplication below remains specific to the Android app page.
const isLanding = localePath === '';
const siteUrl = new URL('/', Astro.site).toString();
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  name: siteName,
  url: siteUrl,
};

// hreflang advertises every translation of the current page. The `loc` is the
// URL path segment Astro routes on (pt), while `code` is the BCP-47 value
// search engines expect (pt-BR). x-default points at the un-prefixed English.
const alternates = [
  { code: 'en', loc: 'en' },
  { code: 'es', loc: 'es' },
  { code: 'pt-BR', loc: 'pt' },
  { code: 'ru', loc: 'ru' },
  { code: 'tr', loc: 'tr' },
  { code: 'vi', loc: 'vi' },
  { code: 'ja', loc: 'ja' },
  { code: 'fr', loc: 'fr' },
  { code: 'de', loc: 'de' },
  { code: 'it', loc: 'it' },
];

// The SoftwareApplication entity describes the app itself. It appears once per
// Android app page and always points at the canonical app
// URL/download, not the current localized page. softwareVersion is
// intentionally omitted so it can't silently go stale against the release.
const isApp = localePath === 'android-app';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: siteName,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Android 5.0+',
  url: appUrl,
  author: {
    '@type': 'Person',
    name: 'Max Hodler',
  },
  downloadUrl: 'https://github.com/Max-Hodler/open-bitcoin-tracker/releases/latest',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  license: 'https://opensource.org/licenses/MIT',
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={`width=device-width, initial-scale=1${viewportFit === 'cover' ? ', viewport-fit=cover' : ''}`} />
    {noReferrer && <meta name="referrer" content="no-referrer" />}

    <meta name="theme-color" content="#F8F7F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1E3A" media="(prefers-color-scheme: dark)" />

    <!-- Theme init must run before first paint to avoid a flash of the wrong
         theme. is:inline keeps Astro from bundling/deferring it. Follows the
         saved choice if present, otherwise the OS preference. -->
    <script is:inline>
      (function () {
        var stored;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var preference = stored === 'dark' || stored === 'light' ? stored : 'auto';
        var system = window.matchMedia('(prefers-color-scheme: dark)');
        function apply(dark, notify) {
          document.documentElement.dataset.themePreference = preference;
          document.documentElement.classList.toggle('dark', dark);
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.remove(); });
          var meta = document.createElement('meta');
          meta.name = 'theme-color';
          meta.content = dark ? '#0F1E3A' : '#F8F7F3';
          document.head.appendChild(meta);
          if (notify) document.dispatchEvent(new CustomEvent('themechange', { detail: { dark: dark, preference: preference } }));
        }
        function sync(notify) {
          apply(preference === 'auto' ? system.matches : preference === 'dark', notify);
        }
        sync(false);
        system.addEventListener('change', function () {
          if (preference === 'auto') sync(true);
        });
        // Keep the choice in memory even when storage writes are blocked.
        document.addEventListener('themepreferencechange', function (event) {
          var choice = event.detail && event.detail.preference;
          if (choice !== 'auto' && choice !== 'light' && choice !== 'dark') return;
          preference = choice;
          try { localStorage.setItem('theme', preference); } catch (e) {}
          sync(true);
        });
        window.addEventListener('storage', function (event) {
          if (event.key !== 'theme' && event.key !== null) return;
          preference = event.newValue === 'dark' || event.newValue === 'light' ? event.newValue : 'auto';
          sync(true);
        });
      })();
    </script>

    <!-- Menu colors must be available before route styles load, including in
         development where Vite injects component CSS asynchronously. -->
    <style is:inline>
      :root { color-scheme: light; --menu-control-ink: #1F1B14; --menu-control-bg: #FFFFFF; }
      html.dark {
        color-scheme: dark;
        --menu-control-ink: #D5DDED;
        --menu-control-bg: linear-gradient(rgb(255 255 255 / .045), rgb(255 255 255 / .045)), #14213D;
      }
      .nav-menu-trigger, .nav-menu-close { color: var(--menu-control-ink); background: var(--menu-control-bg); }
    </style>
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.code} href={getAbsoluteLocaleUrl(a.loc, localePath)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', localePath)} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Fonts are self-hosted (see @font-face in global.css); preload the
         variable Inter file since it's used for all body text on first paint. -->
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />

    {isLanding && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {isApp && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="bg-paper text-ink antialiased">
    <a class="skip-link" href="#main-content">{t.nav.skipToContent}</a>
    <slot />

  </body>
</html>
