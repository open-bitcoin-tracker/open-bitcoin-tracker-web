{
  "name": "open-bitcoin-tracker-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "generate:social": "node --experimental-strip-types scripts/generate-social-images.ts",
    "generate:fonts": "python3 scripts/subset-fonts.py",
    "check:fonts": "python3 scripts/subset-fonts.py --check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "astro": "astro",
    "test:earth": "vitest run src/features/earth",
    "check:earth": "tsc --project tsconfig.earth.json",
    "check:supply": "tsc --project tsconfig.supply.json",
    "refresh:supply": "node --experimental-strip-types scripts/refresh-supply.ts",
    "refresh:prices": "node --experimental-strip-types scripts/refresh-price-history.ts"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.0",
    "@turf/area": "^7.4.0",
    "astro": "^6.3.7",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
